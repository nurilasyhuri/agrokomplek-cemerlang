---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductCard from '../../components/products/ProductCard.astro';
import { getProductSchema, getBreadcrumbSchema } from '../../utils/seo';
import { generateProductInquiryUrl } from '../../utils/whatsapp';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('produk');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: CollectionEntry<'produk'>;
}

const { product } = Astro.props;
const { Content } = await product.render();

const allProducts = await getCollection('produk');
const relatedProducts = allProducts
  .filter((p) => p.slug !== product.slug && (p.data.category === product.data.category || p.data.featured))
  .slice(0, 4);

const categoryLabels: Record<string, string> = {
  'saprodi-pertanian': 'Saprodi Pertanian',
  'perlengkapan-pertanian': 'Perlengkapan Pertanian',
  'perlengkapan-greenhouse': 'Perlengkapan Greenhouse',
};

const categoryName = categoryLabels[product.data.category] || product.data.category;

const waUrl = generateProductInquiryUrl(
  product.data.title,
  categoryName,
  product.data.brand
);

const productSchema = getProductSchema({
  title: product.data.title,
  description: product.data.description,
  thumbnail: product.data.thumbnail,
  brand: product.data.brand,
  category: product.data.category,
  slug: product.slug,
});

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Katalog Produk', url: 'https://agrokomplekcemerlang.com/produk/' },
  { name: categoryName, url: `https://agrokomplekcemerlang.com/produk/${product.data.category}/` },
  { name: product.data.title, url: `https://agrokomplekcemerlang.com/produk/${product.slug}/` },
]);
---

<BaseLayout
  title={`${product.data.title} - Jual & Cek Stok Malang | Agrokomplek Cemerlang`}
  description={`${product.data.description} Cek ketersediaan barang dan harga grosir/retail di toko fisik kami di Malang atau kirim kargo seluruh Indonesia.`}
  image={product.data.thumbnail}
  type="product"
  jsonLd={[productSchema, breadcrumbSchema]}
  hideMobileStickyBar={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-28 lg:pb-20">
    
    <!-- Breadcrumb -->
    <Breadcrumb
      items={[
        { label: 'Katalog Produk', href: '/produk/' },
        { label: categoryName, href: `/produk/${product.data.category}/` },
        { label: product.data.title },
      ]}
    />

    <!-- Main Product Presentation (2 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 mt-6">
      
      <!-- Left Column: Product Imagery (5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        <div class="border border-surface-border bg-surface-card rounded-lg overflow-hidden p-2">
          <div class="aspect-square bg-surface-subtle rounded-md overflow-hidden relative border border-surface-border">
            <img
              src={product.data.thumbnail}
              alt={product.data.title}
              width="800"
              height="800"
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
            <!-- Stock Badge -->
            <div class="absolute top-3 left-3">
              <span class="inline-block px-2.5 py-1 rounded-sm text-xs font-bold uppercase tracking-wider bg-surface-card text-ink-primary border border-surface-border shadow-sm">
                {product.data.stockStatus === 'ready'
                  ? 'Ready Stok di Gudang Malang'
                  : product.data.stockStatus === 'po'
                  ? 'Pre-Order / Indent'
                  : 'Cek Ketersediaan'}
              </span>
            </div>
          </div>
        </div>

        <!-- Verification Quick Box -->
        <div class="border border-surface-border bg-surface-card p-4 rounded-lg space-y-2 text-xs text-ink-secondary">
          <p class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-agri-700"></span>
            <span>100% Produk Asli & Teruji Lapangan</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-agri-700"></span>
            <span>Tersedia pengambilan langsung di Kedungkandang, Malang</span>
          </p>
          <p class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 bg-agri-700"></span>
            <span>Bisa kirim kargo ekonomis ke seluruh Nusantara</span>
          </p>
        </div>
      </div>

      <!-- Right Column: Product Information & Purchase Path (7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-agri-700">
            {categoryName} {product.data.brand ? `• Merek: ${product.data.brand}` : ''}
          </span>
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink-primary mt-1">
            {product.data.title}
          </h1>
        </div>

        <!-- Availability & Order Action Box -->
        <div class="p-5 border border-surface-border bg-surface-card rounded-lg flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-bold text-agri-700 block uppercase tracking-wider">Ketersediaan &amp; Pemesanan</span>
            <span class="text-lg sm:text-xl font-extrabold text-ink-primary mt-0.5 block">
              Stok Gudang Malang &bull; Siap Kirim Seluruh Indonesia
            </span>
            <p class="text-xs text-ink-muted mt-1">
              Melayani pembelian eceran, rol/balen grosir, serta pengadaan proyek pertanian.
            </p>
          </div>

          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-md bg-agri-700 hover:bg-agri-800 text-white font-bold text-xs uppercase tracking-wider transition-colors select-none shrink-0 shadow-xs"
          >
            <svg class="w-4 h-4 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <span>Tanya Stok &amp; Pemesanan via WA</span>
          </a>
        </div>

        <!-- Technical Specifications Table -->
        <div class="space-y-3">
          <h2 class="text-base sm:text-lg font-bold text-ink-primary border-b border-surface-border pb-2">
            Spesifikasi Teknis Produk
          </h2>

          <div class="border border-surface-border bg-surface-card rounded-lg overflow-hidden">
            <table class="w-full text-xs text-left">
              <tbody class="divide-y divide-surface-border">
                {product.data.brand && (
                  <tr>
                    <td class="px-4 py-2.5 font-bold text-ink-primary bg-surface-subtle w-1/3">Merek / Produsen</td>
                    <td class="px-4 py-2.5 text-ink-secondary">{product.data.brand}</td>
                  </tr>
                )}
                {product.data.specs && Object.entries(product.data.specs).map(([key, val]) => (
                  <tr>
                    <td class="px-4 py-2.5 font-bold text-ink-primary bg-surface-subtle w-1/3 capitalize">
                      {key.replace(/([A-Z])/g, ' $1').trim()}
                    </td>
                    <td class="px-4 py-2.5 text-ink-secondary">{String(val)}</td>
                  </tr>
                ))}
                <tr>
                  <td class="px-4 py-2.5 font-bold text-ink-primary bg-surface-subtle w-1/3">Status Gudang</td>
                  <td class="px-4 py-2.5 text-ink-secondary">
                    {product.data.stockStatus === 'ready' ? 'Stok Fisik Tersedia di Kedungkandang Malang' : 'Indent Pabrik'}
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Logistics Information Box -->
        <div class="p-4 border border-surface-border bg-surface-subtle rounded-lg text-xs space-y-2 text-ink-secondary">
          <span class="font-bold text-ink-primary block uppercase tracking-wider">Opsi Pengambilan & Logistik:</span>
          <p><strong>1. Ambil Langsung:</strong> Silakan ambil langsung di gudang kami di Buring, Kedungkandang, Malang pada jam operasional kerja.</p>
          <p><strong>2. Ekspedisi Kargo:</strong> Melayani pengiriman ke luar kota dan luar pulau menggunakan ekspedisi rekanan (Indah Kargo, Baraka, KIB, atau kargo laut pilihan Anda).</p>
        </div>

      </div>

    </div>

    <!-- Long-form Description -->
    <div class="mt-12 pt-8 border-t border-surface-border">
      <h2 class="text-xl sm:text-2xl font-extrabold text-ink-primary mb-4">Deskripsi &amp; Panduan Penggunaan</h2>
      <div class="prose prose-emerald max-w-none text-ink-secondary text-sm leading-relaxed">
        <Content />
      </div>
    </div>

    <!-- Related Products -->
    {relatedProducts.length > 0 && (
      <div class="mt-16 pt-10 border-t border-surface-border">
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl sm:text-2xl font-extrabold text-ink-primary">Produk Terkait Lainnya</h2>
          <a href="/produk/" class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:underline">
            Semua Produk &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
          {relatedProducts.map((rel) => (
            <ProductCard
              product={{
                title: rel.data.title,
                description: rel.data.description,
                category: rel.data.category,
                priceDisplay: rel.data.priceDisplay,
                stockStatus: rel.data.stockStatus,
                thumbnail: rel.data.thumbnail,
                slug: rel.slug,
              }}
            />
          ))}
        </div>
      </div>
    )}

  </div>

  <!-- Mobile Sticky Conversion Bar for PDP (Single Deck Dock) -->
  <aside
    class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-surface-card border-t border-surface-border px-4 py-2.5 safe-area-pb flex items-center justify-between gap-3 shadow-md select-none"
    aria-label="Aksi Pemesanan Cepat"
  >
    <div class="overflow-hidden min-w-0 flex-1">
      <span class="text-[10px] text-agri-700 uppercase block leading-tight font-bold">Stok Gudang Malang</span>
      <span class="text-xs font-extrabold text-ink-primary truncate block">
        Siap Ambil &amp; Kirim Kargo
      </span>
    </div>
    <a
      href={waUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-md bg-agri-700 active:bg-agri-800 text-white font-bold text-xs uppercase tracking-wider shrink-0 select-none shadow-sm touch-target"
    >
      <svg class="w-4 h-4 text-emerald-300" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
      </svg>
      <span>Tanya Stok WA</span>
    </a>
  </aside>
</BaseLayout>
