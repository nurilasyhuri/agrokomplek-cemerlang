---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getCollectionPageSchema, getBreadcrumbSchema } from '../../../utils/seo';
import { getCollection } from 'astro:content';

export const CATEGORIES = [
  {
    kategori: 'saprodi-pertanian',
    shortLabel: 'Saprodi Pertanian',
    title: 'Saprodi Pertanian Malang: Pupuk NPK, Organik & Benih Unggul',
    desc: 'Pusat sarana produksi pertanian terlengkap di Malang: pupuk NPK 16-16-16, pupuk organik, nutrisi AB Mix hidroponik, media tanam, dan benih hortikultura unggul.',
  },
  {
    kategori: 'perlengkapan-pertanian',
    shortLabel: 'Irigasi & Lahan',
    title: 'Alat Pertanian & Irigasi: Selang Drip 16mm & Mulsa MPHP',
    desc: 'Peralatan irigasi fertigasi presisi dan perlengkapan lahan: selang drip 16mm, sprayer elektrik 16L, mulsa plastik hitam perak, dan nepel fitting sambungan.',
  },
  {
    kategori: 'perlengkapan-greenhouse',
    shortLabel: 'Material Greenhouse',
    title: 'Material Greenhouse: Plastik UV, Paranet & Kasa Insect Net',
    desc: 'Distributor material greenhouse terlengkap: plastik UV 14%-20% (200 mikron), paranet shading net 65%-75%, kasa insect net 50 mesh, dan profil lock spring clip.',
  },
];

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { kategori: cat.kategori },
    props: { cat },
  }));
}

const { kategori } = Astro.params;
const { cat } = Astro.props;

const allProducts = await getCollection('produk');
const filteredProducts = allProducts.filter((p) => p.data.category === kategori);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agroprimagreenhouse.com/' },
  { name: 'Katalog Produk', url: 'https://agroprimagreenhouse.com/produk/' },
  { name: cat.shortLabel, url: `https://agroprimagreenhouse.com/produk/${kategori}/` },
]);

const collectionSchema = getCollectionPageSchema({
  name: cat.title,
  description: cat.desc,
  url: `https://agroprimagreenhouse.com/produk/${kategori}/`,
  items: filteredProducts.map((p) => ({
    name: p.data.title,
    url: `https://agroprimagreenhouse.com/produk/${p.slug}/`,
    description: p.data.description,
  })),
});
---

<BaseLayout
  title={cat.title}
  description={cat.desc}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-20">
    <Breadcrumb
      items={[
        { label: 'Katalog Produk', href: '/produk/' },
        { label: cat.shortLabel },
      ]}
    />

    <div class="my-8 max-w-3xl">
      <span class="text-xs font-semibold text-emerald-700 tracking-normal block mb-1">
        Kategori Produk Pertanian
      </span>
      <h1 class="text-3xl sm:text-4xl font-bold text-zinc-900 tracking-tight mb-3">
        {cat.title}
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        {cat.desc}
      </p>
    </div>

    <!-- Category Pill Links (Horizontal scroll on mobile) -->
    <div class="flex items-center gap-2 mb-10 pb-4 border-b border-zinc-200/80 overflow-x-auto sm:flex-wrap">
      <a
        href="/produk/"
        class="whitespace-nowrap shrink-0 px-4 py-2 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600 hover:bg-zinc-200/80 hover:text-zinc-900 transition-all"
      >
        Semua Produk
      </a>
      {CATEGORIES.map((c) => (
        <a
          href={`/produk/${c.kategori}/`}
          class:list={[
            'whitespace-nowrap shrink-0 px-4 py-2 rounded-full text-xs font-semibold transition-all',
            c.kategori === kategori
              ? 'bg-zinc-900 text-white shadow-xs'
              : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-200/80 hover:text-zinc-900',
          ]}
        >
          {c.shortLabel || c.title}
        </a>
      ))}
    </div>

    {filteredProducts.length > 0 ? (
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-5">
        {filteredProducts.map((p) => (
          <ProductCard
            product={{
              title: p.data.title,
              description: p.data.description,
              category: p.data.category,
              priceDisplay: p.data.priceDisplay,
              stockStatus: p.data.stockStatus,
              thumbnail: p.data.thumbnail,
              brand: p.data.brand,
              slug: p.slug,
            }}
          />
        ))}
      </div>
    ) : (
      <div class="p-16 text-center bg-white rounded-2xl border border-zinc-200/80 shadow-xs">
        <p class="text-zinc-600 text-sm">Belum ada item yang terdaftar di kategori ini.</p>
        <a href="/produk/" class="inline-block mt-4 px-5 py-2.5 rounded-full bg-zinc-900 hover:bg-zinc-800 text-white text-xs font-semibold transition-all">
          Lihat Semua Produk &rarr;
        </a>
      </div>
    )}
  </div>
</BaseLayout>
