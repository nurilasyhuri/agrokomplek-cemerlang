---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/common/Breadcrumb.astro';
import ProductCard from '../../../components/products/ProductCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = [
    {
      kategori: 'saprodi-pertanian',
      title: 'Saprodi Pertanian Malang & Indonesia',
      desc: 'Pilihan sarana produksi pertanian: pupuk organik, NPK, pestisida terdaftar, benih hortikultura dan media tanam.',
    },
    {
      kategori: 'perlengkapan-pertanian',
      title: 'Perlengkapan & Alat Pertanian Berkualitas',
      desc: 'Perlengkapan untuk mempermudah pekerjaan lahan: sprayer elektrik, mulsa plastik hitam perak, selang drip dan tray semai.',
    },
    {
      kategori: 'perlengkapan-greenhouse',
      title: 'Perlengkapan & Komponen Greenhouse Indonesia',
      desc: 'Komponen penutup dan aksesoris greenhouse: Plastik UV 14%-20%, Paranet 65%-85%, Spring Clip, dan Profil Lock.',
    },
  ];

  return categories.map((cat) => ({
    params: { kategori: cat.kategori },
    props: { cat },
  }));
}

const { kategori } = Astro.params;
const { cat } = Astro.props;

const allProducts = await getCollection('produk');
const filteredProducts = allProducts.filter((p) => p.data.category === kategori);
---

<BaseLayout title={cat.title} description={cat.desc}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-20">
    <Breadcrumb
      items={[
        { label: 'Katalog Produk', href: '/produk/' },
        { label: cat.title },
      ]}
    />

    <div class="my-8 max-w-3xl">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider block mb-1">
        Kategori Produk
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-steel-900 tracking-tight mb-3">
        {cat.title}
      </h1>
      <p class="text-base text-steel-600 leading-relaxed">
        {cat.desc}
      </p>
    </div>

    {filteredProducts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {filteredProducts.map((p) => (
          <ProductCard
            product={{
              title: p.data.title,
              description: p.data.description,
              category: p.data.category,
              priceDisplay: p.data.priceDisplay,
              stockStatus: p.data.stockStatus,
              thumbnail: p.data.thumbnail,
              brand: p.data.brand,
              slug: p.slug,
            }}
          />
        ))}
      </div>
    ) : (
      <div class="p-12 text-center bg-white rounded-2xl border border-steel-200">
        <p class="text-steel-600">Belum ada item yang terdaftar di kategori ini.</p>
      </div>
    )}
  </div>
</BaseLayout>
