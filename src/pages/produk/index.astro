---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import ProductFilter from '../../components/products/ProductFilter';
import { getCollection } from 'astro:content';

const products = await getCollection('produk');
const mappedProducts = products.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  category: p.data.category,
  priceDisplay: p.data.priceDisplay,
  stockStatus: p.data.stockStatus,
  thumbnail: p.data.thumbnail,
  slug: p.slug,
}));
---

<BaseLayout
  title="Katalog Saprodi Pertanian, Material Greenhouse &amp; Irigasi"
  description="Katalog resmi Agrokomplek Cemerlang: suplai plastik UV, paranet, mulsa pertanian, insect net, selang drip 16mm, hingga nutrisi hidroponik. Stok fisik di Malang."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-20">
    <Breadcrumb items={[{ label: 'Katalog Produk' }]} />

    <div class="my-8 text-center max-w-3xl mx-auto">
      <span class="text-xs font-bold uppercase tracking-wider text-agri-700 block mb-1.5">
        Katalog Suplai & Komponen
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-primary tracking-tight mb-3">
        Katalog Saprodi, Material Greenhouse &amp; Irigasi
      </h1>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        Agrokomplek Cemerlang menyediakan kebutuhan Saprodi Pertanian, Material Greenhouse, Perlengkapan Irigasi, serta Jasa Pembuatan Greenhouse. Produk yang tersedia meliputi plastik UV greenhouse, paranet, mulsa pertanian, insect net, selang drip, perlengkapan hidroponik, dan berbagai komponen pendukung budidaya lainnya.
      </p>
    </div>

    <!-- Interactive Filter & Search Island -->
    <ProductFilter client:load products={mappedProducts} />
  </div>
</BaseLayout>
