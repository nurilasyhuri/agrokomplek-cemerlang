---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getAboutPageSchema, getBreadcrumbSchema } from '../utils/seo';

const aboutSchema = getAboutPageSchema();
const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Tentang Kami', url: '/tentang-kami/' },
]);
---

<BaseLayout
  title="Tentang Kontraktor Greenhouse Malang - Agrokomplek Cemerlang"
  description="Profil Agrokomplek Cemerlang: kontraktor spesialis jasa pembuatan greenhouse galvanis, baja ringan, bambu, dan tunnel garam berbasis di Malang untuk seluruh Indonesia."
  jsonLd={[aboutSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Tentang Kami' }]} />

    <div class="my-10 space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Profil Kontraktor Greenhouse Terpercaya
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight leading-[1.15]">
        Kontraktor Spesialis Jasa Pembuatan Greenhouse di Malang
      </h1>
    </div>

    <div class="space-y-8 text-sm sm:text-base text-zinc-600 leading-relaxed">
      <p>
        Pertanian modern yang produktif dan berkelanjutan berawal dari infrastruktur perlindungan tanaman yang kokoh, presisi, dan dirancang sesuai iklim mikrolokal setempat.
      </p>

      <p>
        <strong class="text-zinc-900 font-semibold">Agrokomplek Cemerlang</strong> adalah kontraktor spesialis jasa pembuatan greenhouse yang melayani perancangan desain, penyusunan RAB transparan, pengadaan material struktur berkualitas, serta instalasi langsung di lapangan. Kami menangani greenhouse pipa galvanis komersial, rangka baja ringan modern, bambu awet ekonomis, hingga inovasi tunnel prisma garam pesisir.
      </p>

      <!-- Tagline Callout -->
      <div class="p-7 sm:p-9 rounded-3xl bg-zinc-50/80 border border-zinc-200/80 space-y-3">
        <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block">Filosofi Kerja Kami</span>
        <h2 class="text-xl sm:text-2xl font-bold text-zinc-900">
          "{BUSINESS_INFO.tagline}"
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Kami menolak pendekatan <em>overselling</em> atau memaksakan spesifikasi mahal yang tidak relevan. Rekomendasi material dan tipe struktur greenhouse kami selalu diselaraskan dengan jenis komoditas budidaya, kondisi terpaan angin lahan, dan kapasitas anggaran investasi Anda.
        </p>
      </div>

      <!-- 4 Pillars -->
      <div class="space-y-6 pt-4">
        <div>
          <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block">Solusi Terintegrasi</span>
          <h3 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight mt-1">
            Empat Pilar Solusi Konstruksi Greenhouse
          </h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
            <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center font-bold text-xs text-emerald-800">
              01
            </div>
            <h4 class="font-bold text-zinc-900 text-lg sm:text-xl">Rancang Bangun Struktur</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Konstruksi greenhouse pipa galvanis hot-dip, baja ringan profil kokoh, bambu awet terawat, serta tunnel garam pesisir dengan fondasi beton kokoh tahan angin kencang.
            </p>
            <div class="pt-2">
              <a href="/jasa/pembuatan-greenhouse/" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group">
                <span>Layanan Greenhouse</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
            <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center font-bold text-xs text-emerald-800">
              02
            </div>
            <h4 class="font-bold text-zinc-900 text-lg sm:text-xl">Material Proteksi Teruji</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Plastik UV 200 mikron dengan aditif UV stabilizer 14%, paranet peneduh 65-75%, kasa insect net 50 mesh rapat anti hama, dan pengunci profil spring clip galvanis.
            </p>
            <div class="pt-2">
              <a href="/produk/perlengkapan-greenhouse/" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group">
                <span>Katalog Material</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
            <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center font-bold text-xs text-emerald-800">
              03
            </div>
            <h4 class="font-bold text-zinc-900 text-lg sm:text-xl">Sistem Irigasi &amp; Fertigasi</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Pemasangan instalasi irigasi tetes presisi (selang drip 16mm emiter rapat), fertigasi otomatis hemat pupuk hingga 70%, dan paket gully hidroponik NFT komersial.
            </p>
            <div class="pt-2">
              <a href="/produk/perlengkapan-pertanian/" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group">
                <span>Alat Irigasi &amp; NFT</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all space-y-4">
            <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center font-bold text-xs text-emerald-800">
              04
            </div>
            <h4 class="font-bold text-zinc-900 text-lg sm:text-xl">Simulasi RAB &amp; Garansi</h4>
            <p class="text-xs text-zinc-600 leading-relaxed">
              Perhitungan estimasi biaya per m² online transparan, gambar teknis kerja, supervisi lapangan oleh teknisi berpengalaman, serta garansi kekokohan struktur.
            </p>
            <div class="pt-2">
              <a href="/jasa/pembuatan-greenhouse/#kalkulator" class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group">
                <span>Kalkulator Estimasi RAB</span>
                <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Workshop Callout -->
      <div class="p-7 sm:p-9 rounded-3xl bg-emerald-50/50 border border-emerald-200/80 space-y-3">
        <h3 class="text-xl font-bold text-zinc-900">Kantor &amp; Workshop Kami di Malang</h3>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Workshop dan kantor kami berlokasi di {BUSINESS_INFO.address.street}, {BUSINESS_INFO.address.village}, {BUSINESS_INFO.address.district}, {BUSINESS_INFO.address.city}, {BUSINESS_INFO.address.province}. Anda dapat berkunjung langsung untuk melihat contoh sambungan pipa galvanis, kuncian spring clip, dan berdiskusi langsung mengenai proyek kebun Anda.
        </p>
        <div class="pt-2">
          <a
            href={BUSINESS_INFO.geo.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs tracking-wider uppercase transition-all shadow-sm select-none"
          >
            <span>Buka Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
