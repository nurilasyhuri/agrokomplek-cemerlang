---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustBar from '../components/home/TrustBar.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import DualPathChooser from '../components/home/DualPathChooser.astro';
import GreenhouseServiceHighlight from '../components/home/GreenhouseServiceHighlight.astro';
import HomeContactSection from '../components/home/HomeContactSection.astro';
import { getLocalBusinessSchema, getWebsiteSchema } from '../utils/seo';

const localSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();

const homeKeywords = [
  'jasa pembuatan greenhouse',
  'supplier perlengkapan greenhouse',
  'toko saprodi pertanian malang',
  'paket pembuatan greenhouse siap tanam',
  'jual plastik uv greenhouse 200 mikron',
  'jual paranet tanaman malang',
  'jasa pembuatan tunnel garam',
  'greenhouse baja ringan',
  'greenhouse bambu awet',
  'agrokomplek cemerlang',
];
---

<BaseLayout
  title="Pusat Perlengkapan Pertanian dan Jasa Greenhouse - Agrokomplek Cemerlang"
  description="Toko saprodi pertanian terlengkap dan jasa pembuatan greenhouse siap tanam di Malang. Melayani pengiriman material dan instalasi ke seluruh Indonesia."
  keywords={homeKeywords}
  jsonLd={[localSchema, websiteSchema]}
>
  <!-- 1. Hero Showcase -->
  <HeroSection />

  <!-- 2. Keunggulan Toko & Workshop -->
  <TrustBar />

  <!-- 3. Katalog Produk & Material Pertanian -->
  <CategoryGrid />

  <!-- 4. Pilihan Kebutuhan Pertanian: Beli Material atau Bangun Siap Tanam -->
  <DualPathChooser />

  <!-- 5. Layanan Konstruksi Greenhouse & Estimasi RAB -->
  <GreenhouseServiceHighlight />

  <!-- 6. Kontak Resmi & Workshop Malang -->
  <HomeContactSection />
</BaseLayout>
