---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import GreenhouseServiceHighlight from '../components/home/GreenhouseServiceHighlight.astro';
import NationwideCoverage from '../components/home/NationwideCoverage.astro';
import ProductCard from '../components/products/ProductCard.astro';
import { getLocalBusinessSchema } from '../utils/seo';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('produk');
const featuredProducts = allProducts.filter((p) => p.data.featured).slice(0, 4);

const localSchema = getLocalBusinessSchema();
---

<BaseLayout
  title="Distributor Saprodi Pertanian &amp; Jasa Pembuatan Greenhouse"
  description="Agrokomplek Cemerlang: distributor saprodi pertanian, material greenhouse, irigasi, dan jasa pembuatan greenhouse komersial di Malang &amp; seluruh Indonesia."
  jsonLd={[localSchema]}
>
  <!-- 1. Hero Section -->
  <HeroSection />
  <!-- 2. Category Grid -->
  <CategoryGrid />
  <!-- 4. Featured Products (If available) -->
  {featuredProducts.length > 0 && (
    <section class="py-16 sm:py-24 bg-white border-b border-zinc-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-6 mb-12 pb-6 border-b border-zinc-200/80">
          <div>
            <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block mb-1">
              Pilihan Unggulan
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight leading-[1.15]">
              Produk Pertanian &amp; Greenhouse
            </h2>
            <p class="text-sm sm:text-base text-zinc-600 mt-1.5">
              Material pilihan yang paling banyak dibutuhkan petani dan pengusaha agribisnis.
            </p>
          </div>
          <a
            href="/produk/"
            class="inline-flex items-center gap-2 text-xs font-semibold text-zinc-800 hover:text-zinc-950 bg-zinc-100 hover:bg-zinc-200/80 px-5 py-2.5 rounded-full transition-all shrink-0"
          >
            <span>Lihat Semua Katalog</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
          {featuredProducts.map((p) => (
            <ProductCard
              product={{
                title: p.data.title,
                description: p.data.description,
                category: p.data.category,
                priceDisplay: p.data.priceDisplay,
                stockStatus: p.data.stockStatus,
                thumbnail: p.data.thumbnail,
                brand: p.data.brand,
                slug: p.slug,
              }}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. Greenhouse Service Highlight -->
  <GreenhouseServiceHighlight />

  <!-- 6. Nationwide Logistics -->
  <NationwideCoverage />


</BaseLayout>
