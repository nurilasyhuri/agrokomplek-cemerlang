---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import TrustBar from '../components/home/TrustBar.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import ValueHighlights from '../components/home/ValueHighlights.astro';
import GreenhouseServiceHighlight from '../components/home/GreenhouseServiceHighlight.astro';
import DualPathChooser from '../components/home/DualPathChooser.astro';
import CustomerReviews from '../components/home/CustomerReviews.astro';
import NationwideCoverage from '../components/home/NationwideCoverage.astro';
import HomeBlogSection from '../components/home/HomeBlogSection.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import CtaBanner from '../components/home/CtaBanner.astro';
import { getLocalBusinessSchema, getWebsiteSchema, getFaqSchema } from '../utils/seo';
import { HOME_FAQS } from '../data/faqs';

const localSchema = getLocalBusinessSchema();
const websiteSchema = getWebsiteSchema();
const faqSchema = getFaqSchema(HOME_FAQS);
---

<BaseLayout
  title="Jasa Pembuatan Greenhouse &amp; Kontraktor Konstruksi - Agro Prima Greenhouse"
  description="Kontraktor spesialis jasa pembuatan greenhouse (galvanis, baja ringan, bambu, tunnel garam) di Malang. Melayani survei lahan, desain teknis, estimasi RAB transparan, &amp; instalasi se-Indonesia."
  jsonLd={[localSchema, websiteSchema, faqSchema]}
>
  <!-- 1. Hero Banner (5-Slide Greenhouse Showcase Slider) -->
  <HeroSection />

  <!-- 2. Trust Strip (Contractor Quality Highlights) -->
  <TrustBar />

  <!-- 3. Pilihan Tipe Konstruksi Greenhouse (4 Core Types Grid) -->
  <CategoryGrid />

  <!-- 4. Jasa Pembuatan Greenhouse (Technical Services & Types) -->
  <GreenhouseServiceHighlight />

  <!-- 5. Mengapa Memilih Agro Prima Greenhouse? (5 Core Pillars) -->
  <ValueHighlights />

  <!-- 6. Melayani Pengiriman & Instalasi Greenhouse ke Seluruh Indonesia -->
  <NationwideCoverage />

  <!-- 7. Pilihan Solusi: Material Rangka atau Bangun Terima Jadi? -->
  <DualPathChooser />

  <!-- 8. Customer Reviews & Social Proof -->
  <CustomerReviews />

  <!-- 9. Panduan Konstruksi & Greenhouse (From the Blog) -->
  <HomeBlogSection />

  <!-- 10. Pertanyaan Seputar Jasa Pembuatan Greenhouse (FAQ) -->
  <HomeFaq />

  <!-- 11. Konsultasikan Rancang Bangun Greenhouse Anda (WhatsApp CTA) -->
  <CtaBanner />

</BaseLayout>
