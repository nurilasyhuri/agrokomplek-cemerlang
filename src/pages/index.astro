---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import GreenhouseServiceHighlight from '../components/home/GreenhouseServiceHighlight.astro';
import NationwideCoverage from '../components/home/NationwideCoverage.astro';
import ProductCard from '../components/products/ProductCard.astro';
import { getLocalBusinessSchema } from '../utils/seo';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('produk');
const featuredProducts = allProducts.filter((p) => p.data.featured).slice(0, 4);

const localSchema = getLocalBusinessSchema();
---

<BaseLayout
  title="Distributor Saprodi Pertanian &amp; Jasa Pembuatan Greenhouse"
  description="Agrokomplek Cemerlang: distributor saprodi pertanian, material greenhouse, irigasi, dan jasa pembuatan greenhouse komersial di Malang &amp; seluruh Indonesia."
  jsonLd={[localSchema]}
>
  <!-- 1. Hero Section -->
  <HeroSection />
  <!-- 2. Category Grid -->
  <CategoryGrid />
  <!-- 4. Featured Products (If available) -->
  {featuredProducts.length > 0 && (
    <section class="py-14 sm:py-20 bg-surface-card border-b border-surface-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-10 pb-4 border-b border-surface-border">
          <div>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-primary tracking-tight leading-[1.15]">
              Pilihan Unggulan
            </h2>
            <p class="text-xl sm:text-2xl font-bold text-agri-700 tracking-tight mt-1.5">
              Produk Pertanian &amp; Greenhouse Yang Banyak Dibutuhkan
            </p>
          </div>
          <a
            href="/produk/"
            class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider font-bold text-agri-700 hover:text-agri-800 bg-surface-subtle px-3.5 py-2 rounded-md border border-surface-border"
          >
            <span>LIHAT SEMUA KATALOG</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
          {featuredProducts.map((p) => (
            <ProductCard
              product={{
                title: p.data.title,
                description: p.data.description,
                category: p.data.category,
                priceDisplay: p.data.priceDisplay,
                stockStatus: p.data.stockStatus,
                thumbnail: p.data.thumbnail,
                brand: p.data.brand,
                slug: p.slug,
              }}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. Greenhouse Service Highlight -->
  <GreenhouseServiceHighlight />

  <!-- 6. Nationwide Logistics -->
  <NationwideCoverage />


</BaseLayout>
