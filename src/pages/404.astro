---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404)"
  description="Halaman yang Anda cari tidak ditemukan. Silakan kembali ke katalog produk atau beranda Agrokomplek Cemerlang."
  noindex={true}
>
  <div class="max-w-xl mx-auto px-4 py-28 text-center space-y-6">
    <div class="w-20 h-20 rounded-full bg-[#e4e5da] border border-[#dedad0] text-[#064e3b] flex items-center justify-center font-extrabold text-2xl mx-auto shadow-xs">
      404
    </div>

    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-[#1b2819] tracking-tight">
        Halaman Tidak Ditemukan
      </h1>
      <p class="text-sm text-[#485245] leading-relaxed max-w-md mx-auto">
        Tautan yang Anda tuju mungkin telah dipindahkan atau sudah tidak aktif. Silakan kembali ke katalog produk atau beranda utama kami.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
      <a
        href="/"
        class="px-7 py-3.5 rounded-full bg-[#064e3b] hover:bg-[#047857] text-[#edeae1] font-semibold text-sm transition-all shadow-sm select-none"
      >
        Kembali ke Beranda
      </a>
      <a
        href="/produk/"
        class="px-7 py-3.5 rounded-full border border-[#dedad0] bg-white hover:bg-[#e4e5da]/40 text-[#1b2819] font-semibold text-sm transition-all shadow-xs select-none"
      >
        Katalog Produk
      </a>
      <a
        href="/jasa/pembuatan-greenhouse/"
        class="px-7 py-3.5 rounded-full border border-[#dedad0] bg-white hover:bg-[#e4e5da]/40 text-[#1b2819] font-semibold text-sm transition-all shadow-xs select-none"
      >
        Jasa Greenhouse
      </a>
    </div>
  </div>
</BaseLayout>
