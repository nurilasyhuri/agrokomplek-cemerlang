---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Halaman Tidak Ditemukan (404)"
  description="Halaman yang Anda cari tidak ditemukan. Silakan kembali ke katalog produk atau beranda Agro Prima Greenhouse."
  noindex={true}
>
  <div class="max-w-xl mx-auto px-4 py-28 text-center space-y-6">
    <div class="w-20 h-20 rounded-full bg-emerald-50 border border-emerald-200/60 text-emerald-800 flex items-center justify-center font-extrabold text-2xl mx-auto shadow-xs">
      404
    </div>

    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-900 tracking-tight">
        Halaman Tidak Ditemukan
      </h1>
      <p class="text-sm text-zinc-600 leading-relaxed max-w-md mx-auto">
        Tautan yang Anda tuju mungkin telah dipindahkan atau sudah tidak aktif. Silakan kembali ke katalog produk atau beranda utama kami.
      </p>
    </div>

    <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
      <a
        href="/"
        class="px-7 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm select-none"
      >
        Kembali ke Beranda
      </a>
      <a
        href="/produk/"
        class="px-7 py-3.5 rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-900 font-semibold text-sm transition-all shadow-xs select-none"
      >
        Katalog Produk
      </a>
      <a
        href="/jasa/pembuatan-greenhouse/"
        class="px-7 py-3.5 rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-900 font-semibold text-sm transition-all shadow-xs select-none"
      >
        Jasa Greenhouse
      </a>
    </div>
  </div>
</BaseLayout>
