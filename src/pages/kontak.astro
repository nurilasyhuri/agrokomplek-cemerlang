---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getContactPageSchema, getBreadcrumbSchema } from '../utils/seo';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Kontak', url: 'https://agrokomplekcemerlang.com/kontak/' },
]);

const contactSchema = getContactPageSchema();
---

<BaseLayout
  title="Kontak Toko Pertanian &amp; Jasa Greenhouse Malang | Agrokomplek Cemerlang"
  description="Hubungi Agrokomplek Cemerlang via WhatsApp 0851-8300-2070 untuk pemesanan saprodi pertanian, cek ketersediaan stok, &amp; survei greenhouse di Malang &amp; sekitarnya."
  jsonLd={[contactSchema, breadcrumbSchema]}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Kontak' }]} />

    <div class="my-10 text-center max-w-2xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Konsultasi &amp; Pemesanan Resmi
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight">
        Kontak Toko Pertanian &amp; Jasa Pembuatan Greenhouse Malang
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        Konsultasikan kebutuhan produk pertanian, cek ketersediaan stok, atau ajukan permintaan survei proyek greenhouse Anda bersama tim Agrokomplek Cemerlang.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 my-10 items-stretch">
      <!-- Contact Details -->
      <div class="p-7 sm:p-9 rounded-3xl bg-white border border-zinc-200/80 shadow-sm flex flex-col justify-between space-y-6">
        <div>
          <h3 class="text-lg font-bold text-zinc-900 border-b border-zinc-100 pb-3">
            Saluran Komunikasi Resmi
          </h3>

          <div class="space-y-4 text-xs sm:text-sm text-zinc-600 mt-4">
            <div>
              <span class="text-zinc-500 block">WhatsApp Customer Service:</span>
              <a
                href={`https://wa.me/${BUSINESS_INFO.contact.whatsappRaw}`}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-emerald-700 hover:text-emerald-800 text-base"
              >
                {BUSINESS_INFO.contact.phone}
              </a>
              <span class="block text-zinc-500 text-[11px] mt-0.5">Respon cepat konsultasi spesifikasi &amp; pesanan</span>
            </div>

            <div>
              <span class="text-zinc-500 block">Email Resmi:</span>
              <a
                href={`mailto:${BUSINESS_INFO.contact.email}`}
                class="font-bold text-zinc-900 hover:text-emerald-700"
              >
                {BUSINESS_INFO.contact.email}
              </a>
            </div>

            <div>
              <span class="text-zinc-500 block">Jam Layanan:</span>
              <p class="font-medium text-zinc-800">
                {BUSINESS_INFO.hours.physicalStore}
              </p>
              <p class="text-[11px] text-zinc-500">Konsultasi pesan WhatsApp dilayani setiap hari</p>
            </div>

            <div>
              <span class="text-zinc-500 block">Alamat Gudang &amp; Toko:</span>
              <p class="font-medium text-zinc-800 mt-0.5 leading-relaxed">
                {BUSINESS_INFO.address.fullFormatted}
              </p>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-zinc-100">
          <a
            href="/lokasi/"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between"
          >
            <span>Petunjuk Arah &amp; Peta Google Maps</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Quick Routing Direct Actions -->
      <div class="p-7 sm:p-9 rounded-3xl bg-zinc-900 text-white border border-zinc-800 shadow-xl flex flex-col justify-between space-y-6">
        <div class="space-y-3">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-700/50">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Direct WhatsApp Action
          </span>
          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Hubungi Sesuai Kebutuhan Anda
          </h3>
          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
            Pilih jalur pesan agar kami dapat langsung mengarahkan Anda ke admin produk saprodi atau teknisi konstruksi greenhouse kami:
          </p>
        </div>

        <div class="space-y-3 pt-4">
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20konsultasi%20pembuatan%20greenhouse."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-between p-4 rounded-2xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs sm:text-sm font-semibold transition-all border border-zinc-700"
          >
            <span>Konsultasi Pembuatan Greenhouse</span>
            <span>&rarr;</span>
          </a>

          <a
            href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20cek%20stok%20dan%20harga%20material%20greenhouse%20(Plastik%20UV%2FParanet%2FInsect%20Net)."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-between p-4 rounded-2xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs sm:text-sm font-semibold transition-all border border-zinc-700"
          >
            <span>Cek Stok Plastik UV &amp; Paranet</span>
            <span>&rarr;</span>
          </a>

          <a
            href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20memesan%20saprodi%20pertanian%20%2F%20selang%20irigasi%20drip."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full flex items-center justify-between p-4 rounded-2xl bg-zinc-800 hover:bg-zinc-700 text-white text-xs sm:text-sm font-semibold transition-all border border-zinc-700"
          >
            <span>Pemesanan Saprodi &amp; Irigasi Drip</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
