---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, getArticleSchema } from '../../utils/seo';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'artikel'>;
}

const { article } = Astro.props;
const { Content } = await article.render();

const allArticles = await getCollection('artikel');
const relatedArticles = allArticles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 2);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Artikel & Panduan', url: 'https://agrokomplekcemerlang.com/artikel/' },
  { name: article.data.title, url: `https://agrokomplekcemerlang.com/artikel/${article.slug}/` },
]);

const articleSchema = getArticleSchema({
  title: article.data.title,
  description: article.data.description,
  heroImage: article.data.heroImage,
  publishDate: article.data.publishDate,
  updatedDate: article.data.updatedDate,
  author: article.data.author,
  slug: article.slug,
});
---

<BaseLayout
  title={`${article.data.title} - Panduan Agrokomplek Cemerlang`}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb
      items={[
        { label: 'Artikel & Panduan', href: '/artikel/' },
        { label: article.data.title },
      ]}
    />

    <article class="my-8">
      <div class="space-y-4 mb-8">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          {article.data.category}
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-zinc-900 tracking-tight leading-tight">
          {article.data.title}
        </h1>
        <div class="flex items-center gap-3 text-xs text-zinc-500 pt-1">
          <span>Ditulis oleh: <strong class="font-semibold text-zinc-800">{article.data.author}</strong></span>
          <span>&bull;</span>
          <span>{article.data.publishDate}</span>
        </div>
      </div>

      <!-- Hero Image Frame -->
      <div class="rounded-3xl overflow-hidden bg-zinc-100 border border-zinc-200/80 mb-12 shadow-sm aspect-video">
        <img
          src={article.data.heroImage}
          alt={article.data.title}
          width="1200"
          height="675"
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Content -->
      <div class="prose prose-zinc prose-emerald max-w-none text-zinc-700 text-base sm:text-lg leading-relaxed">
        <Content />
      </div>

      <!-- Related Guides & Services -->
      <div class="mt-14 pt-8 border-t border-zinc-200/80">
        <h2 class="text-xl font-bold text-zinc-900 mb-6">Panduan Terkait Lainnya</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {relatedArticles.map((rel) => (
            <a
              href={`/artikel/${rel.slug}/`}
              class="p-5 rounded-2xl bg-zinc-50/70 border border-zinc-200/80 hover:border-emerald-300 hover:bg-white transition-all block group"
            >
              <span class="text-xs font-semibold text-emerald-700">{rel.data.category}</span>
              <h3 class="font-bold text-zinc-900 text-sm mt-1 group-hover:text-emerald-700 transition-colors">
                {rel.data.title}
              </h3>
              <p class="text-xs text-zinc-500 mt-1 line-clamp-2">{rel.data.description}</p>
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom Author / CTA Box -->
      <div class="mt-12 p-8 sm:p-10 rounded-3xl bg-zinc-900 text-white border border-zinc-800 shadow-xl">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-700/50">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Konsultasi Praktisi Lapangan
            </span>
            <h4 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Butuh Diskusi Teknis Lebih Lanjut?</h4>
            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed max-w-xl">
              Tim spesialis Agrokomplek Cemerlang siap membantu menjawab pertanyaan spesifik seputar pemilihan material atau pembangunan fasilitas greenhouse Anda.
            </p>
          </div>
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20membaca%20artikel%20dan%20ingin%20konsultasi%20lebih%20lanjut."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-all shadow-lg hover:shadow-emerald-900/50 shrink-0 select-none"
          >
            <span>Konsultasi via WA &rarr;</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
