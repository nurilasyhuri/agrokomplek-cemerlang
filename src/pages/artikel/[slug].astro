---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, getArticleSchema } from '../../utils/seo';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('artikel');
  return articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'artikel'>;
}

const { article } = Astro.props;
const { Content } = await article.render();

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Artikel', url: '/artikel/' },
  { name: article.data.title, url: `/artikel/${article.slug}/` },
]);

const articleSchema = getArticleSchema({
  title: article.data.title,
  description: article.data.description,
  heroImage: article.data.heroImage,
  publishDate: article.data.publishDate,
  updatedDate: article.data.updatedDate,
  author: article.data.author,
  slug: article.slug,
});
---

<BaseLayout
  title={`${article.data.title} - Panduan Pertanian`}
  description={article.data.description}
  image={article.data.heroImage}
  type="article"
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb
      items={[
        { label: 'Artikel', href: '/artikel/' },
        { label: article.data.title },
      ]}
    />

    <article class="my-8">
      <div class="space-y-3 mb-8">
        <span class="text-xs font-bold text-agri-700 bg-agri-50 border border-agri-100 px-3 py-0.5 rounded-sm uppercase tracking-wider inline-block">
          {article.data.category}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-ink-primary tracking-tight leading-tight">
          {article.data.title}
        </h1>
        <div class="flex items-center gap-3 text-xs text-ink-muted pt-1">
          <span>Ditulis oleh: <strong class="text-ink-primary">{article.data.author}</strong></span>
          <span>&bull;</span>
          <span>{article.data.publishDate}</span>
        </div>
      </div>

      <!-- Hero Image Frame -->
      <div class="rounded-lg overflow-hidden bg-surface-subtle border border-surface-border mb-10 p-1.5">
        <div class="aspect-video rounded-md overflow-hidden bg-surface-canvas relative border border-surface-border">
          <img
            src={article.data.heroImage}
            alt={article.data.title}
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- Content -->
      <div class="prose prose-emerald max-w-none text-ink-secondary text-base leading-relaxed">
        <Content />
      </div>

      <!-- Bottom Author / CTA Box -->
      <div class="mt-12 p-8 rounded-lg bg-agri-950 text-white border border-agri-800 space-y-4 text-center sm:text-left shadow-md">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-ochre-100 block">Konsultasi Teknis</span>
            <h4 class="text-lg font-bold text-white">Butuh Diskusi Teknis Lebih Lanjut?</h4>
            <p class="text-xs sm:text-sm text-agri-100 leading-relaxed max-w-xl">
              Tim spesialis Agrokomplek Cemerlang siap membantu menjawab pertanyaan spesifik seputar proyek budidaya atau pembangunan greenhouse Anda.
            </p>
          </div>
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20membaca%20artikel%20dan%20ingin%20konsultasi%20lebih%20lanjut."
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-md bg-ochre-700 hover:bg-ochre-800 text-white font-bold text-xs uppercase tracking-wider transition-colors shrink-0 select-none"
          >
            <span>Konsultasi via WA</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>
