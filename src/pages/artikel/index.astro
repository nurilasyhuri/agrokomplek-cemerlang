---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const articles = await getCollection('artikel');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);
---

<BaseLayout
  title="Artikel &amp; Panduan Pertanian Modern"
  description="Kumpulan panduan teknis agribisnis: estimasi RAB greenhouse, perbandingan plastik UV vs paranet, manajemen ventilasi, dan teknik irigasi tetes tropis."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Artikel' }]} />

    <div class="my-8 text-center max-w-3xl mx-auto space-y-2">
      <span class="text-xs font-bold text-agri-700 uppercase tracking-wider bg-agri-50 border border-agri-100 px-3 py-1 rounded-sm inline-block">
        Edukasi &amp; Panduan Praktisi
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-primary tracking-tight">
        Panduan Pertanian &amp; Konstruksi Greenhouse
      </h1>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        Artikel teknis berbasis pengalaman lapangan untuk membantu Anda mengambil keputusan yang tepat terkait pemilihan sarana produksi dan pembangunan fasilitas budidaya.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 my-10">
      {sortedArticles.map((art) => (
        <a
          href={`/artikel/${art.slug}/`}
          class="group rounded-lg bg-surface-card border border-surface-border overflow-hidden hover:border-agri-700 transition-colors flex flex-col justify-between"
        >
          <div>
            <div class="aspect-video bg-surface-subtle relative overflow-hidden border-b border-surface-border">
              <img
                src={art.data.heroImage}
                alt={art.data.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute top-3 left-3 bg-agri-700 text-white px-2.5 py-0.5 rounded-xs text-[10px] font-bold uppercase tracking-wider">
                {art.data.category}
              </div>
            </div>

            <div class="p-5 space-y-2.5">
              <span class="text-[11px] text-ink-muted block font-medium">
                {art.data.publishDate}
              </span>
              <h3 class="font-bold text-ink-primary text-lg sm:text-xl leading-snug group-hover:text-agri-700 transition-colors">
                {art.data.title}
              </h3>
              <p class="text-xs text-ink-secondary line-clamp-3 leading-relaxed">
                {art.data.description}
              </p>
            </div>
          </div>

          <div class="px-5 py-3 bg-surface-subtle border-t border-surface-border flex items-center justify-between text-xs font-bold text-agri-700">
            <span>Baca Panduan Selengkapnya</span>
            <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
