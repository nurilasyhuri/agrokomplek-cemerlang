---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollectionPageSchema, getBreadcrumbSchema } from '../../utils/seo';
import { getCollection } from 'astro:content';

const articles = await getCollection('artikel');
const sortedArticles = articles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

function calculateReadingTime(text: string | undefined): string {
  if (!text) return '4 min read';
  const words = text.trim().split(/\s+/).length;
  const minutes = Math.max(2, Math.ceil(words / 180));
  return `${minutes} min read`;
}

const categories = ['Semua', ...Array.from(new Set(sortedArticles.map((a) => a.data.category)))];

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agroprimagreenhouse.com/' },
  { name: 'Artikel & Panduan', url: 'https://agroprimagreenhouse.com/artikel/' },
]);

const collectionSchema = getCollectionPageSchema({
  name: 'Panduan Pertanian, Konstruksi Greenhouse & Irigasi',
  description: 'Artikel teknis praktisi agribisnis: estimasi biaya pembuatan greenhouse, perbandingan plastik UV vs paranet, konstruksi tunnel garam, dan instalasi fertigasi tetes.',
  url: 'https://agroprimagreenhouse.com/artikel/',
  items: sortedArticles.map((art) => ({
    name: art.data.title,
    url: `https://agroprimagreenhouse.com/artikel/${art.slug}/`,
    description: art.data.description,
  })),
});
const articleListKeywords = [
  'panduan greenhouse',
  'biaya pembuatan greenhouse per m2',
  'cara pasang plastik uv',
  'irigasi tetes cabai melon',
  'konstruksi tunnel garam',
  'plastik uv vs paranet',
  'artikel pertanian modern',
  'agro prima greenhouse',
];
---

<BaseLayout
  title="Panduan Pertanian, Konstruksi Greenhouse &amp; Irigasi - Agro Prima Greenhouse"
  description="Kumpulan panduan teknis agribisnis: estimasi RAB greenhouse, perbandingan plastik UV vs paranet, manajemen ventilasi, &amp; teknik irigasi tetes tropis di Indonesia."
  keywords={articleListKeywords}
  jsonLd={[collectionSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-28">
    <Breadcrumb items={[{ label: 'Artikel & Panduan' }]} />

    <!-- Editorial Header (Medium Publication Style) -->
    <header class="pt-8 pb-10 space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Jurnal &amp; Panduan Praktisi
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-zinc-900 tracking-tight leading-[1.15]">
        Wawasan Lapangan, Konstruksi Greenhouse &amp; Irigasi
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 font-normal leading-relaxed max-w-2xl">
        Kumpulan panduan teknis berbasis pengalaman lapangan untuk membantu Anda mengambil keputusan tepat dalam pemilihan material dan pembangunan fasilitas greenhouse modern di Indonesia.
      </p>

      <!-- Category Filter Pills (Medium Topic Bar) -->
      <div class="flex items-center gap-2 overflow-x-auto pt-4 pb-2 no-scrollbar">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category-btn={cat}
            class={`category-tab px-4 py-2 rounded-full text-xs sm:text-sm font-medium transition-all shrink-0 select-none ${
              idx === 0
                ? 'bg-zinc-900 text-white shadow-sm active-tab'
                : 'bg-zinc-100 text-zinc-600 hover:bg-zinc-200 hover:text-zinc-900'
            }`}
          >
            {cat}
          </button>
        ))}
      </div>
    </header>

    <!-- Articles Feed (Clean Medium Story List - No HR / Lines) -->
    <div id="articles-feed" class="space-y-6 sm:space-y-8">
      {sortedArticles.map((art, idx) => {
        const readTime = calculateReadingTime(art.body);
        const isFirst = idx === 0;

        return (
          <article
            data-category={art.data.category}
            class="article-item group p-4 sm:p-6 -mx-4 sm:-mx-6 rounded-2xl hover:bg-zinc-50/90 transition-all duration-200"
          >
            <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-6 sm:gap-8">
              <!-- Left / Main Text Column -->
              <div class="flex-1 min-w-0 space-y-2.5">
                <!-- Author & Date Header -->
                <div class="flex items-center gap-2.5 text-xs text-zinc-500">
                  <div class="w-6 h-6 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-[10px] shrink-0">
                    AP
                  </div>
                  <span class="font-medium text-zinc-800">{art.data.author}</span>
                  <span class="text-zinc-300">&bull;</span>
                  <span>{art.data.publishDate}</span>
                </div>

                <!-- Title & Excerpt -->
                <a href={`/artikel/${art.slug}/`} class="block group">
                  <h2 class="text-lg sm:text-xl md:text-2xl font-bold text-zinc-900 group-hover:text-emerald-700 transition-colors tracking-tight leading-snug">
                    {art.data.title}
                  </h2>
                  <p class="text-sm sm:text-base text-zinc-600 line-clamp-2 leading-relaxed mt-2 font-normal">
                    {art.data.description}
                  </p>
                </a>

                <!-- Meta Footer -->
                <div class="flex items-center justify-between pt-2">
                  <div class="flex items-center gap-3">
                    <span class="inline-block text-xs font-medium px-3 py-1 rounded-full bg-zinc-100 text-zinc-700 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition-colors">
                      {art.data.category}
                    </span>
                    <span class="text-xs text-zinc-400 font-medium">
                      {readTime}
                    </span>
                  </div>

                  <a
                    href={`/artikel/${art.slug}/`}
                    class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1 group-hover:translate-x-1 transition-all"
                  >
                    <span>Baca</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </div>
              </div>

              <!-- Right / Thumbnail Column -->
              <a
                href={`/artikel/${art.slug}/`}
                class="w-full sm:w-44 md:w-52 lg:w-60 aspect-[16/10] sm:aspect-[4/3] rounded-xl overflow-hidden bg-zinc-100 shrink-0 block"
              >
                <img
                  src={art.data.heroImage}
                  alt={art.data.title}
                  width="360"
                  height="270"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading={isFirst ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Empty State for Filter -->
    <div id="empty-state" class="hidden text-center py-16 space-y-3">
      <p class="text-base text-zinc-500 font-medium">Tidak ada artikel di kategori ini saat ini.</p>
      <button
        type="button"
        id="reset-filter-btn"
        class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 underline underline-offset-4"
      >
        Tampilkan semua artikel
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  function setupCategoryFilter() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-category-btn]');
    const articles = document.querySelectorAll<HTMLElement>('.article-item');
    const emptyState = document.getElementById('empty-state');
    const resetBtn = document.getElementById('reset-filter-btn');

    function applyFilter(category: string) {
      let visibleCount = 0;

      buttons.forEach((b) => {
        const isActive = b.dataset.categoryBtn === category;
        if (isActive) {
          b.classList.add('bg-zinc-900', 'text-white', 'shadow-sm', 'active-tab');
          b.classList.remove('bg-zinc-100', 'text-zinc-600');
        } else {
          b.classList.remove('bg-zinc-900', 'text-white', 'shadow-sm', 'active-tab');
          b.classList.add('bg-zinc-100', 'text-zinc-600');
        }
      });

      articles.forEach((art) => {
        const artCat = art.dataset.category;
        if (category === 'Semua' || artCat === category) {
          art.style.display = 'block';
          visibleCount++;
        } else {
          art.style.display = 'none';
        }
      });

      if (emptyState) {
        emptyState.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.categoryBtn || 'Semua';
        applyFilter(cat);
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        applyFilter('Semua');
      });
    }
  }

  // Run on initial load and View Transitions
  setupCategoryFilter();
  document.addEventListener('astro:page-load', setupCategoryFilter);
</script>
