---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getLocalBusinessSchema } from '../utils/seo';

const schema = getLocalBusinessSchema();
---

<BaseLayout
  title="Lokasi Toko Pertanian di Kedungkandang Malang"
  description="Kunjungi toko fisik Agrokomplek Cemerlang di Jl. KH. Malik Dalam RT 01 RW 07, Buring, Kedungkandang, Kota Malang. Lihat petunjuk arah, rute, dan jam buka."
  jsonLd={schema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Lokasi & Toko' }]} />

    <div class="my-8 text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider bg-brand-50 px-3 py-1 rounded-full">
        Toko Fisik & Pusat Operasional
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-steel-900 tracking-tight">
        Toko Pertanian Agrokomplek Cemerlang di Malang
      </h1>
      <p class="text-base text-steel-600 leading-relaxed">
        Bagi pelanggan di Malang Raya (Kedungkandang, Buring, Gadang, Tajinan, Kota Malang, Kota Batu, dan Kabupaten Malang), silakan berkunjung langsung untuk melihat fisik produk dan konsultasi teknis greenhouse.
      </p>
    </div>

    <!-- Map & Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-10 items-start">
      
      <!-- Interactive Google Maps Iframe -->
      <div class="lg:col-span-7 bg-white p-3 rounded-3xl border border-steel-200 shadow-soft">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-steel-100 relative">
          <iframe
            src="https://maps.google.com/maps?q=-7.9984,112.6456&z=15&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            title="Lokasi Agrokomplek Cemerlang Malang"
          ></iframe>
        </div>
      </div>

      <!-- NAP & Landmarks -->
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 rounded-3xl bg-white border border-steel-200 shadow-soft space-y-4">
          <h3 class="text-lg font-bold text-steel-900 border-b border-steel-100 pb-3">
            Informasi Alamat & Kontak
          </h3>

          <div class="space-y-3 text-xs sm:text-sm text-steel-700">
            <div>
              <span class="font-bold text-steel-900 block">Alamat Lengkap:</span>
              <span>{BUSINESS_INFO.address.fullFormatted}</span>
            </div>

            <div>
              <span class="font-bold text-steel-900 block">Nomor WhatsApp / Telepon:</span>
              <a href={`https://wa.me/${BUSINESS_INFO.contact.whatsappRaw}`} class="text-brand-700 font-semibold hover:underline">
                {BUSINESS_INFO.contact.phone}
              </a>
            </div>

            <div>
              <span class="font-bold text-steel-900 block">Jam Buka Toko Fisik:</span>
              <span>{BUSINESS_INFO.hours.physicalStore}</span>
            </div>

            <div>
              <span class="font-bold text-steel-900 block">Email Bisnis:</span>
              <span>{BUSINESS_INFO.contact.email}</span>
            </div>
          </div>

          <div class="pt-2">
            <a
              href={BUSINESS_INFO.geo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-brand-700 hover:bg-brand-800 text-white font-bold text-xs shadow-soft transition-colors"
            >
              <span>Buka Navigasi Google Maps</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Landmarks & Guidance -->
        <div class="p-6 rounded-3xl bg-earth-sand/50 border border-steel-200 space-y-3">
          <h4 class="text-sm font-bold text-steel-900">Petunjuk Rute & Akses:</h4>
          <ul class="text-xs text-steel-600 space-y-2">
            <li>• Dari arah <strong>Terminal Gadang</strong>: Ambil arah Buring / Kedungkandang (sekitar 7-10 menit).</li>
            <li>• Dari arah <strong>Pusat Kota Malang / Alun-alun</strong>: Melalui Jl. Kolonel Sugiono ke arah Jl. KH. Malik Dalam.</li>
            <li>• Akses kendaraan roda dua, mobil, dan truk muatan saprodi dapat masuk dengan mudah.</li>
          </ul>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
