---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { BUSINESS_INFO } from '../data/businessInfo';
import { getLocalBusinessSchema } from '../utils/seo';

const schema = getLocalBusinessSchema();
---

<BaseLayout
  title="Toko Pertanian Kedungkandang Malang | Agrokomplek"
  description="Kunjungi toko fisik &amp; gudang Agrokomplek Cemerlang di Buring, Kedungkandang, Kota Malang. Cek sampel plastik UV, paranet, pupuk, &amp; konsultasi greenhouse."
  jsonLd={schema}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Lokasi & Toko' }]} />

    <div class="my-10 text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Toko Pertanian &amp; Gudang Malang
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight">
        Toko Pertanian di Kedungkandang Malang &amp; Pusat Saprodi
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        Pusat sarana produksi pertanian dan suplai material greenhouse bagi petani di Malang Raya (Kedungkandang, Buring, Gadang, Tajinan, Kota Malang, Kota Batu, dan sekitarnya). Kunjungi toko fisik kami untuk melihat sampel produk dan konsultasi teknis greenhouse.
      </p>
    </div>

    <!-- Map & Details Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 my-10 items-start">
      
      <!-- Interactive Google Maps Container -->
      <div class="lg:col-span-7 bg-white p-3 rounded-3xl border border-zinc-200/80 shadow-sm overflow-hidden">
        <div class="aspect-[4/3] rounded-2xl overflow-hidden bg-zinc-100 relative">
          <iframe
            src="https://maps.google.com/maps?q=-7.9984,112.6456&z=15&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            title="Lokasi Agrokomplek Cemerlang Malang"
          ></iframe>
        </div>
      </div>

      <!-- NAP & Landmarks -->
      <div class="lg:col-span-5 space-y-6">
        <div class="p-6 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-6">
          <h3 class="text-lg font-bold text-zinc-900 border-b border-zinc-100 pb-3">
            Informasi Alamat & Kontak Toko
          </h3>

          <div class="space-y-4 text-xs sm:text-sm text-zinc-600">
            <div>
              <span class="font-semibold text-zinc-900 block text-xs uppercase tracking-wider text-zinc-500">Alamat Lengkap</span>
              <span class="mt-1 block leading-relaxed text-zinc-700">{BUSINESS_INFO.address.fullFormatted}</span>
            </div>

            <div class="border-t border-zinc-100 pt-4">
              <span class="font-semibold block text-xs uppercase tracking-wider text-zinc-500">WhatsApp / Telepon</span>
              <a href={`https://wa.me/${BUSINESS_INFO.contact.whatsappRaw}`} class="text-emerald-700 font-bold hover:underline mt-1 inline-block text-base">
                {BUSINESS_INFO.contact.phone}
              </a>
            </div>

            <div class="border-t border-zinc-100 pt-4">
              <span class="font-semibold block text-xs uppercase tracking-wider text-zinc-500">Jam Buka Toko Fisik</span>
              <span class="mt-1 block font-medium text-zinc-800">{BUSINESS_INFO.hours.physicalStore}</span>
              <span class="text-xs text-zinc-500">(Konsultasi Online WhatsApp 24 Jam)</span>
            </div>

            <div class="border-t border-zinc-100 pt-4">
              <span class="font-semibold block text-xs uppercase tracking-wider text-zinc-500">Email</span>
              <span class="mt-1 block text-zinc-700">{BUSINESS_INFO.contact.email}</span>
            </div>
          </div>

          <div class="pt-2">
            <a
              href={BUSINESS_INFO.geo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm select-none"
            >
              <span>Buka Navigasi Google Maps</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Landmarks & Guidance -->
        <div class="p-6 sm:p-7 rounded-3xl bg-zinc-50/70 border border-zinc-200/80 space-y-4">
          <h4 class="text-sm sm:text-base font-bold text-zinc-900">Petunjuk Rute & Akses Gudang</h4>
          <ul class="text-xs text-zinc-600 space-y-3 leading-relaxed">
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full shrink-0 mt-2"></span>
              <span><strong>Dari Terminal Gadang:</strong> Ambil arah Buring / Kedungkandang (sekitar 7-10 menit berkendara).</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full shrink-0 mt-2"></span>
              <span><strong>Dari Alun-alun Kota Malang:</strong> Melalui Jl. Kolonel Sugiono mengarah ke Jl. KH. Malik Dalam.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="w-1.5 h-1.5 bg-emerald-600 rounded-full shrink-0 mt-2"></span>
              <span><strong>Akses Truk & Muatan:</strong> Akses jalan lebar memadai untuk pikap, truk engkel, hingga truk CDD ekspedisi.</span>
            </li>
          </ul>
        </div>

      </div>

    </div>
  </div>
</BaseLayout>
