---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import EstimationCalculator from '../../components/greenhouse/EstimationCalculator';
import { getGreenhouseServiceSchema, getBreadcrumbSchema, getFaqSchema } from '../../utils/seo';
import { GREENHOUSE_FAQS } from '../../data/faqs';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waConsultUrl = generateGeneralInquiryUrl('greenhouse-landing-primary');
const serviceSchema = getGreenhouseServiceSchema();
const faqSchema = getFaqSchema(GREENHOUSE_FAQS);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Jasa Pembuatan Greenhouse', url: 'https://agrokomplekcemerlang.com/jasa/pembuatan-greenhouse/' },
]);

const serviceKeywords = [
  'jasa pembuatan greenhouse',
  'kontraktor greenhouse',
  'biaya pembuatan greenhouse per m2',
  'kalkulator rab greenhouse',
  'greenhouse pipa galvanis hot dip',
  'greenhouse bambu malang',
  'greenhouse baja ringan',
  'tunnel garam prisma',
  'pembuatan greenhouse indonesia',
];
---

<BaseLayout
  title="Jasa Pembuatan Greenhouse Malang &amp; Kontraktor Indonesia - Agrokomplek Cemerlang"
  description="Kontraktor jasa pembuatan greenhouse di Malang. Spesialis rancang bangun struktur pipa galvanis hot-dip, bambu awet, baja ringan, &amp; tunnel garam seluruh Indonesia."
  keywords={serviceKeywords}
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-20 space-y-12">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Jasa Pembuatan Greenhouse' }]} />

    <!-- Page Header Hero -->
    <div class="border-b border-[#dedad0] pb-12 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#e4e5da] text-[#064e3b] border border-[#dedad0] mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-[#064e3b]"></span>
        Kontraktor &amp; Aplikator Greenhouse Indonesia
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-[#1b2819] leading-[1.15] max-w-4xl">
        Jasa Pembuatan Greenhouse Pipa Galvanis, Bambu &amp; Baja Ringan
      </h1>
      <p class="text-base sm:text-lg text-[#485245] mt-4 leading-relaxed max-w-3xl">
        Agrokomplek Cemerlang adalah kontraktor spesialis pembuatan greenhouse terpercaya di Malang yang melayani proyek ke seluruh Indonesia. Kami menyediakan rancang bangun presisi: perhitungan beban terpaan angin tropis, ventilasi monitor roof penurun suhu, atap plastik UV 200 mikron anti-drip, dan instalasi lapangan siap pakai untuk kebun melon hidroponik, sayuran daun, nursery, hingga tunnel garam.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-8">
        <a
          href="#kalkulator"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-[#064e3b] hover:bg-[#047857] text-[#edeae1] font-semibold text-sm transition-all shadow-sm select-none"
        >
          <span>Hitung Estimasi Biaya Greenhouse (RAB)</span>
          <span aria-hidden="true">&darr;</span>
        </a>

        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-[#dedad0] bg-white hover:bg-[#e4e5da]/40 text-[#1b2819] font-semibold text-sm transition-all shadow-xs select-none"
        >
          <svg class="w-4 h-4 text-[#064e3b]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Konsultasi Proyek via WhatsApp</span>
        </a>
      </div>
    </div>

    <!-- 4 Core Engineering Principles -->
    <div class="space-y-6">
      <div>
        <span class="text-xs font-semibold text-[#064e3b] uppercase tracking-wider block">Pendekatan Rekayasa Tropis</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1b2819] tracking-tight mt-1">
          Mengapa Desain Greenhouse Membutuhkan Perhitungan Teknis
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-white border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-[#064e3b]/30">
          <div class="w-9 h-9 rounded-full bg-[#e4e5da] border border-[#dedad0] flex items-center justify-center text-xs font-bold text-[#064e3b]">
            01
          </div>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Ventilasi Monitor Roof</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Menghindari hawa panas terperangkap dengan bukaan atap alami (chimney effect) sehingga suhu ruangan dalam greenhouse tetap sejuk dan tanaman tidak stres panas.
          </p>
        </div>

        <div class="bg-white border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-[#064e3b]/30">
          <div class="w-9 h-9 rounded-full bg-[#e4e5da] border border-[#dedad0] flex items-center justify-center text-xs font-bold text-[#064e3b]">
            02
          </div>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Kemiringan &amp; Anti-Drip</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Mencegah tetesan air embun jatuh langsung ke daun tanaman hortikultura yang menjadi pemicu utama serangan spora jamur dan busuk daun.
          </p>
        </div>

        <div class="bg-white border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-[#064e3b]/30">
          <div class="w-9 h-9 rounded-full bg-[#e4e5da] border border-[#dedad0] flex items-center justify-center text-xs font-bold text-[#064e3b]">
            03
          </div>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Kekokohan Beban Angin</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Perhitungan jarak gording, kedalaman fondasi cor angkur strouss, dan ketahanan terhadap beban gantungan melon bertonase tinggi.
          </p>
        </div>

        <div class="bg-white border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-[#064e3b]/30">
          <div class="w-9 h-9 rounded-full bg-[#e4e5da] border border-[#dedad0] flex items-center justify-center text-xs font-bold text-[#064e3b]">
            04
          </div>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Difusi Cahaya &amp; PAR UV</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Penggunaan plastik UV 200 mikron 14% dengan aditif perata cahaya (light diffusion) agar fotosintesis merata ke seluruh lapisan daun tanaman.
          </p>
        </div>
      </div>
    </div>

    <!-- Pilihan Tipe Rangka Greenhouse -->
    <div class="space-y-6 border-t border-[#dedad0] pt-12">
      <div>
        <span class="text-xs font-semibold text-[#064e3b] uppercase tracking-wider block">Spesifikasi Konstruksi</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1b2819] tracking-tight mt-1">
          Pilihan Rangka Greenhouse Sesuai Kebutuhan &amp; Anggaran
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        <div class="bg-white border border-[#dedad0] rounded-xl overflow-hidden shadow-sm hover:border-[#064e3b]/30 transition-all flex flex-col justify-between group">
          <div>
            <div class="aspect-[16/10] bg-zinc-100 relative overflow-hidden">
              <img
                src="/images/greenhouse/greenhouse-bambu.webp"
                alt="Greenhouse Rangka Bambu Awet Ekonomis"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6 space-y-2">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#f4f1ea] text-[#1b2819] border border-[#c59b27]/40">Ekonomis</span>
              <h3 class="text-lg font-bold text-[#1b2819]">Greenhouse Bambu</h3>
              <p class="text-xs text-[#485245] leading-relaxed">
                Menggunakan bambu ori pilihan yang diawetkan. Pilihan berbiaya paling hemat untuk kebun pemula atau persemaian bibit.
              </p>
              <div class="pt-2 text-xs text-[#485245] space-y-1">
                <p>• Ketahanan: 3 - 5 Tahun</p>
                <p>• Estimasi: Rp 100rb - 175rb/m²</p>
                <p>• Komoditas: Sayuran daun, bibit</p>
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={generateGeneralInquiryUrl('konsultasi-gh-bambu')} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#064e3b] hover:text-[#141d13] flex items-center justify-between pt-3 border-t border-[#dedad0]">
              <span>Konsultasi Bambu</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="bg-white border border-[#dedad0] rounded-xl overflow-hidden shadow-sm hover:border-[#064e3b]/30 transition-all flex flex-col justify-between group">
          <div>
            <div class="aspect-[16/10] bg-zinc-100 relative overflow-hidden">
              <img
                src="/images/greenhouse/greenhouse-baja-ringan.webp"
                alt="Greenhouse Rangka Baja Ringan Presisi"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6 space-y-2">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#e4e5da] text-[#064e3b] border border-[#dedad0]">Instalasi Cepat</span>
              <h3 class="text-lg font-bold text-[#1b2819]">Greenhouse Baja Ringan</h3>
              <p class="text-xs text-[#485245] leading-relaxed">
                Rangka kanal C dan reng zincalume anti-karat berbobot ringan, proses perakitan cepat, dan tampilan rapi terstandar.
              </p>
              <div class="pt-2 text-xs text-[#485245] space-y-1">
                <p>• Ketahanan: 7 - 10 Tahun</p>
                <p>• Estimasi: Rp 200rb - 350rb/m²</p>
                <p>• Komoditas: Sayuran, stroberi, melon</p>
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={generateGeneralInquiryUrl('konsultasi-gh-baja-ringan')} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#064e3b] hover:text-[#141d13] flex items-center justify-between pt-3 border-t border-[#dedad0]">
              <span>Konsultasi Baja Ringan</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="bg-white border-2 border-[#064e3b] rounded-xl overflow-hidden shadow-md hover:border-[#047857] transition-all flex flex-col justify-between relative group">
          <div>
            <div class="aspect-[16/10] bg-zinc-100 relative overflow-hidden">
              <img
                src="/images/greenhouse/greenhouse-galvanis.webp"
                alt="Greenhouse Pipa Galvanis Hot-Dip Komersial"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6 space-y-2">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#064e3b] text-[#edeae1]">Rekomendasi Komersial</span>
              <h3 class="text-lg font-bold text-[#1b2819]">Greenhouse Pipa Galvanis</h3>
              <p class="text-xs text-[#485245] leading-relaxed">
                Pipa galvanis hot-dip anti-karat untuk perkebunan intensif jangka panjang. Menopang beban gantung melon dan cuaca ekstrem.
              </p>
              <div class="pt-2 text-xs text-[#485245] space-y-1">
                <p>• Ketahanan: 10 - 15+ Tahun</p>
                <p>• Estimasi: Rp 350rb - 650rb+/m²</p>
                <p>• Komoditas: Melon hidroponik, tomat, paprika</p>
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={generateGeneralInquiryUrl('konsultasi-gh-galvanis')} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#064e3b] hover:text-[#141d13] flex items-center justify-between pt-3 border-t border-[#dedad0]">
              <span>Konsultasi Galvanis</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>

        <div class="bg-white border border-[#dedad0] rounded-xl overflow-hidden shadow-sm hover:border-[#064e3b]/30 transition-all flex flex-col justify-between group">
          <div>
            <div class="aspect-[16/10] bg-zinc-100 relative overflow-hidden">
              <img
                src="/images/greenhouse/tunnel-garam-greenhouse.webp"
                alt="Tunnel Prisma Garam Pesisir Modern"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6 space-y-2">
              <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-[#e4e5da] text-[#1b2819] border border-[#dedad0]">Spesialis Pesisir</span>
              <h3 class="text-lg font-bold text-[#1b2819]">Tunnel Garam (Prisma)</h3>
              <p class="text-xs text-[#485245] leading-relaxed">
                Inovasi greenhouse meja kristalisasi garam tahan asam air laut. Panen garam industri bersih terus berlanjut tanpa terganggu hujan.
              </p>
              <div class="pt-2 text-xs text-[#485245] space-y-1">
                <p>• Ketahanan: 5 - 10 Tahun</p>
                <p>• Rangka: Pipa lengkung anti korosi</p>
                <p>• Manfaat: Kadar NaCl 95%+, panen 365 hari</p>
              </div>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href={generateGeneralInquiryUrl('konsultasi-tunnel-garam')} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-[#064e3b] hover:text-[#141d13] flex items-center justify-between pt-3 border-t border-[#dedad0]">
              <span>Konsultasi Tunnel Garam</span>
              <span>&rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Interactive Calculator Anchor -->
    <div id="kalkulator" class="pt-4">
      <EstimationCalculator client:load />
    </div>

    <!-- 4-Step Transparent Workflow -->
    <div class="border-t border-[#dedad0] pt-12 space-y-6">
      <div>
        <span class="text-xs font-semibold text-[#064e3b] uppercase tracking-wider block">Alur Kerja Sama</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1b2819] tracking-tight mt-1">
          Prosedur Dari Konsultasi Awal Hingga Serah Terima Kunci
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-[#f4f1ea] border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-[#1b2819] border border-[#dedad0] shadow-xs">
            Langkah 01
          </span>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Konsultasi Kebutuhan &amp; RAB</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Diskusikan komoditas, ukuran lahan, target waktu, dan budget. Kami susunkan rincian spesifikasi material dan perkiraan anggaran transparan.
          </p>
        </div>

        <div class="bg-[#f4f1ea] border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-[#1b2819] border border-[#dedad0] shadow-xs">
            Langkah 02
          </span>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Survei Lahan &amp; Desain Kerja</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Tim teknisi memeriksa kontur tanah, arah terpaan angin, serta ketersediaan sumber air dan listrik di lokasi proyek Anda.
          </p>
        </div>

        <div class="bg-[#f4f1ea] border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-[#1b2819] border border-[#dedad0] shadow-xs">
            Langkah 03
          </span>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Fabrikasi &amp; Pengiriman</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Material pipa, plastik UV, dan aksesoris dipersiapkan di workshop Malang, kemudian dikirim via armada kargo terpercaya ke lokasi Anda.
          </p>
        </div>

        <div class="bg-[#f4f1ea] border border-[#dedad0] p-6 sm:p-7 rounded-xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-[#1b2819] border border-[#dedad0] shadow-xs">
            Langkah 04
          </span>
          <h3 class="font-bold text-[#1b2819] text-base sm:text-lg leading-snug">Perakitan &amp; Serah Terima</h3>
          <p class="text-xs text-[#485245] leading-relaxed">
            Tim aplikator lapangan merakit struktur hingga tuntas, memasang plastik UV dan insect net, serta uji kekokohan sebelum serah terima.
          </p>
        </div>
      </div>
    </div>

    <!-- Material Rekomendasi Terkait (Internal Linking Silo) -->
    <div class="border-t border-[#dedad0] pt-12 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div>
          <span class="text-xs font-semibold text-[#064e3b] uppercase tracking-wider block">Komponen Berkualitas</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-[#1b2819] tracking-tight mt-1">
            Material Standar Utama yang Kami Pasang
          </h2>
        </div>
        <a href="/produk/" class="text-xs font-bold text-[#064e3b] hover:text-[#141d13] inline-flex items-center gap-1">
          <span>Lihat Semua Katalog Material</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
        <a href="/produk/plastik-uv-greenhouse-14/" class="rounded-xl bg-white border border-[#dedad0] overflow-hidden hover:border-[#064e3b]/30 hover:shadow-md transition-all group flex flex-col justify-between">
          <div>
            <div class="aspect-[16/10] bg-[#e4e5da]/40 border-b border-[#dedad0] relative overflow-hidden flex items-center justify-center p-3">
              <img
                src="/images/products/plastik-uv-greenhouse.webp"
                alt="Plastik UV 200 Mikron 14%"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-5">
              <h3 class="font-bold text-[#1b2819] text-sm group-hover:text-[#064e3b] transition-colors">Plastik UV 200 Mikron 14%</h3>
              <p class="text-xs text-[#485245] mt-1 leading-relaxed">Atap pelindung tahan panas &amp; hujan dengan aditif UV stabilizer anti-getas.</p>
            </div>
          </div>
          <div class="px-5 pb-4 text-xs font-semibold text-[#064e3b] group-hover:text-[#141d13] flex items-center justify-between">
            <span>Detail Material</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/produk/paranet-tanaman/" class="rounded-xl bg-white border border-[#dedad0] overflow-hidden hover:border-[#064e3b]/30 hover:shadow-md transition-all group flex flex-col justify-between">
          <div>
            <div class="aspect-[16/10] bg-[#e4e5da]/40 border-b border-[#dedad0] relative overflow-hidden flex items-center justify-center p-3">
              <img
                src="/images/products/paranet-shading-net.webp"
                alt="Paranet Shading Net 65%-75%"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-5">
              <h3 class="font-bold text-[#1b2819] text-sm group-hover:text-[#064e3b] transition-colors">Paranet Shading Net 65%-75%</h3>
              <p class="text-xs text-[#485245] mt-1 leading-relaxed">Jaring peneduh pengatur intensitas radiasi matahari dan penurun suhu.</p>
            </div>
          </div>
          <div class="px-5 pb-4 text-xs font-semibold text-[#064e3b] group-hover:text-[#141d13] flex items-center justify-between">
            <span>Detail Material</span>
            <span>&rarr;</span>
          </div>
        </a>

        <a href="/produk/insectnet-kasa-greenhouse/" class="rounded-xl bg-white border border-[#dedad0] overflow-hidden hover:border-[#064e3b]/30 hover:shadow-md transition-all group flex flex-col justify-between">
          <div>
            <div class="aspect-[16/10] bg-[#e4e5da]/40 border-b border-[#dedad0] relative overflow-hidden flex items-center justify-center p-3">
              <img
                src="/images/products/insectnet-screen.webp"
                alt="Kasa Insect Net 50 Mesh"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-5">
              <h3 class="font-bold text-[#1b2819] text-sm group-hover:text-[#064e3b] transition-colors">Kasa Insect Net 50 Mesh</h3>
              <p class="text-xs text-[#485245] mt-1 leading-relaxed">Dinding pelindung pencegah kutu kebul, thrips, dan hama mikro.</p>
            </div>
          </div>
          <div class="px-5 pb-4 text-xs font-semibold text-[#064e3b] group-hover:text-[#141d13] flex items-center justify-between">
            <span>Detail Material</span>
            <span>&rarr;</span>
          </div>
        </a>

