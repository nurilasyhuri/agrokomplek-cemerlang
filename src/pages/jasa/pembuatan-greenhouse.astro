---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import EstimationCalculator from '../../components/greenhouse/EstimationCalculator';
import { getGreenhouseServiceSchema, getBreadcrumbSchema } from '../../utils/seo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waConsultUrl = generateGeneralInquiryUrl('greenhouse-landing-primary');
const serviceSchema = getGreenhouseServiceSchema();

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Jasa Pembuatan Greenhouse', url: 'https://agrokomplekcemerlang.com/jasa/pembuatan-greenhouse/' },
]);
---

<BaseLayout
  title="Jasa Pembuatan Greenhouse Indonesia: Bambu, Galvanis, Baja Ringan & Garam | Agrokomplek Cemerlang"
  description="Kontraktor pembuatan greenhouse terpercaya di Malang, melayani rancang bangun struktur galvanis, bambu presisi, baja ringan, dan tunnel garam ke seluruh Indonesia dengan perhitungan teknik iklim tropis."
  jsonLd={[serviceSchema, breadcrumbSchema]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-20 space-y-12">
    
    <!-- Breadcrumb -->
    <Breadcrumb items={[{ label: 'Jasa Pembuatan Greenhouse' }]} />

    <!-- Page Header Hero -->
    <div class="border-b border-zinc-200/80 pb-12 pt-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60 mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Fabrikasi & Konstruksi Pertanian Tropis
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 leading-[1.15] max-w-4xl">
        Jasa Pembuatan Greenhouse Presisi untuk Pertanian Terproteksi
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 mt-4 leading-relaxed max-w-3xl">
        Dari kebun hortikultura intensif hingga komersial skala besar. Agrokomplek Cemerlang menyediakan jasa rancang bangun komprehensif: simulasi beban angin, ventilasi sirkulasi udara mikro, material berspesifikasi standar industri, dan perakitan lapangan di seluruh Indonesia.
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-8">
        <a
          href="#kalkulator"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-sm transition-all shadow-sm select-none"
        >
          <span>Hitung Estimasi Anggaran Lahan</span>
          <span aria-hidden="true">&darr;</span>
        </a>

        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-7 py-3.5 rounded-full border border-zinc-200 bg-white hover:bg-zinc-50 text-zinc-900 font-semibold text-sm transition-all shadow-xs select-none"
        >
          <svg class="w-4 h-4 text-emerald-600" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Diskusi dengan Teknisi WA</span>
        </a>
      </div>
    </div>

    <!-- 4 Core Engineering Principles -->
    <div class="space-y-6">
      <div>
        <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block">Pendekatan Rekayasa</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight mt-1">
          Mengapa Desain Greenhouse Membutuhkan Perhitungan Teknis
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-white border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-zinc-300">
          <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-800">
            01
          </div>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Ventilasi Chimney Tropis</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Menghindari jebakan hawa panas terperangkap dengan desain bukaan atap (monitor roof) sehingga sirkulasi udara panas keluar alami.
          </p>
        </div>

        <div class="bg-white border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-zinc-300">
          <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-800">
            02
          </div>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Kemiringan Atap & Anti-Drip</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Mencegah tetesan air embun jatuh langsung ke daun tanaman yang menjadi pemicu utama serangan jamur dan busuk pucuk.
          </p>
        </div>

        <div class="bg-white border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-zinc-300">
          <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-800">
            03
          </div>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Daya Tahan Terpaan Angin</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Perhitungan jarak gording, kedalaman pondasi cor strouss, dan ketahanan terhadap beban gantungan buah melon serta instalasi hidroponik.
          </p>
        </div>

        <div class="bg-white border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3 shadow-sm hover:shadow-md transition-all hover:border-zinc-300">
          <div class="w-9 h-9 rounded-full bg-emerald-50 border border-emerald-100 flex items-center justify-center text-xs font-bold text-emerald-800">
            04
          </div>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Difusi Cahaya & PAR UV</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Penggunaan plastik UV impor dengan aditif EVA dan anti-dust agar radiasi fotosintesis maksimal tanpa membakar tajuk tanaman.
          </p>
        </div>
      </div>
    </div>

    <!-- Interactive Calculator Anchor -->
    <div id="kalkulator" class="pt-4">
      <EstimationCalculator client:load />
    </div>

    <!-- 4-Step Transparent Workflow -->
    <div class="border-t border-zinc-200/80 pt-12 space-y-6">
      <div>
        <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block">Alur Kerja Sama</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-900 tracking-tight mt-1">
          Prosedur Dari Konsultasi Awal Hingga Serah Terima Kunci
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="bg-zinc-50/70 border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-zinc-900 border border-zinc-200 shadow-xs">
            Langkah 01
          </span>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Konsultasi Kebutuhan & RAB</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Diskusikan komoditas, ukuran lahan, target waktu, dan budget. Kami susunkan rincian spesifikasi material dan perkiraan anggaran transparan.
          </p>
        </div>

        <div class="bg-zinc-50/70 border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-zinc-900 border border-zinc-200 shadow-xs">
            Langkah 02
          </span>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Survei Lahan & Desain Kerja</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Tim teknisi memeriksa kontur tanah, arah terpaan angin, serta ketersediaan sumber air dan listrik di lokasi proyek Anda.
          </p>
        </div>

        <div class="bg-zinc-50/70 border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-zinc-900 border border-zinc-200 shadow-xs">
            Langkah 03
          </span>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Fabrikasi & Pengiriman</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Material pipa, plastik UV, dan aksesoris dipersiapkan di workshop Malang, kemudian dikirim via armada kargo terpercaya ke lokasi Anda.
          </p>
        </div>

        <div class="bg-zinc-50/70 border border-zinc-200/80 p-6 sm:p-7 rounded-3xl space-y-3">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-white text-zinc-900 border border-zinc-200 shadow-xs">
            Langkah 04
          </span>
          <h3 class="font-bold text-zinc-900 text-base sm:text-lg leading-snug">Perakitan & Serah Terima</h3>
          <p class="text-xs text-zinc-600 leading-relaxed">
            Tim aplikator lapangan merakit struktur hingga tuntas, memasang plastik UV dan insect net, serta uji kekokohan sebelum serah terima.
          </p>
        </div>
      </div>
    </div>


  </div>
</BaseLayout>
