---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, getProjectSchema } from '../../utils/seo';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('proyek');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<'proyek'>;
}

const { project } = Astro.props;
const { Content } = await project.render();

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: '/' },
  { name: 'Portofolio Proyek', url: '/proyek/' },
  { name: project.data.title, url: `/proyek/${project.slug}/` },
]);

const projectSchema = getProjectSchema({
  title: project.data.title,
  description: `Studi kasus pengerjaan ${project.data.greenhouseType} di ${project.data.locationCity}, ${project.data.locationProvince}. Dimensi: ${project.data.dimensions}.`,
  coverImage: project.data.coverImage,
  locationCity: project.data.locationCity,
  locationProvince: project.data.locationProvince,
  greenhouseType: project.data.greenhouseType,
  dimensions: project.data.dimensions,
  slug: project.slug,
});
---

<BaseLayout
  title={`${project.data.title} | Proyek Greenhouse`}
  description={`Studi kasus konstruksi ${project.data.greenhouseType} di ${project.data.locationCity}, ${project.data.locationProvince} (Dimensi ${project.data.dimensions}). Dokumentasi & spek material.`}
  image={project.data.coverImage}
  jsonLd={[projectSchema, breadcrumbSchema]}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb
      items={[
        { label: 'Portofolio Proyek', href: '/proyek/' },
        { label: project.data.title },
      ]}
    />

    <div class="my-8 space-y-3">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          {project.data.greenhouseType}
        </span>
        <span class="text-xs font-medium bg-zinc-100 border border-zinc-200 text-zinc-600 px-3 py-1 rounded-full">
          Kategori Klien: {project.data.clientType}
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight leading-tight">
        {project.data.title}
      </h1>
    </div>

    <!-- Main Image Frame -->
    <div class="rounded-3xl overflow-hidden bg-zinc-100 border border-zinc-200/80 mb-8 shadow-sm">
      <div class="aspect-video relative overflow-hidden">
        <img
          src={project.data.coverImage}
          alt={project.data.title}
          class="w-full h-full object-cover"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>

    <!-- Project Metadata Cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 p-6 sm:p-7 rounded-3xl bg-zinc-50/70 border border-zinc-200/80 mb-8 text-xs">
      <div>
        <span class="text-[11px] text-zinc-500 font-semibold block uppercase">Lokasi Proyek</span>
        <span class="font-bold text-zinc-900 mt-1 block text-sm">
          {project.data.locationCity}, {project.data.locationProvince}
        </span>
      </div>
      <div>
        <span class="text-[11px] text-zinc-500 font-semibold block uppercase">Dimensi Lahan</span>
        <span class="font-bold text-zinc-900 mt-1 block text-sm">
          {project.data.dimensions}
        </span>
      </div>
      <div>
        <span class="text-[11px] text-zinc-500 font-semibold block uppercase">Waktu Selesai</span>
        <span class="font-bold text-zinc-900 mt-1 block text-sm">
          {project.data.completionDate}
        </span>
      </div>
      <div>
        <span class="text-[11px] text-zinc-500 font-semibold block uppercase">Tipe Struktur</span>
        <span class="font-bold text-emerald-700 mt-1 block text-sm">
          {project.data.greenhouseType}
        </span>
      </div>
    </div>

    <!-- Main Materials -->
    <div class="p-6 sm:p-7 rounded-3xl bg-white border border-zinc-200/80 mb-8 shadow-sm">
      <h4 class="text-xs font-bold uppercase tracking-wider text-zinc-500 mb-3">
        Material Utama yang Digunakan:
      </h4>
      <div class="flex flex-wrap gap-2">
        {project.data.mainMaterials.map((mat) => (
          <span class="px-3.5 py-1.5 rounded-full bg-zinc-100 border border-zinc-200/80 text-xs font-medium text-zinc-800">
            {mat}
          </span>
        ))}
      </div>
    </div>

    <!-- Markdown Content -->
    <div class="prose prose-zinc prose-emerald max-w-none text-zinc-600 text-sm sm:text-base leading-relaxed mb-12 border-t border-zinc-200/80 pt-8">
      <Content />
    </div>

    <!-- Consultation Box -->
    <div class="p-8 sm:p-10 rounded-3xl bg-zinc-900 text-white text-center space-y-4 shadow-xl border border-zinc-800">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-700/50">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
        Konsultasi Rancang Bangun
      </span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Ingin Membangun Greenhouse Serupa?</h3>
      <p class="text-xs sm:text-sm text-zinc-300 max-w-xl mx-auto leading-relaxed">
        Diskusikan ukuran lahan, target komoditas, dan anggaran bersama tim teknisi aplikator Agrokomplek Cemerlang.
      </p>
      <div class="pt-2">
        <a
          href={`https://wa.me/6285183002070?text=${encodeURIComponent(
            `Halo Agrokomplek Cemerlang, saya melihat portofolio proyek ${project.data.title} dan ingin konsultasi pembuatan greenhouse serupa.`
          )}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all shadow-lg hover:shadow-emerald-900/50 select-none"
        >
          <svg class="w-4 h-4 text-emerald-200" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Konsultasi Proyek via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
