---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('proyek');
---

<BaseLayout
  title="Portofolio Proyek Greenhouse & Konstruksi Pertanian"
  description="Dokumentasi proyek pembuatan greenhouse bambu, pipa galvanis, baja ringan, dan tunnel garam yang telah dikerjakan oleh Agrokomplek Cemerlang."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Portofolio Proyek' }]} />

    <div class="my-8 text-center max-w-3xl mx-auto space-y-3">
      <span class="text-xs font-bold text-brand-700 uppercase tracking-wider bg-brand-50 px-3 py-1 rounded-full">
        Bukti Kerja Nyata
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-steel-900 tracking-tight">
        Proyek Greenhouse Agrokomplek Cemerlang
      </h1>
      <p class="text-base text-steel-600 leading-relaxed">
        Galeri instalasi nyata di berbagai lokasi dengan beragam spesifikasi bahan, ukuran lahan, dan kebutuhan komoditas agribisnis.
      </p>
    </div>

    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {projects.map((proj) => (
          <a
            href={`/proyek/${proj.slug}/`}
            class="group rounded-2xl bg-white border border-steel-200 overflow-hidden shadow-soft hover:shadow-card transition-all flex flex-col justify-between"
          >
            <div>
              <div class="aspect-video bg-steel-100 relative overflow-hidden">
                <img
                  src={proj.data.coverImage}
                  alt={proj.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.setAttribute('src', 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=600&q=80')"
                />
                <div class="absolute top-3 left-3 bg-brand-900/90 backdrop-blur-md text-white px-2.5 py-1 rounded-md text-[10px] font-bold">
                  {proj.data.greenhouseType}
                </div>
              </div>

              <div class="p-5 space-y-3">
                <h3 class="font-bold text-steel-900 text-base leading-snug group-hover:text-brand-700 transition-colors">
                  {proj.data.title}
                </h3>

                <div class="space-y-1 text-xs text-steel-600">
                  <div class="flex items-center gap-1.5">
                    <span>📍</span>
                    <span class="font-medium">{proj.data.locationCity}, {proj.data.locationProvince}</span>
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span>📐</span>
                    <span class="font-medium">Dimensi: {proj.data.dimensions}</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="px-5 py-3.5 bg-steel-50 border-t border-steel-100 flex items-center justify-between text-xs font-semibold text-brand-700">
              <span>Lihat Spesifikasi & Detail</span>
              <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center bg-white rounded-2xl border border-steel-200">
        <p class="text-steel-600">Dokumentasi proyek sedang diperbarui.</p>
      </div>
    )}
  </div>
</BaseLayout>
