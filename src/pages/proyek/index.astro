---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('proyek');
---

<BaseLayout
  title="Portofolio Proyek Konstruksi Greenhouse"
  description="Dokumentasi proyek pengerjaan greenhouse pipa galvanis, bambu presisi, baja ringan, dan tunnel garam yang telah diselesaikan di berbagai wilayah Indonesia."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Portofolio Proyek' }]} />

    <div class="my-8 text-center max-w-3xl mx-auto space-y-2">
      <span class="text-xs font-bold text-agri-700 uppercase tracking-wider bg-agri-50 border border-agri-100 px-3 py-1 rounded-sm inline-block">
        Bukti Kerja Nyata
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-ink-primary tracking-tight">
        Portofolio Proyek Greenhouse Agrokomplek Cemerlang
      </h1>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed">
        Galeri instalasi nyata di berbagai lokasi dengan beragam spesifikasi bahan, ukuran lahan, dan kebutuhan komoditas agribisnis.
      </p>
    </div>

    {projects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((proj) => (
          <a
            href={`/proyek/${proj.slug}/`}
            class="group rounded-lg bg-surface-card border border-surface-border overflow-hidden hover:border-agri-700 transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="aspect-video bg-surface-subtle relative overflow-hidden border-b border-surface-border">
                <img
                  src={proj.data.coverImage}
                  alt={proj.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-3 left-3 bg-agri-700 text-white px-2.5 py-0.5 rounded-xs text-[10px] font-bold uppercase tracking-wider">
                  {proj.data.greenhouseType}
                </div>
              </div>

              <div class="p-5 space-y-3">
                <h3 class="font-bold text-ink-primary text-lg sm:text-xl leading-snug group-hover:text-agri-700 transition-colors">
                  {proj.data.title}
                </h3>

                <div class="space-y-1.5 text-xs text-ink-muted">
                  <div class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-agri-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>{proj.data.locationCity}, {proj.data.locationProvince}</span>
                  </div>
                  <div class="flex items-center gap-2">
                    <svg class="w-3.5 h-3.5 text-agri-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                    </svg>
                    <span>Dimensi: {proj.data.dimensions}</span>
                  </div>
                </div>
              </div>
            </div>

            <div class="px-5 py-3 bg-surface-subtle border-t border-surface-border flex items-center justify-between text-xs font-bold text-agri-700">
              <span>Lihat Spesifikasi &amp; Detail</span>
              <span aria-hidden="true" class="group-hover:translate-x-1 transition-transform">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="p-12 text-center bg-surface-card rounded-lg border border-surface-border">
        <p class="text-ink-secondary text-sm">Dokumentasi proyek sedang diperbarui.</p>
      </div>
    )}
  </div>
</BaseLayout>
