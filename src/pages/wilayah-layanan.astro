---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema } from '../utils/seo';

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agrokomplekcemerlang.com/' },
  { name: 'Wilayah Layanan', url: 'https://agrokomplekcemerlang.com/wilayah-layanan/' },
]);
---

<BaseLayout
  title="Wilayah Layanan Greenhouse &amp; Ekspedisi Kargo Indonesia - Agrokomplek Cemerlang"
  description="Layanan pembuatan greenhouse &amp; pengiriman material konstruksi ke Jawa, Bali, Sumatera, Kalimantan, Sulawesi, hingga Papua via kargo darat &amp; laut terpercaya."
  jsonLd={[breadcrumbSchema]}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24">
    <Breadcrumb items={[{ label: 'Wilayah Layanan' }]} />

    <div class="my-10 text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200/60">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
        Jangkauan Logistik &amp; Kontraktor Nasional
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-900 tracking-tight">
        Layanan Pembuatan Greenhouse &amp; Pengiriman Material Seluruh Indonesia
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed">
        Berbasis di Kedungkandang, Kota Malang, kami membangun sistem pengiriman kargo dan instalasi proyek terstruktur agar petani dan pelaku agribisnis di seluruh nusantara dapat mengakses material pertanian berkualitas dan konstruksi greenhouse terstandar.
      </p>
    </div>

    <!-- 3 Key Delivery Mechanisms -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 my-12">
      <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-lg border border-emerald-100">
            🚚
          </div>
          <h3 class="text-xl font-bold text-zinc-900">Area Malang Raya &amp; Jatim</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Pengiriman langsung via armada operasional kami, ojek online kargo, atau ambil sendiri di gudang Kedungkandang. Layanan same-day / next-day dispatch untuk material greenhouse ready stock.
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 text-xs font-semibold text-emerald-700">
          Malang, Batu, Pasuruan, Blitar, Kediri, Surabaya &amp; sekitarnya
        </div>
      </div>

      <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-lg border border-emerald-100">
            🚛
          </div>
          <h3 class="text-xl font-bold text-zinc-900">Pulau Jawa, Madura &amp; Bali</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Didukung kemitraan ekspedisi kargo truk reguler (Indah Kargo, Baraka, Dakota, Kobra, Truk Balen). Biaya per kilogram sangat hemat untuk gulungan plastik UV, roll paranet, dan mulsa.
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 text-xs font-semibold text-emerald-700">
          Jawa Tengah, Jawa Barat, DIY Yogyakarta, Jabodetabek, Banten &amp; Bali
        </div>
      </div>

      <div class="p-7 sm:p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm hover:shadow-md transition-all flex flex-col justify-between space-y-4">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-lg border border-emerald-100">
            🚢
          </div>
          <h3 class="text-xl font-bold text-zinc-900">Luar Pulau (Kargo Laut &amp; Kontainer)</h3>
          <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
            Pengiriman via pelabuhan Tanjung Perak Surabaya menggunakan kapal kargo atau kontainer LCL/FCL. Packing ekstra rapi dengan proteksi berlapis tahan guncangan laut.
          </p>
        </div>
        <div class="pt-3 border-t border-zinc-100 text-xs font-semibold text-emerald-700">
          Sumatera, Kalimantan, Sulawesi, NTB, NTT, Maluku &amp; Papua
        </div>
      </div>
    </div>

    <!-- CTA Box -->
    <div class="p-8 sm:p-12 rounded-3xl bg-zinc-900 text-white border border-zinc-800 text-center space-y-4 shadow-xl">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-950/80 text-emerald-300 border border-emerald-700/50">
        Konsultasi Ekspedisi &amp; Ongkir
      </span>
      <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Ingin Mengetahui Jadwal &amp; Estimasi Ongkir ke Wilayah Anda?</h3>
      <p class="text-xs sm:text-sm text-zinc-300 max-w-xl mx-auto leading-relaxed">
        Kirimkan alamat kecamatan dan kabupaten Anda ke WhatsApp kami untuk pengecekan rute armada ekspedisi paling hemat dan aman.
      </p>
      <div class="pt-2">
        <a
          href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20cek%20estimasi%20ongkir%20kargo%20ke%20daerah%20saya."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-all shadow-lg hover:shadow-emerald-900/50 select-none"
        >
          <svg class="w-4 h-4 text-emerald-200" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Cek Ongkir Kargo via WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
