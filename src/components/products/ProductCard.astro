---
export interface Props {
  product?: {
    title: string;
    description: string;
    category: string;
    priceDisplay?: string;
    stockStatus: string;
    thumbnail: string;
    slug: string;
    brand?: string;
  };
  title?: string;
  description?: string;
  category?: string;
  priceDisplay?: string;
  stockStatus?: string;
  thumbnail?: string;
  slug?: string;
  brand?: string;
}

const props = Astro.props;
const product = props.product || {
  title: props.title || '',
  description: props.description || '',
  category: props.category || '',
  priceDisplay: props.priceDisplay || '',
  stockStatus: props.stockStatus || 'ready',
  thumbnail: props.thumbnail || '',
  slug: props.slug || '',
  brand: props.brand || '',
};

const categoryLabels: Record<string, string> = {
  'perlengkapan-greenhouse': 'Greenhouse',
  'saprodi-pertanian': 'Saprodi',
  'perlengkapan-pertanian': 'Irigasi & Alat',
};

const displayCategory = categoryLabels[product.category] || product.category;
---

<div class="group relative flex flex-col justify-between rounded-xl bg-white border border-[#dedad0] hover:border-[#c8c3b7] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden font-sans">
  <div>
    <!-- Product Thumbnail with subtle neutral container -->
    <a href={`/produk/${product.slug}/`} class="block aspect-square bg-[#e4e5da]/40 overflow-hidden relative">
      <img
        src={product.thumbnail}
        alt={product.title}
        width="400"
        height="400"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
        decoding="async"
      />
      <!-- Stock Status Pill (Top Left Float) -->
      <div class="absolute top-2.5 left-2.5 z-10">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-white/95 backdrop-blur-xs text-[#1b2819] border border-[#dedad0] shadow-2xs">
          <span class:list={[
            "w-1.5 h-1.5 rounded-full",
            product.stockStatus === "ready" ? "bg-[#3f6239]" : product.stockStatus === "po" ? "bg-amber-500" : "bg-sky-500"
          ]}></span>
          <span>
            {product.stockStatus === "ready" ? "Ready" : product.stockStatus === "po" ? "Pre-Order" : "Konsultasi"}
          </span>
        </span>
      </div>
    </a>

    <!-- Details Container -->
    <div class="p-4 pb-2 space-y-1.5">
      <!-- Category & Brand Row -->
      <div class="flex items-center justify-between gap-2 text-[11px]">
        <span class="font-bold uppercase tracking-wider text-[#064e3b] text-[10px]">
          {displayCategory}
        </span>
        {product.brand && (
          <span class="text-zinc-400 font-medium truncate">
            {product.brand}
          </span>
        )}
      </div>

      <!-- Title -->
      <h3 class="font-semibold text-[#1b2819] text-sm leading-snug line-clamp-2 group-hover:text-[#064e3b] transition-colors min-h-[2.5rem]">
        <a href={`/produk/${product.slug}/`}>
          {product.title}
        </a>
      </h3>

      <!-- Feature Chip / Verifiable Quality Proof -->
      <div class="flex items-center gap-1.5 text-[11px] text-[#485245] pt-0.5">
        <svg class="w-3.5 h-3.5 text-[#064e3b] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <span class="truncate">Material Teruji Tropis &bull; Kargo RI</span>
      </div>
    </div>
  </div>

  <!-- Bottom Pricing & Action (Shopify Style) -->
  <div class="p-4 pt-3 border-t border-[#dedad0]/60 mt-1">
    <div class="flex items-center justify-between gap-2">
      <div class="flex flex-col">
        <span class="text-[10px] text-[#767e73] uppercase tracking-wider font-medium">
          {product.priceDisplay && product.priceDisplay.toLowerCase().includes('rp') ? 'Mulai Dari' : 'Info Biaya'}
        </span>
        <span class="font-bold text-[#1b2819] text-sm sm:text-base tracking-tight">
          {product.priceDisplay || "Konsultasi CS"}
        </span>
      </div>

      <a
        href={`/produk/${product.slug}/`}
        class="inline-flex items-center justify-center gap-1 py-1.5 px-3 rounded-lg bg-[#e4e5da] hover:bg-[#064e3b] text-[#1b2819] hover:text-[#edeae1] text-xs font-semibold transition-all duration-200"
      >
        <span>Detail</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>
