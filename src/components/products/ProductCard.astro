---
export interface Props {
  product: {
    title: string;
    description: string;
    category: string;
    priceDisplay?: string;
    stockStatus: string;
    thumbnail: string;
    slug: string;
    brand?: string;
  };
}

const { product } = Astro.props;
---

<div class="group relative flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden font-sans">
  <div>
    <!-- Pure Thumbnail Image - GAMBAR HANYA GAMBAR SAJA, TANPA TULISAN MENIMPA -->
    <a href={`/produk/${product.slug}/`} class="block aspect-square bg-secondary/30 overflow-hidden">
      <img
        src={product.thumbnail}
        alt={product.title}
        width="400"
        height="400"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
        decoding="async"
      />
    </a>

    <!-- Details Below Image -->
    <div class="p-4 sm:p-5 pb-2">
      <!-- Status & Category Row (Below Image) -->
      <div class="flex items-center justify-between gap-2 mb-2">
        <span class="inline-flex items-center gap-1.5 text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span>
            {product.stockStatus === "ready"
              ? "Ready Stock"
              : product.stockStatus === "po"
              ? "Pre-Order"
              : "Cek Stok"}
          </span>
        </span>

        <span class="text-[10px] font-bold uppercase tracking-wider text-muted">
          {product.category === "perlengkapan-greenhouse" ? "Greenhouse" : product.category === "saprodi-pertanian" ? "Saprodi" : "Irigasi"}
        </span>
      </div>

      {product.brand && (
        <span class="text-[10px] font-bold text-primary uppercase tracking-wider block mb-1">
          {product.brand}
        </span>
      )}

      <h3 class="font-bold text-dark text-sm leading-snug line-clamp-2 group-hover:text-primary transition-colors min-h-[2.5rem]">
        <a href={`/produk/${product.slug}/`}>
          {product.title}
        </a>
      </h3>

      <!-- Star Ratings & Review Proof -->
      <div class="flex items-center gap-1.5 text-xs text-amber-500 mt-2 select-none">
        <span class="tracking-tighter font-black">★★★★★</span>
        <span class="text-muted font-medium text-[11px]">(4.9 &bull; 40+ ulasan)</span>
      </div>
    </div>
  </div>

  <!-- Bottom Pricing & Action -->
  <div class="p-4 sm:p-5 pt-3 border-t border-border/70 mt-1">
    <div class="flex items-center justify-between gap-2">
      <div class="flex flex-col">
        <span class="text-[10px] text-muted font-medium">Harga Mulai</span>
        <span class="font-black text-dark text-sm sm:text-base tracking-tight">
          {product.priceDisplay || "Hubungi CS"}
        </span>
      </div>

      <a
        href={`/produk/${product.slug}/`}
        class="inline-flex items-center justify-center gap-1 py-2 px-3.5 rounded-xl bg-secondary hover:bg-primary text-dark hover:text-white text-xs font-bold transition-all duration-200 shadow-xs group/btn"
      >
        <span>Detail</span>
        <svg class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>
