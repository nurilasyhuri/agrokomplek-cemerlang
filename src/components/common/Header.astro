---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';
import { getCollection } from 'astro:content';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;
const waInquiryUrl = generateGeneralInquiryUrl('header-cta');

// Fetch content collections to build live client-side search index
const [products, articles, projects] = await Promise.all([
  getCollection('produk'),
  getCollection('artikel'),
  getCollection('proyek'),
]);

const searchItems = [
  // Core Services & Features
  {
    title: 'Jasa Pembuatan Greenhouse',
    desc: 'Layanan konstruksi greenhouse profesional: bambu awet, baja ringan, pipa galvanis, dan tunnel garam pesisir.',
    url: '/jasa/pembuatan-greenhouse/',
    category: 'Layanan',
    badge: 'Kontraktor',
    img: '/images/greenhouse/greenhouse-galvanis.webp',
  },
  {
    title: 'Kalkulator Estimasi Biaya RAB',
    desc: 'Simulasi perkiraan biaya pembuatan greenhouse per m2 secara otomatis, transparan, dan detail.',
    url: '/jasa/pembuatan-greenhouse/#kalkulator',
    category: 'Layanan',
    badge: 'Kalkulator',
    img: '/images/greenhouse/greenhouse-baja-ringan.webp',
  },
  {
    title: 'Wilayah Layanan & Ekspedisi Kargo',
    desc: 'Jangkauan instalasi dan pengiriman material siap kirim ke Jawa, Bali, dan luar pulau via kargo rekanan.',
    url: '/wilayah-layanan/',
    category: 'Layanan',
    badge: 'Logistik',
    img: '/images/wilayah/logistik-ekspedisi-greenhouse.webp',
  },
  {
    title: 'Workshop & Gudang Material Malang',
    desc: 'Kunjungi workshop dan cek sampel fisik pipa galvanis, plastik UV, dan paranet di Kedungkandang, Kota Malang.',
    url: '/lokasi/',
    category: 'Layanan',
    badge: 'Workshop',
    img: '/images/lokasi/gudang-material-greenhouse.webp',
  },
  {
    title: 'Tentang Agrokomplek Cemerlang',
    desc: 'Pusat saprodi pertanian, supplier material greenhouse, dan kontraktor paket rancang bangun siap tanam di Malang.',
    url: '/tentang-kami/',
    category: 'Layanan',
    badge: 'Profil',
    img: '/images/about/kontraktor-greenhouse-malang.webp',
  },
  {
    title: 'Kontak Tim & Konsultasi WhatsApp',
    desc: 'Konsultasi gambar kerja, denah kebun, spesifikasi material, dan survei lokasi langsung bersama tim teknis.',
    url: '/kontak/',
    category: 'Layanan',
    badge: 'Kontak',
    img: '/images/kontak/konsultasi-teknisi-greenhouse.webp',
  },
  // Products
  ...products.map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    url: `/produk/${p.slug}/`,
    category: 'Material',
    badge:
      p.data.category === 'perlengkapan-greenhouse'
        ? 'Greenhouse'
        : p.data.category === 'perlengkapan-pertanian'
          ? 'Irigasi'
          : 'Saprodi',
    price: p.data.priceDisplay || (p.data.price ? `Rp ${p.data.price.toLocaleString('id-ID')}` : undefined),
    img: p.data.thumbnail,
  })),
  // Projects
  ...projects.map((pr) => ({
    title: pr.data.title,
    desc: `${pr.data.greenhouseType} - Luas ${pr.data.dimensions} di ${pr.data.locationCity}, ${pr.data.locationProvince}.`,
    url: `/proyek/${pr.slug}/`,
    category: 'Proyek',
    badge: pr.data.greenhouseType,
    img: pr.data.coverImage,
  })),
  // Articles
  ...articles.map((a) => ({
    title: a.data.title,
    desc: a.data.description,
    url: `/artikel/${a.slug}/`,
    category: 'Panduan',
    badge: a.data.category || 'Panduan',
    img: a.data.heroImage,
  })),
];
---

<!-- Main Sticky Header (Shopify Clean Minimalist Style with Centered Logo) -->
<header
  id="main-header"
  data-home-header={isHomePage ? "true" : "false"}
  class:list={[
    "sticky top-0 z-40 transition-all duration-300 font-sans",
    isHomePage ? "is-at-top" : "is-scrolled"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Desktop Header: 3-Column Balanced Layout (Left Nav + Language, Center Logo, Right Search & Cart) -->
    <div class="hidden lg:grid grid-cols-[1fr_auto_1fr] items-center h-[76px] relative">
      
      <!-- Column 1 (Left): Navigation Links -->
      <div class="flex items-center justify-start h-full">
        <!-- Primary Navigation Links (HOME, KATALOG, ABOUT, CONTACT) -->
        <nav class="flex items-center gap-5 xl:gap-8 h-full">
          <!-- 1. HOME -->
          <a
            href="/"
            class:list={[
              'nav-link py-1 text-xs font-semibold tracking-widest uppercase transition-colors',
              currentPath === '/' ? 'nav-link-active' : 'nav-link-inactive'
            ]}
          >
            HOME
          </a>

          <!-- 2. KATALOG (Dropdown for Jasa Greenhouse & Produk) -->
          <div class="relative group h-full flex items-center">
            <button
              type="button"
              aria-haspopup="menu"
              class:list={[
                'nav-link flex items-center gap-1.5 py-1 text-xs font-semibold tracking-widest uppercase transition-colors cursor-pointer',
                currentPath.startsWith('/produk') || currentPath.startsWith('/jasa/')
                  ? 'nav-link-active'
                  : 'nav-link-inactive'
              ]}
            >
              <span>KATALOG</span>
              <svg class="w-3 h-3 chevron-icon transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <!-- Dropdown Menu Content -->
            <div class="invisible opacity-0 translate-y-1 scale-95 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-150 ease-out absolute top-full left-0 pt-1.5 z-50">
              <div class="w-80 overflow-hidden rounded-xl border border-zinc-200 bg-white p-1.5 text-zinc-950 shadow-xl shadow-zinc-950/15 select-none animate-in fade-in-0 zoom-in-95">
                
                <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Layanan &amp; Konstruksi
                </div>

                <a href="/jasa/pembuatan-greenhouse/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-emerald-50 hover:text-[#064e3b]">
                  <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-100 group-hover/item:text-[#065f46] flex items-center justify-center shrink-0 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-zinc-900 group-hover/item:text-[#065f46] transition-colors">Jasa Pembuatan Greenhouse</span>
                    <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Konstruksi galvanis, baja &amp; bambu siap tanam</span>
                  </div>
                </a>

                <div class="-mx-1 my-1 h-px bg-zinc-100"></div>

                <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                  Katalog Produk &amp; Material
                </div>

                <a href="/produk/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-emerald-50 hover:text-[#064e3b]">
                  <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-100 group-hover/item:text-[#065f46] flex items-center justify-center shrink-0 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-zinc-900 group-hover/item:text-[#065f46] transition-colors">Semua Katalog Produk</span>
                    <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Seluruh sarana &amp; perlengkapan</span>
                  </div>
                </a>

                <a href="/produk/perlengkapan-greenhouse/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-emerald-50 hover:text-[#064e3b]">
                  <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-100 group-hover/item:text-[#065f46] flex items-center justify-center shrink-0 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-zinc-900 group-hover/item:text-[#065f46] transition-colors">Perlengkapan Greenhouse</span>
                    <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Plastik UV, paranet, clip &amp; insect net</span>
                  </div>
                </a>

                <a href="/produk/perlengkapan-pertanian/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-emerald-50 hover:text-[#064e3b]">
                  <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-100 group-hover/item:text-[#065f46] flex items-center justify-center shrink-0 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-zinc-900 group-hover/item:text-[#065f46] transition-colors">Irigasi &amp; Perlengkapan Tani</span>
                    <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Selang drip, sprayer &amp; hidroponik</span>
                  </div>
                </a>

                <a href="/produk/saprodi-pertanian/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-emerald-50 hover:text-[#064e3b]">
                  <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-100 group-hover/item:text-[#065f46] flex items-center justify-center shrink-0 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                  </div>
                  <div class="flex flex-col">
                    <span class="font-semibold text-zinc-900 group-hover/item:text-[#065f46] transition-colors">Saprodi Pertanian</span>
                    <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Pupuk NPK, mulsa perak &amp; tray semai</span>
                  </div>
                </a>

              </div>
            </div>
          </div>

          <!-- 3. ABOUT -->
          <a
            href="/tentang-kami/"
            class:list={[
              'nav-link py-1 text-xs font-semibold tracking-widest uppercase transition-colors',
              currentPath.startsWith('/tentang-kami') || currentPath.startsWith('/lokasi')
                ? 'nav-link-active'
                : 'nav-link-inactive'
            ]}
          >
            ABOUT
          </a>

          <!-- 4. CONTACT -->
          <a
            href={isHomePage ? "#kontak" : "/kontak/"}
            class:list={[
              'nav-link py-1 text-xs font-semibold tracking-widest uppercase transition-colors',
              currentPath.startsWith('/kontak') ? 'nav-link-active' : 'nav-link-inactive'
            ]}
          >
            CONTACT
          </a>
        </nav>
      </div>

      <!-- Column 2 (Center): Brand Logo (Centered with Circle Emblem) -->
      <div class="flex items-center justify-center shrink-0 px-4">
        <a href="/" title="Agrokomplek Cemerlang" class="flex items-center gap-2.5 sm:gap-3 group select-none text-left">
          <!-- Refined Circle Emblem (Botanical & Architecture) -->
          <svg class="w-8 h-8 xl:w-9 xl:h-9 text-emerald-300 group-hover:text-white transition-colors shrink-0" viewBox="0 0 40 40" fill="none" stroke="currentColor">
            <circle cx="20" cy="20" r="18" stroke-width="1.75" />
            <path d="M20 9 C14 15, 12 22, 20 31 C28 22, 26 15, 20 9 Z" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M20 13 L20 27" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M20 19 C23 17, 25 18, 25 20" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M20 23 C17 21, 15 22, 15 24" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div class="flex flex-col leading-none">
            <span class="header-logo-text text-xs sm:text-sm xl:text-[15px] font-black tracking-[0.16em] uppercase text-white transition-colors">
              AGROKOMPLEK
            </span>
            <span class="header-logo-text text-xs sm:text-sm xl:text-[15px] font-black tracking-[0.22em] uppercase text-emerald-300 group-hover:text-white transition-colors mt-0.5">
              CEMERLANG
            </span>
            <span class="header-logo-sub text-[7.5px] font-semibold tracking-[0.22em] uppercase text-emerald-200/75 mt-1 transition-colors">
              PERTANIAN &amp; GREENHOUSE
            </span>
          </div>
        </a>
      </div>

      <!-- Column 3 (Right): Search Icon + Shopping Cart Icon + Language Switcher (ID / EN) -->
      <div class="flex items-center justify-end gap-3.5 xl:gap-5 h-full">
        <!-- Search Button (Spotlight Command Palette) -->
        <button
          id="search-trigger"
          type="button"
          aria-label="Cari greenhouse atau material (⌘K)"
          class="p-2 text-white/90 hover:text-white hover:bg-emerald-800/40 rounded-full transition-all cursor-pointer"
          title="Pencarian Cepat (⌘K)"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
        </button>

        <!-- Shopping Cart Icon with Circular Badge '0' -->
        <div class="relative flex items-center">
          <button
            id="cart-trigger"
            type="button"
            aria-label="Keranjang & Estimasi Pesanan"
            class="p-2 text-white/90 hover:text-white hover:bg-emerald-800/40 rounded-full transition-all cursor-pointer relative"
            title="Keranjang Belanja (0 item)"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span class="absolute top-0.5 right-0.5 w-4 h-4 rounded-full bg-emerald-400 text-[#064e3b] text-[10px] font-black flex items-center justify-center leading-none shadow-xs">
              0
            </span>
          </button>
        </div>

        <!-- Minimal Language Switcher (ID / EN) -->
        <div class="flex items-center text-xs tracking-widest font-semibold select-none shrink-0 pl-3.5 border-l border-emerald-700/60">
          <span class="text-white font-bold cursor-default">ID</span>
          <span class="mx-1.5 text-emerald-400/40 font-normal">/</span>
          <span class="text-emerald-300/60 hover:text-white transition-colors cursor-pointer" title="English version (coming soon)">EN</span>
        </div>
      </div>

    </div>

    <!-- Mobile Header Bar (lg:hidden) -->
    <div class="flex lg:hidden justify-between items-center h-[64px] relative">
      <!-- Mobile Left: Hamburger Button -->
      <div class="flex items-center">
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu Navigasi"
          class="p-2 -ml-2 text-white hover:text-emerald-200 transition-colors cursor-pointer"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Mobile Center: Brand Logo -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center">
        <a href="/" title="Agrokomplek Cemerlang" class="flex items-center gap-1.5 sm:gap-2 group">
          <svg class="w-5 h-5 text-emerald-300 shrink-0" viewBox="0 0 40 40" fill="none" stroke="currentColor">
            <circle cx="20" cy="20" r="18" stroke-width="1.75" />
            <path d="M20 9 C14 15, 12 22, 20 31 C28 22, 26 15, 20 9 Z" stroke-width="1.75" stroke-linejoin="round"/>
            <path d="M20 13 L20 27" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M20 19 C23 17, 25 18, 25 20" stroke-width="1.5" stroke-linecap="round"/>
            <path d="M20 23 C17 21, 15 22, 15 24" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <div class="flex flex-col text-left leading-none">
            <span class="text-[10.5px] sm:text-xs font-black tracking-[0.14em] uppercase text-white">
              AGROKOMPLEK
            </span>
            <span class="text-[10.5px] sm:text-xs font-black tracking-[0.18em] uppercase text-emerald-300 mt-0.5">
              CEMERLANG
            </span>
          </div>
        </a>
      </div>

      <!-- Mobile Right: Search & Cart + Language -->
      <div class="flex items-center gap-1 sm:gap-1.5">
        <button
          id="mobile-search-trigger"
          type="button"
          aria-label="Buka Pencarian"
          class="p-1.5 text-white hover:text-emerald-200 transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
        </button>

        <button
          id="mobile-cart-trigger"
          type="button"
          aria-label="Keranjang Belanja"
          class="p-1.5 text-white hover:text-emerald-200 transition-colors relative flex items-center justify-center cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
          </svg>
          <span class="absolute top-0 right-0 w-3.5 h-3.5 rounded-full bg-emerald-400 text-[#064e3b] text-[9px] font-black flex items-center justify-center leading-none">
            0
          </span>
        </button>

        <!-- Minimal Language Switcher (ID / EN) on Mobile Right -->
        <div class="flex items-center text-[10px] tracking-wider font-semibold select-none shrink-0 pl-1 border-l border-emerald-700/60 ml-0.5">
          <span class="text-white font-bold cursor-default">ID</span>
          <span class="mx-0.5 text-emerald-400/40 font-normal">/</span>
          <span class="text-emerald-300/60 hover:text-white transition-colors cursor-pointer" title="English version">EN</span>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Cart / Inquiry Slide-Over Drawer -->
<div
  id="cart-drawer-backdrop"
  class="fixed inset-0 bg-black/60 backdrop-blur-2xs z-50 hidden opacity-0 transition-opacity duration-200"
  aria-hidden="true"
></div>

<aside
  id="cart-drawer"
  class="fixed top-0 right-0 bottom-0 w-full sm:w-96 bg-white z-50 transform translate-x-full flex flex-col border-l border-zinc-200 transition-transform duration-300 overflow-hidden font-sans shadow-2xl hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Keranjang & Estimasi Pesanan"
>
  <!-- Drawer Header -->
  <div class="flex justify-between items-center px-5 py-4 border-b border-emerald-800 bg-[#064e3b] text-white">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
      <span class="font-bold text-xs tracking-widest uppercase">Keranjang Pesanan</span>
    </div>
    <button
      id="close-cart-btn"
      type="button"
      aria-label="Tutup keranjang"
      class="p-1.5 text-emerald-200 hover:text-white hover:bg-emerald-800/60 rounded-lg transition-colors cursor-pointer"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
        <path d="M18 6 6 18"></path>
        <path d="m6 6 12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Drawer Body -->
  <div class="flex-1 overflow-y-auto p-6 flex flex-col items-center justify-center text-center">
    <div class="w-16 h-16 rounded-full bg-emerald-50 text-[#064e3b] flex items-center justify-center mb-4">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
      </svg>
    </div>
    <h3 class="text-base font-bold text-zinc-900 mb-1">Keranjang Masih Kosong</h3>
    <p class="text-xs text-zinc-500 max-w-xs mb-6 leading-relaxed">
