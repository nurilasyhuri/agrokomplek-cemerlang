---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const currentPath = Astro.url.pathname;
const waInquiryUrl = generateGeneralInquiryUrl('header-cta');
---

<!-- Top Promotional Bar -->
<div class="bg-[#faf8f5] text-zinc-900 text-xs font-bold font-sans py-2 px-4 border-b border-[#eee8df] select-none">
  <div class="max-w-[1200px] mx-auto sm:px-6 lg:px-8 flex justify-between items-center text-[11px]">
    <!-- Left: Delivery & Service Highlights -->
    <div class="flex items-center gap-2.5 text-zinc-900 font-bold uppercase tracking-wider">
      <span class="inline-flex items-center gap-1.5 cursor-pointer select-none text-emerald-800">
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
          <path d="M15 18H9"></path>
          <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
          <circle cx="17" cy="18" r="2"></circle>
          <circle cx="7" cy="18" r="2"></circle>
        </svg>
        <span>KONTRAKTOR GREENHOUSE SE-INDONESIA</span>
      </span>
      <span class="text-zinc-300">•</span>
      <span class="hidden md:inline text-zinc-600 font-medium tracking-normal normal-case">
        Gratis Konsultasi Desain Struktur &amp; Estimasi RAB Greenhouse
      </span>
    </div>

    <!-- Right: Operational Hours & WhatsApp -->
    <div class="flex items-center gap-3 text-zinc-700 font-medium select-none">
      <span class="hidden sm:inline-flex items-center gap-1 text-zinc-500">
        <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{BUSINESS_INFO.hours.physicalStore}</span>
      </span>
      <span class="hidden sm:inline text-zinc-300">•</span>
      <a
        href={waInquiryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:text-emerald-700 transition-colors text-emerald-700 font-bold uppercase tracking-wider"
      >
        <span>WA KONSULTASI: {BUSINESS_INFO.contact.phone}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-border/80 transition-all duration-300 font-sans shadow-sm">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 relative">
      
      <!-- Mobile View Left: Hamburger Menu Button -->
      <div class="flex items-center lg:hidden z-10">
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu Navigasi"
          class="px-2.5 py-2 -ml-1 text-dark bg-secondary/50 hover:bg-secondary hover:text-primary active:scale-[0.96] transition-all duration-200 cursor-pointer rounded-xl flex items-center gap-1.5 font-sans text-xs font-bold uppercase border border-border/50"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <span class="font-extrabold tracking-wider">Menu</span>
        </button>
      </div>

      <!-- Mobile View Center: Logo -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:hidden z-10 text-center">
        <a href="/" title="Agrokomplek Cemerlang Beranda" class="flex flex-col items-center">
          <span class="text-xl sm:text-2xl font-black tracking-tighter text-dark leading-none uppercase">
            AGROKOMPLEK<span class="text-primary">.</span>
          </span>
          <span class="text-[9px] font-bold tracking-[0.2em] text-muted uppercase leading-none mt-0.5">
            KONTRAKTOR GREENHOUSE
          </span>
        </a>
      </div>

      <!-- Mobile View Right: Quick Search & WhatsApp CTA -->
      <div class="flex items-center gap-1.5 lg:hidden z-10">
        <button
          id="mobile-search-trigger"
          type="button"
          aria-label="Buka Pencarian"
          class="p-2 text-dark hover:text-primary bg-secondary/50 hover:bg-secondary rounded-xl transition-colors border border-border/50 cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.34-4.34"></path>
          </svg>
        </button>
        <a
          href={waInquiryUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Konsultasi WhatsApp"
          class="p-2 text-white bg-emerald-600 hover:bg-emerald-500 rounded-xl transition-colors shadow-sm active:scale-95"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
        </a>
      </div>

      <!-- Desktop View Left: Brand Logo -->
      <div class="hidden lg:flex flex-shrink-0 items-center">
        <a href="/" title="Agrokomplek Cemerlang Beranda" class="flex flex-col group">
          <span class="text-2xl xl:text-3xl font-black tracking-tighter text-dark group-hover:text-primary transition-colors leading-none uppercase">
            AGROKOMPLEK<span class="text-primary">.</span>
          </span>
          <span class="text-[10px] font-bold tracking-[0.25em] text-muted uppercase leading-none mt-1">
            KONTRAKTOR JASA GREENHOUSE
          </span>
        </a>
      </div>

      <!-- Desktop View Center: Navigation Links -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-7 h-full">
        
        <!-- 1. Beranda -->
        <a
          href="/"
          class:list={[
            'transition-colors duration-200 font-sans font-bold text-sm hover:text-primary flex items-center h-full',
            currentPath === '/' ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
          ]}
        >
          Beranda
        </a>

        <!-- 2. Model Greenhouse (Mega Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary h-full',
              currentPath.startsWith('/jasa/') || currentPath.startsWith('/produk') ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
            ]}
          >
            <span>Model Greenhouse</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <!-- Dropdown Mega Panel -->
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full left-1/2 -translate-x-[35%] pt-3 z-50">
            <div class="w-[860px] bg-white border border-border rounded-3xl shadow-card p-6 flex flex-col gap-5 text-left select-none">
              <div class="grid grid-cols-4 gap-6">
                <!-- Col 1: Struktur Greenhouse -->
                <div class="flex flex-col">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 flex items-center justify-between">
                    <span>Tipe Struktur</span>
                    <span>🏗️</span>
                  </span>
                  <div class="flex flex-col gap-1">
                    <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🏛️</span>
                      <span class="flex-1 truncate">Greenhouse Galvanis</span>
                    </a>
                    <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🏢</span>
                      <span class="flex-1 truncate">Greenhouse Baja Ringan</span>
                    </a>
                    <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🎋</span>
                      <span class="flex-1 truncate">Greenhouse Bambu Awet</span>
                    </a>
                    <a href="/proyek/tunnel-garam-pesisir-madura/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🧂</span>
                      <span class="flex-1 truncate">Tunnel Prisma Garam</span>
                    </a>
                  </div>
                </div>

                <!-- Col 2: Sistem & Instalasi -->
                <div class="flex flex-col">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 flex items-center justify-between">
                    <span>Sistem &amp; Instalasi</span>
                    <span>💧</span>
                  </span>
                  <div class="flex flex-col gap-1">
                    <a href="/produk/selang-drip-irigasi-16mm/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">💧</span>
                      <span class="flex-1 truncate">Irigasi Tetes Presisi</span>
                    </a>
                    <a href="/produk/paket-instalasi-hidroponik/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🥬</span>
                      <span class="flex-1 truncate">Hidroponik NFT Komersial</span>
                    </a>
                    <a href="/produk/spring-clip-profil-lock/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🔒</span>
                      <span class="flex-1 truncate">Kuncian Profil Spring Clip</span>
                    </a>
                    <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">⚙️</span>
                      <span class="flex-1 truncate">Otomasi Iklim Mikro</span>
                    </a>
                  </div>
                </div>

                <!-- Col 3: Material Konstruksi Teruji -->
                <div class="flex flex-col">
                  <span class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 flex items-center justify-between">
                    <span>Material Proteksi</span>
                    <span>🛡️</span>
                  </span>
                  <div class="flex flex-col gap-1">
                    <a href="/produk/plastik-uv-greenhouse-14/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">☀️</span>
                      <span class="flex-1 truncate">Plastik UV 200 Mikron</span>
                    </a>
                    <a href="/produk/paranet-tanaman/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🌿</span>
                      <span class="flex-1 truncate">Paranet Peneduh 65-75%</span>
                    </a>
                    <a href="/produk/insectnet-kasa-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🛡️</span>
                      <span class="flex-1 truncate">Insect Net Anti Kutu</span>
                    </a>
                    <a href="/produk/mulsa-plastik-hitam-perak/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">⚫</span>
                      <span class="flex-1 truncate">Mulsa Bedengan MPHP</span>
                    </a>
                  </div>
                </div>

                <!-- Col 4: Featured RAB Calculator Card -->
                <div class="bg-gradient-to-br from-peach via-peach/40 to-secondary border border-border/80 p-5 rounded-2xl flex flex-col justify-between h-full min-h-[200px]">
                  <div>
                    <span class="bg-primary text-white text-[9px] font-extrabold tracking-wider px-2.5 py-1 rounded-full uppercase select-none">
                      SIMULASI ONLINE
                    </span>
                    <h4 class="font-sans font-extrabold text-dark text-sm mt-3.5">
                      Kalkulator RAB Greenhouse
                    </h4>
                    <p class="text-xs text-muted leading-relaxed mt-1.5 font-medium">
                      Dapatkan estimasi biaya pembuatan struktur per m² sesuai luas lahan dan tipe rangka.
                    </p>
                  </div>
                  <a
                    href="/jasa/pembuatan-greenhouse/#kalkulator"
                    class="flex items-center gap-2 text-xs font-bold text-primary hover:text-primary-hover group/btn mt-4"
                  >
                    <span>Hitung RAB Sekarang</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Bottom Bar: Jasa Pembuatan Link -->
              <a
                href="/jasa/pembuatan-greenhouse/"
                class="flex items-center justify-between p-3 rounded-2xl bg-secondary/60 hover:bg-secondary text-dark text-xs font-bold transition-colors border border-border/50"
              >
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
                  <span>Konsultasikan Kebutuhan Proyek Greenhouse Skala Kebun &amp; Agribisnis</span>
                </div>
                <span class="text-primary font-extrabold flex items-center gap-1">
                  <span>Lihat Spesifikasi &amp; Layanan Lengkap</span>
                  <span>&rarr;</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Layanan Konstruksi (Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary h-full',
              currentPath.startsWith('/jasa/') || currentPath.startsWith('/wilayah-layanan') ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
            ]}
          >
            <span>Layanan Konstruksi</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full left-0 pt-3 z-50">
            <div class="w-80 bg-white border border-border rounded-3xl shadow-card p-3 flex flex-col gap-1 text-left select-none">
              <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🏗️</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Jasa Pembuatan Greenhouse</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Rancang bangun galvanis, bambu, baja ringan, &amp; tunnel garam.</span>
                </div>
              </a>
              <a href="/jasa/pembuatan-greenhouse/#kalkulator" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🧮</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Kalkulator Estimasi RAB</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Simulasi kebutuhan biaya material &amp; jasa per m² online.</span>
                </div>
              </a>
              <a href="/wilayah-layanan/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all border-t border-border/60 mt-1 pt-3">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🚚</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Wilayah Layanan &amp; Tim Ekspedisi</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Pengiriman material &amp; instalasi proyek se-Indonesia.</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- 4. Portofolio Proyek (Direct Link) -->
        <a
          href="/proyek/"
          class:list={[
            'transition-colors duration-200 font-sans font-bold text-sm hover:text-primary flex items-center h-full',
            currentPath.startsWith('/proyek') ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
          ]}
        >
          Portofolio Proyek
        </a>

        <!-- 5. Panduan & Biaya (Direct Link) -->
        <a
          href="/artikel/"
          class:list={[
            'transition-colors duration-200 font-sans font-bold text-sm hover:text-primary flex items-center h-full',
            currentPath.startsWith('/artikel') ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
          ]}
        >
          Panduan &amp; Biaya
        </a>

        <!-- 6. Tentang Kontraktor (Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary h-full',
              currentPath.startsWith('/tentang-kami') || currentPath.startsWith('/lokasi') || currentPath.startsWith('/kontak') ? 'text-primary font-extrabold border-b-2 border-primary -mb-[2px]' : 'text-dark',
            ]}
          >
            <span>Tentang Kami</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full right-0 pt-3 z-50">
            <div class="w-72 bg-white border border-border rounded-3xl shadow-card p-3 flex flex-col gap-1 text-left select-none">
              <a href="/tentang-kami/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🏢</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Profil Kontraktor</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Pengalaman tim &amp; standar konstruksi greenhouse.</span>
                </div>
              </a>
              <a href="/lokasi/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">📍</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Kantor &amp; Workshop Malang</span>
