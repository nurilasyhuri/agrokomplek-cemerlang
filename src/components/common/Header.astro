<script>
  function initHeaderInteractive() {
    const mainHeader = document.getElementById('main-header');

    // Homepage Dynamic Scroll Transition
    if (mainHeader && mainHeader.getAttribute('data-home-header') === 'true') {
      const handleScroll = () => {
        if (window.scrollY > 24) {
          mainHeader.classList.remove('is-at-top');
          mainHeader.classList.add('is-scrolled');
        } else {
          mainHeader.classList.add('is-at-top');
          mainHeader.classList.remove('is-scrolled');
        }
      };

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();
    }

    // Mobile Drawer Elements
    const menuBtn = document.getElementById('menu-btn');
    const mobileDrawer = document.getElementById('mobile-drawer');
    const drawerBackdrop = document.getElementById('mobile-drawer-backdrop');
    const closeMenuBtn = document.getElementById('close-menu-btn');

    function openMobileMenu() {
      if (!mobileDrawer || !drawerBackdrop) return;
      drawerBackdrop.classList.remove('hidden');
      setTimeout(() => {
        drawerBackdrop.classList.remove('opacity-0');
        drawerBackdrop.classList.add('opacity-100');
        mobileDrawer.classList.remove('translate-y-full');
        mobileDrawer.classList.add('translate-y-0');
      }, 10);
      document.body.classList.add('overflow-hidden');
    }

    function closeMobileMenu() {
      if (!mobileDrawer || !drawerBackdrop) return;
      mobileDrawer.classList.remove('translate-y-0');
      mobileDrawer.classList.add('translate-y-full');
      drawerBackdrop.classList.remove('opacity-100');
      drawerBackdrop.classList.add('opacity-0');
      setTimeout(() => {
        drawerBackdrop.classList.add('hidden');
      }, 300);
      document.body.classList.remove('overflow-hidden');
    }

    menuBtn?.addEventListener('click', openMobileMenu);
    closeMenuBtn?.addEventListener('click', closeMobileMenu);
    drawerBackdrop?.addEventListener('click', closeMobileMenu);

    // Search Modal Elements & State
    const desktopSearchTrigger = document.getElementById('search-trigger');
    const mobileSearchTrigger = document.getElementById('mobile-search-trigger');
    const drawerSearchTrigger = document.getElementById('drawer-search-trigger');
    const searchOverlay = document.getElementById('search-overlay');
    const searchBox = document.getElementById('search-box');
    const closeSearchBtn = document.getElementById('close-search-btn');
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const searchClearBtn = document.getElementById('search-clear-btn');
    const searchDefaultState = document.getElementById('search-default-state');
    const searchResultsWrapper = document.getElementById('search-results-wrapper');
    const searchResultsList = document.getElementById('search-results-list');
    const searchNoResults = document.getElementById('search-no-results');
    const searchNoResultsQuery = document.getElementById('search-no-results-query');
    const searchCountLabel = document.getElementById('search-count-label');
    const tabPills = document.querySelectorAll<HTMLButtonElement>('.search-tab-pill');
    const keywordTags = document.querySelectorAll<HTMLButtonElement>('.search-keyword-tag');

    interface SearchItem {
      title: string;
      desc: string;
      url: string;
      category: string;
      badge: string;
      price?: string;
      img: string;
    }

    let searchItems: SearchItem[] = [];
    try {
      const raw = document.getElementById('search-index-json')?.textContent;
      if (raw) searchItems = JSON.parse(raw);
    } catch {
      searchItems = [];
    }

    let activeCategory = 'all';
    let currentResults: SearchItem[] = [];
    let activeResultIndex = -1;

    function escapeHtml(str: string): string {
      return str
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function escapeRegExp(str: string): string {
      return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function highlightMatch(text: string, query: string): string {
      if (!query.trim()) return escapeHtml(text);
      const terms = query.trim().split(/\s+/).filter(Boolean);
      if (terms.length === 0) return escapeHtml(text);
      try {
        const regex = new RegExp(`(${terms.map(escapeRegExp).join('|')})`, 'gi');
        return escapeHtml(text).replace(regex, '<mark class="bg-emerald-100 text-emerald-950 px-0.5 rounded font-bold">$1</mark>');
      } catch {
        return escapeHtml(text);
      }
    }

    function getBadgeClass(category: string): string {
      switch (category) {
        case 'Layanan':
          return 'bg-emerald-50 text-emerald-800 border border-emerald-200/80';
        case 'Material':
          return 'bg-amber-50 text-amber-900 border border-amber-200/80';
        case 'Proyek':
          return 'bg-blue-50 text-blue-800 border border-blue-200/80';
        case 'Panduan':
          return 'bg-indigo-50 text-indigo-800 border border-indigo-200/80';
        default:
          return 'bg-zinc-100 text-zinc-700 border border-zinc-200/80';
      }
    }

    function updateActiveItemVisual() {
      const items = searchResultsList?.querySelectorAll<HTMLElement>('.search-result-item');
      if (!items) return;
      items.forEach((el, i) => {
        if (i === activeResultIndex) {
          el.classList.add('bg-emerald-50/80', 'border-emerald-300', 'ring-1', 'ring-emerald-300', 'shadow-2xs');
          el.classList.remove('bg-white', 'border-zinc-100');
          el.setAttribute('aria-selected', 'true');
          el.scrollIntoView({ block: 'nearest' });
        } else {
          el.classList.remove('bg-emerald-50/80', 'border-emerald-300', 'ring-1', 'ring-emerald-300', 'shadow-2xs');
          el.classList.add('bg-white', 'border-zinc-100');
          el.setAttribute('aria-selected', 'false');
        }
      });
    }

    function renderSearchResults(query: string) {
      const trimmed = query.trim().toLowerCase();
      const terms = trimmed ? trimmed.split(/\s+/).filter(Boolean) : [];

      let filtered = searchItems;
      if (activeCategory !== 'all') {
        filtered = filtered.filter((item) => item.category === activeCategory);
      }

      if (terms.length > 0) {
        filtered = filtered.filter((item) => {
          const haystack = `${item.title} ${item.desc} ${item.badge} ${item.category}`.toLowerCase();
          return terms.every((term) => haystack.includes(term));
        });
      }

      currentResults = filtered;
      activeResultIndex = currentResults.length > 0 ? 0 : -1;

      if (!trimmed && activeCategory === 'all') {
        searchClearBtn?.classList.add('hidden');
        searchDefaultState?.classList.remove('hidden');
        searchResultsWrapper?.classList.add('hidden');
        searchNoResults?.classList.add('hidden');
        return;
      }

      searchDefaultState?.classList.add('hidden');
      if (trimmed) {
        searchClearBtn?.classList.remove('hidden');
      } else {
        searchClearBtn?.classList.add('hidden');
      }

      if (currentResults.length === 0) {
        searchResultsWrapper?.classList.add('hidden');
        searchNoResults?.classList.remove('hidden');
        if (searchNoResultsQuery) {
          searchNoResultsQuery.textContent = trimmed
            ? `Tidak ditemukan hasil untuk "${query}". Coba kata kunci lain seperti galvanis, bambu, paranet, uv, atau Malang.`
            : 'Tidak ada item dalam kategori ini.';
        }
      } else {
        searchNoResults?.classList.add('hidden');
        searchResultsWrapper?.classList.remove('hidden');
        if (searchCountLabel) {
          searchCountLabel.textContent = `Ditemukan ${currentResults.length} hasil${trimmed ? ` untuk "${query}"` : ''}`;
        }

        if (searchResultsList) {
          searchResultsList.innerHTML = currentResults
            .map((item, index) => {
              const isSelected = index === activeResultIndex;
              const badgeClass = getBadgeClass(item.category);
              return `
                <a
                  href="${item.url}"
                  role="option"
                  aria-selected="${isSelected}"
                  data-index="${index}"
                  class="search-result-item flex items-center gap-3 p-2.5 sm:p-3 rounded-xl border transition-all duration-150 cursor-pointer ${
                    isSelected
                      ? 'bg-emerald-50/80 border-emerald-300 ring-1 ring-emerald-300 shadow-2xs'
                      : 'bg-white border-zinc-100 hover:border-zinc-200 hover:bg-zinc-50'
                  }"
                >
                  <img
                    src="${item.img}"
                    alt="${escapeHtml(item.title)}"
                    class="w-11 h-11 sm:w-12 sm:h-12 rounded-lg object-cover bg-zinc-100 border border-zinc-200/60 shrink-0"
                    loading="lazy"
                    onerror="this.style.opacity='0.3'"
                  />
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 flex-wrap mb-0.5">
                      <span class="text-[9px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full ${badgeClass}">
                        ${escapeHtml(item.badge)}
                      </span>
                      ${item.price ? `<span class="text-xs font-bold text-emerald-800">${escapeHtml(item.price)}</span>` : ''}
                    </div>
                    <h4 class="text-xs sm:text-sm font-bold text-zinc-900 truncate">
                      ${highlightMatch(item.title, query)}
                    </h4>
                    <p class="text-[11px] text-zinc-500 line-clamp-1 mt-0.5">
                      ${escapeHtml(item.desc)}
                    </p>
                  </div>
                  <div class="shrink-0 text-zinc-300 pr-1">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                      <path d="M9 18l6-6-6-6"></path>
                    </svg>
                  </div>
                </a>
              `;
            })
            .join('');

          searchResultsList.querySelectorAll('.search-result-item').forEach((el) => {
            el.addEventListener('mouseenter', () => {
              const idx = Number(el.getAttribute('data-index'));
              if (!isNaN(idx)) {
                activeResultIndex = idx;
                updateActiveItemVisual();
              }
            });
          });
        }
      }
    }

    // Category Tabs click
    tabPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        tabPills.forEach((p) => {
          p.classList.remove('bg-emerald-100', 'text-emerald-800', 'font-semibold');
          p.classList.add('text-zinc-600', 'font-medium');
        });
        pill.classList.remove('text-zinc-600', 'font-medium');
        pill.classList.add('bg-emerald-100', 'text-emerald-800', 'font-semibold');
        activeCategory = pill.getAttribute('data-category') || 'all';
        renderSearchResults(searchInput?.value || '');
      });
    });

    // Popular Keyword Tags click
    keywordTags.forEach((tag) => {
      tag.addEventListener('click', () => {
        const q = tag.getAttribute('data-query') || '';
        if (searchInput) {
          searchInput.value = q;
          searchInput.focus();
          renderSearchResults(q);
        }
      });
    });

    // Clear Button click
    searchClearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchInput.focus();
        renderSearchResults('');
      }
    });

    // Realtime Input listener
    searchInput?.addEventListener('input', () => {
      renderSearchResults(searchInput.value);
    });

    // Keyboard navigation (ArrowDown, ArrowUp, Enter)
    searchInput?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeResultIndex = (activeResultIndex + 1) % currentResults.length;
          updateActiveItemVisual();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResults.length > 0) {
          activeResultIndex = (activeResultIndex - 1 + currentResults.length) % currentResults.length;
          updateActiveItemVisual();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeResultIndex >= 0 && activeResultIndex < currentResults.length) {
          window.location.href = currentResults[activeResultIndex].url;
        } else if (currentResults.length > 0) {
          window.location.href = currentResults[0].url;
        } else if (searchInput.value.trim()) {
          window.location.href = `/produk/?q=${encodeURIComponent(searchInput.value.trim())}`;
        }
      }
    });

    function openSearch() {
      if (!searchOverlay || !searchBox) return;
      closeMobileMenu();
      searchOverlay.classList.remove('hidden');
      setTimeout(() => {
        searchOverlay.classList.remove('opacity-0');
        searchOverlay.classList.add('opacity-100');
        searchBox.classList.remove('-translate-y-4', 'opacity-0');
        searchBox.classList.add('translate-y-0', 'opacity-100');
        searchInput?.focus();
        renderSearchResults(searchInput?.value || '');
      }, 10);
      document.body.classList.add('overflow-hidden');
    }

    function closeSearch() {
      if (!searchOverlay || !searchBox) return;
      searchBox.classList.remove('translate-y-0', 'opacity-100');
      searchBox.classList.add('-translate-y-4', 'opacity-0');
      searchOverlay.classList.remove('opacity-100');
      searchOverlay.classList.add('opacity-0');
      setTimeout(() => {
        searchOverlay.classList.add('hidden');
      }, 200);
      document.body.classList.remove('overflow-hidden');
    }

    desktopSearchTrigger?.addEventListener('click', openSearch);
    mobileSearchTrigger?.addEventListener('click', openSearch);
    drawerSearchTrigger?.addEventListener('click', openSearch);
    closeSearchBtn?.addEventListener('click', closeSearch);

    searchOverlay?.addEventListener('click', (e) => {
      if (e.target === searchOverlay) {
        closeSearch();
      }
    });

    // Keyboard Shortcuts: '/' or 'Cmd+K' to open search, 'Escape' to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearch();
        closeMobileMenu();
      } else if (
        (e.key === '/' || (e.key === 'k' && (e.metaKey || e.ctrlKey))) &&
        !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)
      ) {
        e.preventDefault();
        openSearch();
      }
    });
  }

  // Support Astro view transitions or direct DOM load
  document.addEventListener('DOMContentLoaded', initHeaderInteractive);
</script>
