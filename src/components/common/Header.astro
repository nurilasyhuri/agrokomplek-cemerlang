---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const currentPath = Astro.url.pathname;
const waInquiryUrl = generateGeneralInquiryUrl('header-cta');
---

<!-- Top Promotional Bar -->
<div class="bg-[#faf8f5] text-zinc-900 text-xs font-bold font-sans py-2.5 px-4 border-b border-[#eee8df] select-none">
  <div class="max-w-[1200px] mx-auto sm:px-6 lg:px-8 flex justify-between items-center">
    <!-- Left: Delivery & Service Highlights -->
    <div class="flex items-center gap-3 text-zinc-900 font-bold text-[11px] uppercase tracking-wider">
      <span class="inline-flex items-center gap-1.5 cursor-pointer select-none">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-zinc-800">
          <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
          <path d="M15 18H9"></path>
          <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
          <circle cx="17" cy="18" r="2"></circle>
          <circle cx="7" cy="18" r="2"></circle>
        </svg>
        <span>PENGIRIMAN KARGO SELURUH INDONESIA</span>
      </span>
      <span class="text-zinc-300">•</span>
      <span class="hidden md:inline text-zinc-700 font-bold tracking-normal normal-case text-xs">
        Gratis Konsultasi Teknis &amp; Estimasi RAB Greenhouse
      </span>
    </div>

    <!-- Right: Language/Currency & WhatsApp -->
    <div class="flex items-center gap-3 text-zinc-800 font-bold select-none text-[11px] tracking-wider uppercase">
      <span class="inline-flex items-center gap-1 cursor-pointer hover:text-primary transition-colors">
        <span>ID (IDR)</span>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></svg>
      </span>
      <span class="text-zinc-300">•</span>
      <a
        href={waInquiryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 hover:text-primary transition-colors text-primary font-bold"
      >
        <span>WA: {BUSINESS_INFO.contact.phone}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white border-b border-border/60 transition-all duration-300 font-sans">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 relative">
      
      <!-- Mobile Menu Button (Left-aligned) -->
      <div class="flex items-center lg:hidden z-10">
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu"
          class="px-3 py-2 -ml-1 text-dark bg-transparent hover:bg-secondary/60 hover:text-primary active:scale-[0.97] transition-all duration-200 cursor-pointer rounded-xl flex items-center gap-1.5 font-sans text-xs font-bold uppercase"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="M4 5h16"></path>
            <path d="M4 12h16"></path>
            <path d="M4 19h16"></path>
          </svg>
          <span>Menu</span>
        </button>
      </div>

      <!-- Mobile Centered Logo (Absolute Center) -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:hidden z-10">
        <a href="/" title="Agrokomplek Cemerlang Home" class="flex items-center">
          <span class="text-xl sm:text-2xl font-black tracking-tighter text-dark leading-none uppercase">
            AGROKOMPLEK<span class="text-primary">.</span>
          </span>
        </a>
      </div>

      <!-- Desktop Logo -->
      <div class="hidden lg:flex flex-shrink-0 items-center">
        <a href="/" title="Agrokomplek Cemerlang Home" class="flex items-center group">
          <span class="text-3xl font-black tracking-tighter text-dark group-hover:text-primary transition-colors leading-none uppercase">
            AGROKOMPLEK<span class="text-primary">.</span>
          </span>
        </a>
      </div>

      <!-- Desktop Navigation Links (Clean 4-Cluster Grouping) -->
      <nav class="hidden lg:flex items-center gap-6 xl:gap-8 h-full">
        
        <!-- 1. Produk & Material (Mega Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary',
              currentPath.startsWith('/produk') ? 'text-primary' : 'text-dark',
            ]}
          >
            <span>Produk &amp; Material</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <!-- Dropdown Mega Panel -->
          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full left-1/2 -translate-x-[35%] pt-3 z-50">
            <div class="w-[840px] bg-white border border-border rounded-3xl shadow-card p-6 flex flex-col gap-5 text-left select-none">
              <div class="grid grid-cols-4 gap-6">
                <!-- Col 1: Saprodi & Nutrisi -->
                <div class="flex flex-col">
                  <a href="/produk/saprodi-pertanian/" class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 hover:text-primary-hover flex items-center justify-between">
                    <span>Saprodi Pertanian</span>
                    <span>&rarr;</span>
                  </a>
                  <div class="flex flex-col gap-1">
                    <a href="/produk/pupuk-npk-16-16-16/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🌱</span>
                      <span class="flex-1 truncate">Pupuk NPK 16-16-16</span>
                    </a>
                    <a href="/produk/tray-semai-128-lubang/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🪴</span>
                      <span class="flex-1 truncate">Tray Semai 128 Lubang</span>
                    </a>
                    <a href="/produk/saprodi-pertanian/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🧪</span>
                      <span class="flex-1 truncate">Semua Saprodi</span>
                    </a>
                  </div>
                </div>

                <!-- Col 2: Material Greenhouse -->
                <div class="flex flex-col">
                  <a href="/produk/perlengkapan-greenhouse/" class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 hover:text-primary-hover flex items-center justify-between">
                    <span>Material Greenhouse</span>
                    <span>&rarr;</span>
                  </a>
                  <div class="flex flex-col gap-1">
                    <a href="/produk/plastik-uv-greenhouse-14/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">☀️</span>
                      <span class="flex-1 truncate">Plastik UV 200 Mikron</span>
                    </a>
                    <a href="/produk/paranet-tanaman/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🌿</span>
                      <span class="flex-1 truncate">Paranet Peneduh 65-75%</span>
                    </a>
                    <a href="/produk/insectnet-kasa-greenhouse/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🛡️</span>
                      <span class="flex-1 truncate">Insect Net 50 Mesh</span>
                    </a>
                    <a href="/produk/spring-clip-profil-lock/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🔒</span>
                      <span class="flex-1 truncate">Spring Clip &amp; Kanal C</span>
                    </a>
                  </div>
                </div>

                <!-- Col 3: Irigasi & Mulsa -->
                <div class="flex flex-col">
                  <a href="/produk/perlengkapan-pertanian/" class="text-[11px] font-extrabold uppercase tracking-wider text-primary mb-3.5 border-b border-border/60 pb-1.5 hover:text-primary-hover flex items-center justify-between">
                    <span>Irigasi &amp; Mulsa</span>
                    <span>&rarr;</span>
                  </a>
                  <div class="flex flex-col gap-1">
                    <a href="/produk/selang-drip-irigasi-16mm/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">💧</span>
                      <span class="flex-1 truncate">Selang Drip 16mm</span>
                    </a>
                    <a href="/produk/mulsa-plastik-hitam-perak/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">⚫</span>
                      <span class="flex-1 truncate">Mulsa Plastik MPHP</span>
                    </a>
                    <a href="/produk/sprayer-elektrik-16-liter/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🔋</span>
                      <span class="flex-1 truncate">Sprayer Elektrik 16L</span>
                    </a>
                    <a href="/produk/paket-instalasi-hidroponik/" class="group/item flex items-center gap-2.5 px-2.5 py-1.5 rounded-xl text-[13px] font-bold text-dark hover:bg-secondary/60 hover:text-primary transition-all">
                      <span class="w-7 h-7 shrink-0 flex items-center justify-center rounded-lg border text-primary bg-secondary border-border group-hover/item:bg-white text-xs">🥬</span>
                      <span class="flex-1 truncate">Paket Hidroponik NFT</span>
                    </a>
                  </div>
                </div>

                <!-- Col 4: Featured Promo Card -->
                <div class="bg-gradient-to-br from-peach via-peach/40 to-secondary border border-border/80 p-5 rounded-2xl flex flex-col justify-between h-full min-h-[200px]">
                  <div>
                    <span class="bg-primary text-white text-[9px] font-extrabold tracking-wider px-2.5 py-1 rounded-full uppercase select-none">
                      KONTRAKTOR RESMI
                    </span>
                    <h4 class="font-sans font-extrabold text-dark text-sm mt-3.5">
                      Kalkulator RAB Greenhouse
                    </h4>
                    <p class="text-xs text-muted leading-relaxed mt-1.5 font-medium">
                      Hitung estimasi kebutuhan material &amp; jasa pembuatan per m² secara transparan.
                    </p>
                  </div>
                  <a
                    href="/jasa/pembuatan-greenhouse/#kalkulator"
                    class="flex items-center gap-2 text-xs font-bold text-primary hover:text-primary-hover group/btn mt-4"
                  >
                    <span>Hitung RAB Sekarang</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform group-hover/btn:translate-x-0.5">
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  </a>
                </div>
              </div>

              <!-- Bottom Bar: View All Products -->
              <a
                href="/produk/"
                class="flex items-center justify-between p-3 rounded-2xl bg-secondary/60 hover:bg-secondary text-dark text-xs font-bold transition-colors border border-border/50"
              >
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                  <span>Buka Semua Katalog Produk &amp; Material Pertanian</span>
                </div>
                <span class="text-primary font-extrabold flex items-center gap-1">
                  <span>Lihat Seluruh Produk (10+)</span>
                  <span>&rarr;</span>
                </span>
              </a>
            </div>
          </div>
        </div>

        <!-- 2. Layanan Greenhouse (Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary',
              currentPath.startsWith('/jasa/') || currentPath.startsWith('/proyek') || currentPath.startsWith('/wilayah-layanan') ? 'text-primary' : 'text-dark',
            ]}
          >
            <span>Layanan Greenhouse</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full left-0 pt-3 z-50">
            <div class="w-80 bg-white border border-border rounded-3xl shadow-card p-3 flex flex-col gap-1 text-left select-none">
              <a href="/jasa/pembuatan-greenhouse/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🏗️</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Jasa Pembuatan Greenhouse</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Rancang bangun galvanis, bambu, baja ringan, &amp; tunnel garam.</span>
                </div>
              </a>
              <a href="/jasa/pembuatan-greenhouse/#kalkulator" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🧮</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Kalkulator Estimasi RAB</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Simulasi kebutuhan biaya material &amp; jasa per m² online.</span>
                </div>
              </a>
              <a href="/proyek/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">📸</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Portofolio Proyek</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Dokumentasi hasil pengerjaan tim di berbagai daerah.</span>
                </div>
              </a>
              <a href="/wilayah-layanan/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all border-t border-border/60 mt-1 pt-3">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🚚</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Ekspedisi &amp; Wilayah Layanan</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Pengiriman material &amp; instalasi proyek se-Indonesia.</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- 3. Panduan & Blog (Direct Link) -->
        <a
          href="/artikel/"
          class:list={[
            'transition-colors duration-200 font-sans font-bold text-sm hover:text-primary',
            currentPath.startsWith('/artikel') ? 'text-primary' : 'text-dark',
          ]}
        >
          Panduan &amp; Blog
        </a>

        <!-- 4. Tentang Kami (Dropdown) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="true"
            class:list={[
              'flex items-center gap-1.5 transition-colors duration-200 font-sans font-bold text-sm cursor-pointer hover:text-primary',
              currentPath.startsWith('/tentang-kami') || currentPath.startsWith('/lokasi') || currentPath.startsWith('/kontak') ? 'text-primary' : 'text-dark',
            ]}
          >
            <span>Tentang Kami</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>

          <div class="invisible opacity-0 translate-y-1 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full right-0 pt-3 z-50">
            <div class="w-72 bg-white border border-border rounded-3xl shadow-card p-3 flex flex-col gap-1 text-left select-none">
              <a href="/tentang-kami/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">🏢</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Profil Perusahaan</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Filosofi kerja &amp; empat pilar solusi pertanian.</span>
                </div>
              </a>
              <a href="/lokasi/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">📍</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Toko &amp; Gudang Malang</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Alamat fisik, cek sampel produk, &amp; jam buka.</span>
                </div>
              </a>
              <a href="/kontak/" class="group/item flex items-start gap-3 p-3 rounded-2xl hover:bg-secondary/60 transition-all border-t border-border/60 mt-1 pt-3">
                <span class="w-8 h-8 shrink-0 flex items-center justify-center rounded-xl border text-primary bg-secondary border-border group-hover/item:bg-white text-sm">💬</span>
                <div>
                  <span class="font-bold text-sm text-dark group-hover/item:text-primary block transition-colors">Kontak Resmi &amp; CS</span>
                  <span class="text-xs text-muted leading-snug block mt-0.5">Konsultasi WhatsApp pemesanan &amp; survei.</span>
                </div>
              </a>
            </div>
          </div>
        </div>

        <!-- 5. Quick Highlight CTA: Kalkulator RAB Button -->
        <a
          href="/jasa/pembuatan-greenhouse/#kalkulator"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/80 text-xs font-extrabold transition-all hover:scale-[1.02] active:scale-[0.98] select-none shrink-0"
        >
          <span>🧮</span>
          <span>Hitung RAB</span>
        </a>

      </nav>

      <!-- User Icons (Search, WhatsApp Consult, Catalog / Inquiry) -->
      <div class="flex items-center space-x-1 sm:space-x-2 z-10">
        
        <!-- Search Trigger Button -->
        <button
          id="search-trigger"
          type="button"
          class="text-dark hover:text-primary bg-transparent hover:bg-secondary/60 p-2.5 lg:px-3.5 active:scale-[0.97] transition-all duration-200 cursor-pointer rounded-xl flex items-center justify-center gap-1.5 relative"
          aria-label="Buka Pencarian"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <path d="m21 21-4.34-4.34"></path>
            <circle cx="11" cy="11" r="8"></circle>
          </svg>
          <span class="hidden lg:inline text-sm font-bold">Search</span>
        </button>

        <!-- Direct WhatsApp Consultation Link -->
        <a
          href={waInquiryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:flex text-dark hover:text-primary bg-transparent hover:bg-secondary/60 p-2.5 lg:px-3.5 active:scale-[0.97] transition-all duration-200 rounded-xl items-center justify-center gap-1.5"
          aria-label="Konsultasi WhatsApp"
        >
          <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
