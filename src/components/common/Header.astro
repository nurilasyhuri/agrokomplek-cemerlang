---
import { BUSINESS_INFO } from '../../data/businessInfo';
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';
import { getCollection } from 'astro:content';

export interface Props {
  isHomePage?: boolean;
}

const currentPath = Astro.url.pathname;
const { isHomePage = currentPath === '/' || currentPath === '' } = Astro.props;
const waInquiryUrl = generateGeneralInquiryUrl('header-cta');

// Fetch content collections to build live client-side search index
const [products, articles, projects] = await Promise.all([
  getCollection('produk'),
  getCollection('artikel'),
  getCollection('proyek'),
]);

const searchItems = [
  // Core Services & Features
  {
    title: 'Jasa Pembuatan Greenhouse',
    desc: 'Layanan konstruksi greenhouse profesional: bambu awet, baja ringan, pipa galvanis, dan tunnel garam pesisir.',
    url: '/jasa/pembuatan-greenhouse/',
    category: 'Layanan',
    badge: 'Kontraktor',
    img: '/images/greenhouse/greenhouse-galvanis.webp',
  },
  {
    title: 'Kalkulator Estimasi Biaya RAB',
    desc: 'Simulasi perkiraan biaya pembuatan greenhouse per m2 secara otomatis, transparan, dan detail.',
    url: '/jasa/pembuatan-greenhouse/#kalkulator',
    category: 'Layanan',
    badge: 'Kalkulator',
    img: '/images/greenhouse/greenhouse-baja-ringan.webp',
  },
  {
    title: 'Wilayah Layanan & Ekspedisi Kargo',
    desc: 'Jangkauan instalasi dan pengiriman material siap kirim ke Jawa, Bali, dan luar pulau via kargo rekanan.',
    url: '/wilayah-layanan/',
    category: 'Layanan',
    badge: 'Logistik',
    img: '/images/wilayah/logistik-ekspedisi-greenhouse.webp',
  },
  {
    title: 'Workshop & Gudang Material Malang',
    desc: 'Kunjungi workshop dan cek sampel fisik pipa galvanis, plastik UV, dan paranet di Kedungkandang, Kota Malang.',
    url: '/lokasi/',
    category: 'Layanan',
    badge: 'Workshop',
    img: '/images/lokasi/gudang-material-greenhouse.webp',
  },
  {
    title: 'Tentang Kontraktor Agro Prima',
    desc: 'Profil kontraktor dan spesialis greenhouse agribisnis dengan standar konstruksi presisi dan teruji lapangan.',
    url: '/tentang-kami/',
    category: 'Layanan',
    badge: 'Profil',
    img: '/images/about/kontraktor-greenhouse-malang.webp',
  },
  {
    title: 'Kontak Tim & Konsultasi WhatsApp',
    desc: 'Konsultasi gambar kerja, denah kebun, spesifikasi material, dan survei lokasi langsung bersama tim teknis.',
    url: '/kontak/',
    category: 'Layanan',
    badge: 'Kontak',
    img: '/images/kontak/konsultasi-teknisi-greenhouse.webp',
  },
  // Products
  ...products.map((p) => ({
    title: p.data.title,
    desc: p.data.description,
    url: `/produk/${p.slug}/`,
    category: 'Material',
    badge:
      p.data.category === 'perlengkapan-greenhouse'
        ? 'Greenhouse'
        : p.data.category === 'perlengkapan-pertanian'
          ? 'Irigasi'
          : 'Saprodi',
    price: p.data.priceDisplay || (p.data.price ? `Rp ${p.data.price.toLocaleString('id-ID')}` : undefined),
    img: p.data.thumbnail,
  })),
  // Projects
  ...projects.map((pr) => ({
    title: pr.data.title,
    desc: `${pr.data.greenhouseType} - Luas ${pr.data.dimensions} di ${pr.data.locationCity}, ${pr.data.locationProvince}.`,
    url: `/proyek/${pr.slug}/`,
    category: 'Proyek',
    badge: pr.data.greenhouseType,
    img: pr.data.coverImage,
  })),
  // Articles
  ...articles.map((a) => ({
    title: a.data.title,
    desc: a.data.description,
    url: `/artikel/${a.slug}/`,
    category: 'Panduan',
    badge: a.data.category || 'Panduan',
    img: a.data.heroImage,
  })),
];
---

<!-- Top Announcement Bar (Shopify Clean Minimalist Style) -->
<div
  id="top-announcement-bar"
  class:list={[
    "text-[11px] font-medium tracking-wide py-2 px-4 border-b select-none transition-colors duration-300 relative z-40",
    isHomePage
      ? "bg-zinc-950/75 text-zinc-300 border-white/10 backdrop-blur-xs"
      : "bg-zinc-900 text-zinc-200 border-zinc-800"
  ]}
>
  <div class="max-w-7xl mx-auto sm:px-6 lg:px-8 flex justify-between items-center">
    <!-- Left: Delivery & Value Highlights -->
    <div class="flex items-center gap-3">
      <span class="inline-flex items-center gap-1.5 text-emerald-400 font-semibold uppercase tracking-wider text-[10px] sm:text-[11px]">
        <svg class="w-3.5 h-3.5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 18V6a2 2 0 00-2-2H4a2 2 0 00-2 2v11a1 1 0 001 1h2m9 0H9m10 0h2a1 1 0 001-1v-3.65a1 1 0 00-.22-.624l-3.48-4.35A1 1 0 0017.52 8H14M17 18a2 2 0 100-4 2 2 0 000 4zm-10 0a2 2 0 100-4 2 2 0 000 4z" />
        </svg>
        <span>Kontraktor Greenhouse Nusantara</span>
      </span>
      <span class="text-zinc-600 hidden sm:inline">•</span>
      <span class="hidden md:inline text-zinc-400 font-normal">
        Gratis Konsultasi Desain Struktur &amp; Estimasi RAB Transparan
      </span>
    </div>

    <!-- Right: Workshop Info & WhatsApp -->
    <div class="flex items-center gap-3 text-zinc-300 font-medium">
      <span class="hidden lg:inline-flex items-center gap-1.5 text-zinc-400 text-[11px]">
        <svg class="w-3.5 h-3.5 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        <span>{BUSINESS_INFO.hours.physicalStore}</span>
      </span>
      <span class="hidden lg:inline text-zinc-700">•</span>
      <a
        href={waInquiryUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 hover:text-emerald-300 transition-colors text-emerald-400 font-semibold"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>WA: {BUSINESS_INFO.contact.phone}</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header (Seamless Hero Overlay on Homepage & Sticky Glass Effect) -->
<header
  id="main-header"
  data-home-header={isHomePage ? "true" : "false"}
  class:list={[
    "sticky top-0 z-40 transition-all duration-300 font-sans",
    isHomePage ? "is-at-top" : "is-scrolled"
  ]}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-[72px] relative">
      
      <!-- Mobile Left: Hamburger Button -->
      <div class="flex items-center lg:hidden z-10">
        <button
          id="menu-btn"
          type="button"
          aria-label="Buka Menu Navigasi"
          class="mobile-hamburger-btn p-2 -ml-1 rounded-lg transition-colors cursor-pointer"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Center Logo (Mobile) / Left Logo (Desktop) -->
      <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 lg:static lg:translate-x-0 lg:translate-y-0 lg:flex items-center shrink-0 z-10 text-center lg:text-left">
        <a href="/" title="Agro Prima Greenhouse" class="flex flex-col group">
          <span class="header-logo-text text-xl sm:text-2xl font-black tracking-tight leading-none uppercase transition-colors">
            AGRO PRIMA<span class="text-emerald-500">.</span>
          </span>
          <span class="header-logo-sub text-[9px] font-bold tracking-[0.2em] uppercase leading-none mt-1 transition-colors">
            KONTRAKTOR GREENHOUSE
          </span>
        </a>
      </div>

      <!-- Desktop Navigation Menu (5 Pillars: Beranda + Dropdowns + Panduan) -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-1.5 h-full">
        
        <!-- 1. Beranda (Home) -->
        <a
          href="/"
          class:list={[
            'nav-link inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all duration-200',
            currentPath === '/' ? 'nav-link-active' : 'nav-link-inactive'
          ]}
        >
          Beranda
        </a>

        <!-- 2. Greenhouse (shadcn ui Dropdown Menu) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="menu"
            class:list={[
              'nav-link inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all duration-200 cursor-pointer',
              currentPath.startsWith('/jasa/') || currentPath.startsWith('/wilayah-layanan') || currentPath.startsWith('/proyek')
                ? 'nav-link-active'
                : 'nav-link-inactive'
            ]}
          >
            <span>Greenhouse</span>
            <svg class="w-3.5 h-3.5 chevron-icon transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu Content (shadcn/ui spec) -->
          <div class="invisible opacity-0 translate-y-1 scale-95 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-150 ease-out absolute top-full left-0 pt-1.5 z-50">
            <div class="w-72 overflow-hidden rounded-xl border border-zinc-200 bg-white p-1.5 text-zinc-950 shadow-xl shadow-zinc-950/10 select-none animate-in fade-in-0 zoom-in-95">
              
              <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                Layanan Konstruksi
              </div>
              
              <a href="/jasa/pembuatan-greenhouse/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Jasa Pembuatan Greenhouse</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Struktur galvanis, baja &amp; bambu</span>
                </div>
              </a>

              <a href="/jasa/pembuatan-greenhouse/#kalkulator" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Kalkulator Estimasi RAB</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Simulasi biaya per m² lahan online</span>
                </div>
              </a>

              <a href="/wilayah-layanan/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 18V6a2 2 0 00-2-2H4a2 2 0 00-2 2v11a1 1 0 001 1h2m9 0H9m10 0h2a1 1 0 001-1v-3.65a1 1 0 00-.22-.624l-3.48-4.35A1 1 0 0017.52 8H14M17 18a2 2 0 100-4 2 2 0 000 4zm-10 0a2 2 0 100-4 2 2 0 000 4z"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Wilayah Layanan &amp; Kargo</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Pengiriman &amp; survei se-Indonesia</span>
                </div>
              </a>

              <div class="-mx-1 my-1 h-px bg-zinc-100"></div>

              <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                Portofolio
              </div>

              <a href="/proyek/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Portofolio Proyek Nyata</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Dokumentasi hasil pengerjaan tim</span>
                </div>
              </a>

            </div>
          </div>
        </div>

        <!-- 3. Katalog Material (shadcn ui Dropdown Menu) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="menu"
            class:list={[
              'nav-link inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all duration-200 cursor-pointer',
              currentPath.startsWith('/produk')
                ? 'nav-link-active'
                : 'nav-link-inactive'
            ]}
          >
            <span>Katalog Material</span>
            <svg class="w-3.5 h-3.5 chevron-icon transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu Content (shadcn/ui spec) -->
          <div class="invisible opacity-0 translate-y-1 scale-95 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-150 ease-out absolute top-full left-0 pt-1.5 z-50">
            <div class="w-80 overflow-hidden rounded-xl border border-zinc-200 bg-white p-1.5 text-zinc-950 shadow-xl shadow-zinc-950/10 select-none animate-in fade-in-0 zoom-in-95">
              
              <div class="px-2.5 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">
                Kategori Material
              </div>

              <a href="/produk/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Semua Katalog Produk</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Seluruh sarana &amp; perlengkapan</span>
                </div>
              </a>

              <a href="/produk/perlengkapan-greenhouse/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="5"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Perlengkapan Greenhouse</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Plastik UV, paranet, clip &amp; insect net</span>
                </div>
              </a>

              <a href="/produk/perlengkapan-pertanian/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Irigasi &amp; Perlengkapan Tani</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Selang drip, sprayer &amp; hidroponik</span>
                </div>
              </a>

              <a href="/produk/saprodi-pertanian/" class="group/item relative flex cursor-pointer select-none items-center gap-2.5 rounded-lg px-2.5 py-2 text-xs outline-none transition-colors hover:bg-zinc-100 hover:text-zinc-950">
                <div class="w-8 h-8 rounded-lg bg-zinc-100 text-zinc-600 group-hover/item:bg-emerald-50 group-hover/item:text-emerald-700 flex items-center justify-center shrink-0 transition-colors">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
                </div>
                <div class="flex flex-col">
                  <span class="font-semibold text-zinc-900 group-hover/item:text-emerald-700 transition-colors">Saprodi Pertanian</span>
                  <span class="text-[11px] text-zinc-500 font-normal leading-tight mt-0.5">Pupuk NPK, mulsa perak &amp; tray semai</span>
                </div>
              </a>

            </div>
          </div>
        </div>

        <!-- 4. Panduan (Direct Link) -->
        <a
          href="/artikel/"
          class:list={[
            'nav-link inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all duration-200',
            currentPath.startsWith('/artikel') ? 'nav-link-active' : 'nav-link-inactive'
          ]}
        >
          Panduan
        </a>

        <!-- 5. Tentang (shadcn ui Dropdown Menu) -->
        <div class="relative group h-full flex items-center">
          <button
            type="button"
            aria-haspopup="menu"
            class:list={[
              'nav-link inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold tracking-wider uppercase transition-all duration-200 cursor-pointer',
              currentPath.startsWith('/tentang-kami') || currentPath.startsWith('/lokasi') || currentPath.startsWith('/kontak')
                ? 'nav-link-active'
                : 'nav-link-inactive'
            ]}
          >
            <span>Tentang</span>
            <svg class="w-3.5 h-3.5 chevron-icon transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown Menu Content (shadcn/ui spec) -->
          <div class="invisible opacity-0 translate-y-1 scale-95 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 group-hover:scale-100 transition-all duration-150 ease-out absolute top-full right-0 pt-1.5 z-50">
