---
export interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-2.5">
  <ol class="flex flex-wrap items-center gap-2 text-xs text-zinc-400 font-medium">
    <li>
      <a
        href="/"
        aria-label="Beranda"
        class="text-zinc-500 hover:text-zinc-900 transition-colors flex items-center p-0.5 rounded"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
      </a>
    </li>

    {items.map((item, index) => (
      <li class="flex items-center gap-2">
        <span class="text-zinc-300 select-none">/</span>
        {item.href && index !== items.length - 1 ? (
          <a href={item.href} class="text-zinc-500 hover:text-zinc-900 transition-colors">
            {item.label}
          </a>
        ) : (
          <span class="text-zinc-900 font-semibold truncate max-w-[200px] sm:max-w-none" aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
