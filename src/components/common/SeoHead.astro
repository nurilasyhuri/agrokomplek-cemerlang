---
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article' | 'product';
  keywords?: string | string[];
  author?: string;
  jsonLd?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  image = '/images/og/default-og.jpg',
  type = 'website',
  keywords,
  author = 'Agro Prima Greenhouse',
  jsonLd,
  noindex = false,
} = Astro.props;

const siteName = 'Agro Prima Greenhouse';
const domain = 'https://agroprimagreenhouse.com';

// Strictly strip any pipe symbols from title and description
const sanitizedRawTitle = title.replace(/\s*\|\s*/g, ' - ').trim();
const formattedTitle = sanitizedRawTitle.includes(siteName) || sanitizedRawTitle.includes('Agro Prima')
  ? sanitizedRawTitle
  : `${sanitizedRawTitle} - ${siteName}`;

const sanitizedDescription = description.replace(/\s*\|\s*/g, ', ').trim();

// Authoritative Absolute Image URL
const fullImageUrl = image.startsWith('http')
  ? image
  : `${domain}${image.startsWith('/') ? image : `/${image}`}`;

// Authoritative Canonical URL with guaranteed trailing slash alignment
const rawPath = canonical || Astro.url.pathname;
const cleanPathname = rawPath.startsWith('http')
  ? new URL(rawPath).pathname
  : (rawPath.startsWith('/') ? rawPath : `/${rawPath}`);
const normalizedPathname = cleanPathname.endsWith('/') || cleanPathname.includes('.')
  ? cleanPathname
  : `${cleanPathname}/`;
const canonicalUrl = `${domain}${normalizedPathname}`;

// Keywords string
const defaultKeywords = [
  'jasa pembuatan greenhouse',
  'kontraktor greenhouse',
  'biaya greenhouse per m2',
  'greenhouse malang',
  'plastik uv 200 mikron',
  'selang drip irigasi tetes',
  'tunnel garam prisma',
  'greenhouse galvanis',
  'agro prima greenhouse',
];
const keywordsString = Array.isArray(keywords)
  ? keywords.join(', ')
  : (keywords || defaultKeywords.join(', '));

// Format structured data JSON-LD into compliant schema @graph if multiple root entities
const formattedJsonLd = jsonLd
  ? (Array.isArray(jsonLd)
      ? {
          '@context': 'https://schema.org',
          '@graph': jsonLd.map((item) => {
            if (item && item['@context']) {
              const { '@context': _, ...rest } = item;
              return rest;
            }
            return item;
          }),
        }
      : jsonLd)
  : null;
---

<!-- Global Metadata & Mobile App Viewport -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />
<meta name="format-detection" content="telephone=no" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#047857" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="apple-mobile-web-app-title" content="Agro Prima" />
<meta name="application-name" content="Agro Prima Greenhouse" />

<!-- Robots & Indexing Directives -->
<meta
  name="robots"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>
<meta
  name="googlebot"
  content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="title" content={formattedTitle} />
<meta name="description" content={sanitizedDescription} />
<meta name="keywords" content={keywordsString} />
<meta name="author" content={author} />
<meta name="publisher" content={siteName} />
<link rel="canonical" href={canonicalUrl} />

<!-- Indonesian Geo-Targeting Metadata (Malang, Jawa Timur, Indonesia) -->
<meta name="geo.region" content="ID-JI" />
<meta name="geo.placename" content="Kota Malang" />
<meta name="geo.position" content="-7.9984;112.6456" />
<meta name="ICBM" content="-7.9984, 112.6456" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={sanitizedDescription} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={formattedTitle} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="id_ID" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={formattedTitle} />
<meta property="twitter:description" content={sanitizedDescription} />
<meta property="twitter:image" content={fullImageUrl} />

<!-- Preload Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap"
  rel="stylesheet"
/>

<!-- Structured Data (JSON-LD) -->
{formattedJsonLd && (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(formattedJsonLd)}
  />
)}
