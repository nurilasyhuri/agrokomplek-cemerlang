---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<footer class="bg-[#050e1a] text-zinc-300 pt-14 pb-8 border-t border-[#0284c7]/25 relative overflow-hidden font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12">
      
      <!-- Branding & Address (Col 1-5, 5 cols) -->
      <div class="lg:col-span-5 pr-0 lg:pr-8 space-y-4">
        <div>
          <a href="/" title="Agro Prima Greenhouse" class="font-sans text-2xl font-black tracking-tight text-white leading-none uppercase block">
            AGRO <span class="text-[#38bdf8]">PRIMA</span><span class="text-[#f59e0b]">.</span>
          </a>
          <span class="text-[9px] font-bold tracking-widest text-[#bae6fd] uppercase leading-none mt-1 block">
            KONTRAKTOR JASA GREENHOUSE
          </span>
        </div>

        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-normal">
          Spesialis rancang bangun greenhouse pipa galvanis hot-dip, baja ringan, bambu awet, tunnel garam, serta penyedia material plastik UV dan irigasi tetes kirim ke seluruh Indonesia.
        </p>
        
        <div class="space-y-2.5 text-xs text-zinc-300 pt-2">
          <p class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-[#38bdf8] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span><strong class="text-white">Workshop &amp; Gudang:</strong> {BUSINESS_INFO.address.fullFormatted}</span>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#38bdf8] shrink-0" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
            </svg>
            <a href="https://wa.me/6285183002070" target="_blank" rel="noopener noreferrer" class="text-zinc-200 hover:text-[#38bdf8] transition-colors">
              <strong class="text-white">WhatsApp:</strong> {BUSINESS_INFO.contact.phone}
            </a>
          </p>
          <p class="flex items-center gap-2.5">
            <svg class="w-4 h-4 text-[#38bdf8] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span><strong class="text-white">Jam Operasional:</strong> {BUSINESS_INFO.hours.physicalStore}</span>
          </p>
        </div>

        <div class="pt-2">
          <a
            href={BUSINESS_INFO.geo.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-[#0284c7] hover:bg-[#0369a1] text-white text-xs font-medium transition-colors shadow-xs"
          >
            <span>Petunjuk Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Links Columns (Col 6-12, 7 cols) -->
      <div class="lg:col-span-7 grid grid-cols-2 md:grid-cols-3 gap-8 text-xs">
        
        <!-- Column 1: MATERIAL STRUKTUR -->
        <div>
          <h4 class="font-bold text-white uppercase tracking-wider text-[11px] mb-3.5">
            Material Greenhouse
          </h4>
          <ul class="space-y-2 text-zinc-300">
            <li><a href="/produk/plastik-uv-greenhouse-14/" class="hover:text-[#38bdf8] transition-colors">Plastik UV 200µm</a></li>
            <li><a href="/produk/paranet-tanaman/" class="hover:text-[#38bdf8] transition-colors">Paranet Shading Net</a></li>
            <li><a href="/produk/insectnet-kasa-greenhouse/" class="hover:text-[#38bdf8] transition-colors">Insect Net 50 Mesh</a></li>
            <li><a href="/produk/spring-clip-profil-lock/" class="hover:text-[#38bdf8] transition-colors">Spring Clip &amp; Kanal C</a></li>
            <li><a href="/produk/selang-drip-irigasi-16mm/" class="hover:text-[#38bdf8] transition-colors">Selang Drip Irigasi</a></li>
            <li><a href="/produk/mulsa-plastik-hitam-perak/" class="hover:text-[#38bdf8] transition-colors">Mulsa Bedengan MPHP</a></li>
            <li><a href="/produk/paket-instalasi-hidroponik/" class="hover:text-[#38bdf8] transition-colors">Sistem Hidroponik NFT</a></li>
            <li><a href="/produk/" class="text-[#38bdf8] font-semibold hover:underline">Semua Material &rarr;</a></li>
          </ul>
        </div>

        <!-- Column 2: JASA & KONSTRUKSI -->
        <div>
          <h4 class="font-bold text-white uppercase tracking-wider text-[11px] mb-3.5">
            Jasa Konstruksi
          </h4>
          <ul class="space-y-2 text-zinc-300">
            <li><a href="/jasa/pembuatan-greenhouse/" class="hover:text-[#38bdf8] transition-colors">Greenhouse Galvanis</a></li>
            <li><a href="/jasa/pembuatan-greenhouse/" class="hover:text-[#38bdf8] transition-colors">Greenhouse Baja Ringan</a></li>
            <li><a href="/jasa/pembuatan-greenhouse/" class="hover:text-[#38bdf8] transition-colors">Greenhouse Bambu Awet</a></li>
            <li><a href="/proyek/tunnel-garam-pesisir-madura/" class="hover:text-[#38bdf8] transition-colors">Tunnel Prisma Garam</a></li>
            <li><a href="/jasa/pembuatan-greenhouse/#kalkulator" class="text-[#38bdf8] font-semibold hover:underline">Simulasi RAB Online</a></li>
            <li><a href="/wilayah-layanan/" class="hover:text-[#38bdf8] transition-colors">Jangkauan Kargo &amp; Pasang</a></li>
            <li><a href="/proyek/" class="hover:text-[#38bdf8] transition-colors">Galeri Proyek Lapangan</a></li>
          </ul>
        </div>

        <!-- Column 3: PANDUAN & USAHA -->
        <div>
          <h4 class="font-bold text-white uppercase tracking-wider text-[11px] mb-3.5">
            Panduan &amp; Kontak
          </h4>
          <ul class="space-y-2 text-zinc-300">
            <li><a href="/artikel/" class="hover:text-[#38bdf8] transition-colors">Blog &amp; Panduan Budidaya</a></li>
            <li><a href="/artikel/biaya-pembuatan-greenhouse/" class="hover:text-[#38bdf8] transition-colors">Estimasi Biaya per m²</a></li>
            <li><a href="/artikel/panduan-konstruksi-tunnel-garam/" class="hover:text-[#38bdf8] transition-colors">Konstruksi Tunnel Garam</a></li>
            <li><a href="/tentang-kami/" class="hover:text-[#38bdf8] transition-colors">Tentang Agro Prima</a></li>
            <li><a href="/lokasi/" class="hover:text-[#38bdf8] transition-colors">Lokasi Workshop Malang</a></li>
            <li><a href="/kontak/" class="hover:text-[#38bdf8] transition-colors">Kontak Resmi &amp; WhatsApp</a></li>
          </ul>
        </div>

      </div>
    </div>

    <!-- Bottom Bar (Shopify Clean Minimalist Footer) -->
    <div class="pt-8 border-t border-[#0284c7]/25 flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left text-xs text-zinc-300">
      <div>
        <span>&copy; {new Date().getFullYear()} Agro Prima Greenhouse. Hak cipta dilindungi undang-undang.</span>
      </div>

      <!-- Payment & Cargo Logistics Pills -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 select-none text-[10px] font-semibold text-zinc-200">
        <span class="text-[#bae6fd] uppercase tracking-wider mr-1 text-[9px]">Kargo &amp; Bank:</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-zinc-200">BCA</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-zinc-200">MANDIRI</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-zinc-200">BRI</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-[#38bdf8]">INDAH CARGO</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-[#38bdf8]">BARAKA</span>
        <span class="px-2 py-0.5 bg-[#0b1e36] border border-[#0284c7]/30 rounded text-[#38bdf8]">DAKOTA</span>
      </div>
    </div>
  </div>
</footer>
