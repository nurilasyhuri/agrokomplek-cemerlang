---

<section class="py-16 sm:py-24 bg-bg border-b border-border font-sans">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 pb-5 border-b border-border gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold text-primary block mb-1">
          Mengapa Memilih Agrokomplek Cemerlang?
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight">
          Lebih Mudah Mendapatkan Material dan Solusi Teknis
        </h2>
      </div>
      <a
        href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang,%20saya%20ingin%20konsultasi%20kebutuhan%20pertanian."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover transition-colors shrink-0"
      >
        <span>Konsultasi Kebutuhan Anda</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 5 Core Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      
      <!-- Pillar 1 -->
      <div class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <span class="text-[11px] font-bold text-primary block mb-1">Pilar 01</span>
          <h3 class="text-lg font-bold text-dark mb-2">Gudang &amp; Layanan dari Malang</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Kami berbasis di Malang, Jawa Timur, dan melayani kebutuhan pelanggan dari berbagai wilayah Indonesia.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/70 text-xs font-semibold text-muted">
          Pusat Distribusi Jawa Timur
        </div>
      </div>

      <!-- Pillar 2 -->
      <div class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7.5 4.27 9 5.15"></path>
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
              <path d="m3.3 7 8.7 5 8.7-5"></path>
              <path d="M12 22V12"></path>
            </svg>
          </div>
          <span class="text-[11px] font-bold text-primary block mb-1">Pilar 02</span>
          <h3 class="text-lg font-bold text-dark mb-2">Pilihan Produk Pertanian Lengkap</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Mulai dari material greenhouse, saprodi, irigasi, mulsa hingga perlengkapan hidroponik.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/70 text-xs font-semibold text-muted">
          Satu Tempat untuk Semua Kebutuhan
        </div>
      </div>

      <!-- Pillar 3 -->
      <div class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <span class="text-[11px] font-bold text-primary block mb-1">Pilar 03</span>
          <h3 class="text-lg font-bold text-dark mb-2">Konsultasi Sebelum Membeli</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Belum tahu spesifikasi material yang diperlukan? Diskusikan kebutuhan tanaman, luas lahan, dan sistem budidaya Anda terlebih dahulu.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/70 text-xs font-semibold text-muted">
          Bimbingan Teknis &amp; Spesifikasi
        </div>
      </div>

      <!-- Pillar 4 -->
      <div class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
              <path d="M15 18H9"></path>
              <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
              <circle cx="17" cy="18" r="2"></circle>
              <circle cx="7" cy="18" r="2"></circle>
            </svg>
          </div>
          <span class="text-[11px] font-bold text-primary block mb-1">Pilar 04</span>
          <h3 class="text-lg font-bold text-dark mb-2">Pengiriman ke Seluruh Indonesia</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Material pertanian dapat dikirim menggunakan layanan ekspedisi dan kargo sesuai ukuran, berat, serta tujuan pengiriman.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/70 text-xs font-semibold text-muted">
          Kargo Darat, Laut &amp; Udara
        </div>
      </div>

      <!-- Pillar 5 -->
      <div class="p-6 sm:p-7 rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between md:col-span-2 lg:col-span-2">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-4"></path>
            </svg>
          </div>
          <span class="text-[11px] font-bold text-primary block mb-1">Pilar 05</span>
          <h3 class="text-lg font-bold text-dark mb-2">Layanan Pembuatan Greenhouse</h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed">
            Untuk proyek konstruksi, kebutuhan desain, material, instalasi, dan lokasi dapat dibahas sebelum penyusunan penawaran resmi.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-border/70 text-xs font-semibold text-muted">
          Perencanaan, Fabrikasi hingga Terima Kunci
        </div>
      </div>

    </div>

  </div>
</section>
