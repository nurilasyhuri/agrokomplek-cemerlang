---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<section id="kontak" class="py-8 sm:py-12 lg:py-14 bg-[#efebe2] border-t border-[#dedad0] scroll-mt-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-6 sm:mb-8">
      <span class="text-xs font-bold text-[#064e3b] uppercase tracking-wider block mb-2">
        Kontak &amp; Workshop Resmi
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#1b2819] tracking-tight leading-tight">
        Hubungi Tim Agrokomplek Cemerlang
      </h2>
      <p class="mt-3.5 text-sm sm:text-base text-[#485245] leading-relaxed">
        Konsultasikan rencana pembuatan greenhouse, cek stok material saprodi, atau jadwalkan survei lahan dan kalkulasi estimasi RAB transparan bersama tim teknisi kami di Malang.
      </p>
    </div>

    <!-- Main Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
      
      <!-- Left Column: Contact Channels & Office Details (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between p-6 sm:p-8 lg:p-10 rounded-2xl bg-white border border-[#dedad0] shadow-sm">
        <div>
          <div class="pb-5 border-b border-[#dedad0]">
            <h3 class="text-xl font-bold text-[#1b2819] tracking-tight">
              Saluran Komunikasi Langsung
            </h3>
            <p class="text-xs text-[#767e73] mt-0.5">
              Hubungi kami melalui nomor telepon, WhatsApp, email resmi, atau kunjungi workshop langsung di Malang
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5 mt-6">
            
            <!-- WhatsApp -->
            <a
              href={`https://wa.me/${BUSINESS_INFO.contact.whatsappRaw}?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20konsultasi.`}
              target="_blank"
              rel="noopener noreferrer"
              class="group p-4 rounded-xl border border-[#dedad0] bg-[#faf8f5] hover:bg-[#e4e5da]/40 hover:border-[#064e3b]/30 transition-all flex items-start gap-3.5"
            >
              <div class="w-10 h-10 rounded-lg bg-[#064e3b] text-[#edeae1] flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#767e73] block">WhatsApp CS</span>
                <span class="font-bold text-sm text-[#1b2819] group-hover:text-[#064e3b] transition-colors block truncate">
                  {BUSINESS_INFO.contact.phone}
                </span>
                <span class="text-[11px] text-[#485245] mt-0.5 block leading-tight">Chat konsultasi &amp; cek stok</span>
              </div>
            </a>

            <!-- Phone -->
            <a
              href={`tel:${BUSINESS_INFO.contact.whatsappRaw}`}
              class="group p-4 rounded-xl border border-[#dedad0] bg-[#faf8f5] hover:bg-[#e4e5da]/40 hover:border-[#064e3b]/30 transition-all flex items-start gap-3.5"
            >
              <div class="w-10 h-10 rounded-lg bg-[#e4e5da] text-[#064e3b] flex items-center justify-center shrink-0 border border-[#dedad0] group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#767e73] block">Telepon CS</span>
                <span class="font-bold text-sm text-[#1b2819] group-hover:text-[#064e3b] transition-colors block truncate">
                  {BUSINESS_INFO.contact.phone}
                </span>
                <span class="text-[11px] text-[#485245] mt-0.5 block leading-tight">Panggilan telepon jam operasional</span>
              </div>
            </a>

            <!-- Email -->
            <a
              href={`mailto:${BUSINESS_INFO.contact.email}`}
              class="group p-4 rounded-xl border border-[#dedad0] bg-[#faf8f5] hover:bg-[#e4e5da]/40 hover:border-[#064e3b]/30 transition-all flex items-start gap-3.5"
            >
              <div class="w-10 h-10 rounded-lg bg-[#e4e5da] text-[#064e3b] flex items-center justify-center shrink-0 border border-[#dedad0] group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="min-w-0 flex-1">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#767e73] block">Email Resmi</span>
                <span class="font-bold text-xs text-[#1b2819] group-hover:text-[#064e3b] transition-colors block break-all">
                  {BUSINESS_INFO.contact.email}
                </span>
                <span class="text-[11px] text-[#485245] mt-0.5 block leading-tight">Penawaran B2B &amp; Pengadaan</span>
              </div>
            </a>

            <!-- Operating Hours -->
            <div class="p-4 rounded-xl border border-[#dedad0] bg-[#faf8f5] flex items-start gap-3.5">
              <div class="w-10 h-10 rounded-lg bg-[#e4e5da] text-[#064e3b] flex items-center justify-center shrink-0 border border-[#dedad0]">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="min-w-0">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#767e73] block">Jam Layanan</span>
                <span class="font-bold text-xs sm:text-sm text-[#1b2819] block">
                  {BUSINESS_INFO.hours.physicalStore}
                </span>
                <span class="text-[11px] text-[#485245] mt-0.5 block leading-tight">Konsultasi WA 24 Jam nonstop</span>
              </div>
            </div>

          </div>

          <!-- Address snippet -->
          <div class="mt-6 p-4 rounded-xl border border-[#dedad0] bg-[#faf8f5] flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-lg bg-[#e4e5da] text-[#064e3b] flex items-center justify-center shrink-0 border border-[#dedad0]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#767e73] block">Workshop &amp; Gudang Malang</span>
              <p class="text-xs sm:text-sm text-[#1b2819] font-medium mt-0.5 leading-relaxed">
                {BUSINESS_INFO.address.fullFormatted}
              </p>
            </div>
          </div>
        </div>

        <!-- Links to dedicated pages -->
        <div class="pt-6 mt-6 border-t border-[#dedad0] flex flex-wrap items-center justify-between gap-3">
          <a
            href={BUSINESS_INFO.geo.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#064e3b] hover:bg-[#047857] text-[#edeae1] font-semibold text-xs transition-all shadow-xs select-none"
          >
            <span>Buka Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <div class="flex items-center gap-3">
            <a
              href="/lokasi/"
              class="text-xs font-semibold text-[#064e3b] hover:text-[#047857] underline underline-offset-4"
            >
              Panduan Rute &amp; Lokasi
            </a>
            <span class="text-[#dedad0]">•</span>
            <a
              href="/kontak/"
              class="text-xs font-semibold text-[#064e3b] hover:text-[#047857] underline underline-offset-4"
            >
              Halaman Kontak Lengkap
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Direct Consultation Routing Box (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between p-6 sm:p-8 rounded-2xl bg-[#064e3b] text-[#edeae1] border border-[#047857]/60 shadow-lg">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-[#047857]/40 text-emerald-200 border border-[#047857]/60 mb-4">
            <span>Respons Cepat via WhatsApp</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white tracking-tight leading-snug">
            Konsultasikan Kebutuhan Anda
          </h3>
          <p class="text-xs sm:text-sm text-[#dedad0] mt-2 leading-relaxed font-normal">
            Pilih jalur komunikasi di bawah ini agar pesan Anda langsung ditangani staf atau teknisi terkait:
          </p>

          <!-- Direct routing options -->
          <div class="space-y-3 mt-6">
            
            <a
              href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20konsultasi%20jasa%20pembuatan%20greenhouse."
              target="_blank"
              rel="noopener noreferrer"
              class="group w-full flex items-center justify-between p-3.5 rounded-xl bg-[#047857]/30 hover:bg-[#047857] text-[#edeae1] text-xs sm:text-sm font-semibold transition-all border border-[#047857]/50 shadow-xs"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
                <span>Konsultasi Pembuatan Greenhouse</span>
              </div>
              <span class="text-emerald-300 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>

            <a
              href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20cek%20stok%20material%20(Plastik%20UV%20%2F%20Paranet%20%2F%20Insect%20Net%20%2F%20Saprodi)."
              target="_blank"
              rel="noopener noreferrer"
              class="group w-full flex items-center justify-between p-3.5 rounded-xl bg-[#047857]/30 hover:bg-[#047857] text-[#edeae1] text-xs sm:text-sm font-semibold transition-all border border-[#047857]/50 shadow-xs"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
                <span>Cek Stok Material &amp; Saprodi</span>
              </div>
              <span class="text-emerald-300 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>

            <a
              href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang%2C%20saya%20ingin%20estimasi%20RAB%20dan%20jadwal%20survei%20lahan%20greenhouse."
              target="_blank"
              rel="noopener noreferrer"
              class="group w-full flex items-center justify-between p-3.5 rounded-xl bg-[#047857]/30 hover:bg-[#047857] text-[#edeae1] text-xs sm:text-sm font-semibold transition-all border border-[#047857]/50 shadow-xs"
            >
              <div class="flex items-center gap-2.5">
                <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                </svg>
                <span>Estimasi RAB &amp; Jadwal Survei Lahan</span>
              </div>
              <span class="text-emerald-300 group-hover:translate-x-1 transition-transform">&rarr;</span>
            </a>

          </div>
        </div>

        <!-- Workshop Location Preview & Maps -->
        <div class="mt-6 pt-5 border-t border-[#047857]/40 space-y-3">
          <div class="flex items-center justify-between text-xs text-[#dedad0]">
            <span class="flex items-center gap-1.5 font-medium">
              <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <span>Kedungkandang, Kota Malang</span>
            </span>
            <a
              href={BUSINESS_INFO.geo.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-emerald-300 hover:text-white font-semibold underline underline-offset-2 flex items-center gap-1 text-[11px]"
            >
              <span>Petunjuk Arah</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="rounded-xl overflow-hidden border border-[#047857]/50 aspect-[16/9] w-full bg-[#064e3b] relative shadow-inner">
            <iframe
              src="https://maps.google.com/maps?q=-7.9984,112.6456&z=15&output=embed"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Peta Lokasi Agrokomplek Cemerlang Malang"
              class="w-full h-full opacity-90 hover:opacity-100 transition-opacity"
            ></iframe>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
