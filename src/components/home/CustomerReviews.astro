---
const reviews = [
  {
    name: 'Pak Hendra Pratama',
    initials: 'HP',
    role: 'Petani Melon Hidroponik',
    location: 'Batu, Jawa Timur',
    item: 'Plastik UV 200μm & Spring Clip',
    rating: 5,
    title: 'Plastik UV Tebal & Tahan Angin Pegunungan',
    comment: 'Sudah 3 tahun pakai plastik UV 14% dari Agro Prima di kebun melon Batu. Kualitasnya jempolan, tidak getas terkena fluktuasi suhu dingin malam dan terik siang pegunungan.',
  },
  {
    name: 'Bpk. Ir. Danang Wibowo',
    initials: 'DW',
    role: 'Pengelola Agrowisata Sayur',
    location: 'Kediri, Jawa Timur',
    item: 'Greenhouse Galvanis 400m²',
    rating: 5,
    title: 'Pengerjaan Cepat & RAB Sangat Transparan',
    comment: 'Puas sekali bangun greenhouse galvanis lewat Agro Prima. Desain monitor roof membuat sirkulasi udara adem alami, tanaman stroberi dan selada tumbuh sangat prima.',
  },
  {
    name: 'Ibu Ratna Kumalasari',
    initials: 'RK',
    role: 'Pemilik Nursery Bunga',
    location: 'Bandung Barat, Jawa Barat',
    item: 'Paranet 75% & Selang Drip 16mm',
    rating: 5,
    title: 'Pengiriman Kargo Rapi & Aman Luar Pulau',
    comment: 'Pesan paranet 75% dan selang drip kirim ke Bandung pakai J&T Cargo, packing peti kayu rapi tanpa cacat. Resi cepat diinfo dan konsultasi teknisnya sangat solutif.',
  },
  {
    name: 'Haji Mansur',
    initials: 'HM',
    role: 'Sentra Garam Rakyat',
    location: 'Sumenep, Madura',
    item: 'Tunnel Garam Prisma 10 Unit',
    rating: 5,
    title: 'Produksi Garam Naik & Kristal Lebih Bersih',
    comment: 'Tunnel garam prisma dengan plastik UV tahan garam laut mempercepat panen kristalisasi garam. Kualitas kristal garam putih bersih super dan aman dari hujan mendadak.',
  },
];
---

<section class="py-14 sm:py-20 bg-zinc-50/60 border-b border-zinc-200/80 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Shopify Clean Minimalist) -->
    <div class="text-center max-w-2xl mx-auto mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-emerald-800 text-[11px] font-bold uppercase tracking-wider mb-2 border border-emerald-200/60">
        <span>Pengalaman Nyata Lapangan</span>
      </div>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight mb-2">
        Dipercaya Petani &amp; Pelaku Agribisnis Mitra
      </h2>
      <p class="text-xs sm:text-sm font-medium text-zinc-500">
        Dokumentasi ulasan mitra pembangunan greenhouse dan pemakai material dari berbagai daerah.
      </p>
    </div>

    <!-- Reviews Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      {reviews.map((r) => (
        <div class="rounded-xl bg-white border border-zinc-200/80 p-5 shadow-xs hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
          <div>
            <!-- Stars & Verified Badge -->
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex text-amber-400 text-xs">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
              <span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-100">
                <svg class="w-3 h-3 text-emerald-600" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>Proyek Nyata</span>
              </span>
            </div>

            <!-- Review Title -->
            <h3 class="font-bold text-xs sm:text-sm text-zinc-900 mb-1.5 leading-snug">
              {r.title}
            </h3>

            <!-- Review Comment -->
            <p class="text-xs text-zinc-600 leading-relaxed mb-4">
              &ldquo;{r.comment}&rdquo;
            </p>
          </div>

          <!-- Customer Identity & Purchased Item -->
          <div class="pt-3.5 border-t border-zinc-100 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-50 text-emerald-800 font-bold text-xs flex items-center justify-center shrink-0 border border-emerald-200/60">
              {r.initials}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-bold text-xs text-zinc-900 truncate">{r.name}</p>
              <p class="text-[11px] text-zinc-400 truncate">{r.role} &bull; {r.location}</p>
              <p class="text-[10px] text-emerald-700 font-medium truncate mt-0.5">{r.item}</p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
