---
import { getCollection } from 'astro:content';

const articles = await getCollection('artikel');
const latestArticles = articles
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);
---

<section class="py-16 sm:py-24 bg-white border-b border-border font-sans">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 pb-5 border-b border-border gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold text-primary block mb-1">
          Panduan Pertanian &amp; Greenhouse
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight mb-2">
          Pelajari Sebelum Membeli atau Membangun
        </h2>
        <p class="text-xs sm:text-sm text-muted font-normal">
          Kami menyediakan artikel dan panduan untuk membantu Anda memahami material serta perencanaan greenhouse dengan lebih baik.
        </p>
      </div>
      <a
        href="/artikel/"
        class="inline-flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover transition-colors shrink-0"
      >
        <span>Lihat Semua Panduan</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 3 Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {latestArticles.map((art) => {
        let cardTitle = art.data.title;
        let cardDesc = art.data.description;
        let ctaText = 'Baca Panduan Lengkap';

        if (art.slug.includes('biaya-pembuatan-greenhouse')) {
          cardTitle = 'Berapa Biaya Pembuatan Greenhouse?';
          cardDesc = 'Pelajari faktor yang memengaruhi biaya berdasarkan luas, rangka, material penutup, dan kebutuhan instalasi.';
          ctaText = 'Baca Panduan Biaya Greenhouse';
        } else if (art.slug.includes('plastik-uv-dan-paranet')) {
          cardTitle = 'Plastik UV atau Paranet?';
          cardDesc = 'Kenali perbedaan fungsi keduanya sebelum menentukan material perlindungan tanaman.';
          ctaText = 'Baca Plastik UV vs Paranet';
        } else if (art.slug.includes('tunnel-garam')) {
          cardTitle = 'Bagaimana Membuat Tunnel Garam?';
          cardDesc = 'Pelajari fungsi, struktur dasar, dan pertimbangan pembangunan tunnel untuk produksi garam.';
          ctaText = 'Baca Panduan Tunnel Garam';
        }

        return (
          <article class="group rounded-2xl sm:rounded-3xl bg-white border border-border overflow-hidden hover:border-primary/40 hover:shadow-hover transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- Image with Zoom on Hover - GAMBAR HANYA GAMBAR SAJA -->
              <a href={`/artikel/${art.slug}/`} class="block aspect-[16/10] overflow-hidden bg-secondary">
                <img
                  src={art.data.heroImage}
                  alt={cardTitle}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                />
              </a>

              <!-- Content Area -->
              <div class="p-6">
                <div class="flex items-center gap-2 mb-2.5">
                  <span class="text-[10px] font-bold text-primary bg-peach px-2 py-0.5 rounded-full border border-primary/20">
                    {art.data.category}
                  </span>
                  <span class="text-[11px] font-medium text-muted">
                    &bull; {art.data.publishDate}
                  </span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2.5">
                  <a href={`/artikel/${art.slug}/`}>
                    {cardTitle}
                  </a>
                </h3>
                <p class="text-xs text-muted leading-relaxed mb-4">
                  {cardDesc}
                </p>
              </div>
            </div>

            <div class="px-6 pb-6 pt-0">
              <a
                href={`/artikel/${art.slug}/`}
                class="inline-flex items-center gap-1.5 text-xs font-bold text-primary group-hover:text-primary-hover transition-colors"
              >
                <span>{ctaText}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
