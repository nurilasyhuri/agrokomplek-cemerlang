---
import { getCollection } from 'astro:content';

const articles = await getCollection('artikel');
const latestArticles = articles
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())
  .slice(0, 3);
---

<section class="py-14 sm:py-20 bg-white border-b border-zinc-200/80 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Shopify Clean Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 pb-6 border-b border-zinc-100 gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1">
          Panduan Pertanian &amp; Greenhouse
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight">
          Pelajari Sebelum Membeli atau Membangun
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 font-normal mt-2">
          Kami menyediakan artikel dan panduan teknis untuk membantu Anda memahami material serta perencanaan greenhouse dengan lebih baik.
        </p>
      </div>
      <a
        href="/artikel/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors shrink-0"
      >
        <span>Lihat Semua Panduan</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 3 Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 sm:gap-6">
      {latestArticles.map((art) => {
        let cardTitle = art.data.title;
        let cardDesc = art.data.description;
        let ctaText = 'Baca Panduan Lengkap';

        if (art.slug.includes('biaya-pembuatan-greenhouse')) {
          cardTitle = 'Berapa Biaya Pembuatan Greenhouse?';
          cardDesc = 'Pelajari faktor yang memengaruhi biaya berdasarkan luas, rangka, material penutup, dan kebutuhan instalasi.';
          ctaText = 'Panduan Biaya Greenhouse';
        } else if (art.slug.includes('plastik-uv-dan-paranet')) {
          cardTitle = 'Plastik UV atau Paranet?';
          cardDesc = 'Kenali perbedaan fungsi keduanya sebelum menentukan material perlindungan tanaman.';
          ctaText = 'Plastik UV vs Paranet';
        } else if (art.slug.includes('tunnel-garam')) {
          cardTitle = 'Bagaimana Membuat Tunnel Garam?';
          cardDesc = 'Pelajari fungsi, struktur dasar, dan pertimbangan pembangunan tunnel untuk produksi garam.';
          ctaText = 'Panduan Tunnel Garam';
        }

        return (
          <article class="group rounded-xl bg-white border border-zinc-200/80 overflow-hidden hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 flex flex-col justify-between">
            <div>
              <!-- Image with Zoom on Hover -->
              <a href={`/artikel/${art.slug}/`} class="block aspect-[16/10] overflow-hidden bg-zinc-50">
                <img
                  src={art.data.heroImage}
                  alt={cardTitle}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                  loading="lazy"
                  decoding="async"
                />
              </a>

              <!-- Content Area -->
              <div class="p-5">
                <div class="flex items-center gap-2 mb-2">
                  <span class="text-[10px] font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/60 uppercase">
                    {art.data.category}
                  </span>
                  <span class="text-[11px] font-medium text-zinc-400">
                    &bull; {art.data.publishDate}
                  </span>
                </div>
                <h3 class="text-base font-bold text-zinc-900 leading-snug group-hover:text-emerald-700 transition-colors mb-2">
                  <a href={`/artikel/${art.slug}/`}>
                    {cardTitle}
                  </a>
                </h3>
                <p class="text-xs text-zinc-600 leading-relaxed">
                  {cardDesc}
                </p>
              </div>
            </div>

            <div class="px-5 pb-5 pt-0">
              <div class="pt-3 border-t border-zinc-100">
                <a
                  href={`/artikel/${art.slug}/`}
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 group-hover:text-emerald-800 transition-colors"
                >
                  <span>{ctaText}</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </div>
</section>
