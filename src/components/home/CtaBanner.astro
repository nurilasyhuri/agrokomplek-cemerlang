---
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waConsultUrl = generateGeneralInquiryUrl('cta-banner');
---

<section class="py-14 sm:py-20 bg-[#efebe2] font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="rounded-2xl bg-[#064e3b] text-[#edeae1] border border-[#047857]/60 p-8 sm:p-12 lg:p-14 relative overflow-hidden flex flex-col lg:flex-row items-center justify-between gap-8 sm:gap-12 shadow-lg">
      
      <!-- Left Content -->
      <div class="max-w-2xl text-left">
        <span class="text-xs font-bold text-emerald-300 uppercase tracking-wider block mb-1">
          Konsultasi &amp; Layanan Proyek
        </span>
        
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-white tracking-tight leading-tight mb-3">
          Konsultasikan Rencana Pertanian &amp; Greenhouse Anda
        </h2>
        
        <p class="text-xs sm:text-sm text-[#dedad0] font-normal leading-relaxed mb-5">
          Diskusikan denah kebun, kebutuhan saprodi &amp; pupuk, spesifikasi material plastik UV rol besar, hingga estimasi RAB pembangunan greenhouse siap tanam langsung bersama tim teknis Agrokomplek Cemerlang di Malang.
        </p>

        <!-- Checklist -->
        <div class="flex flex-wrap items-center gap-2 text-xs font-medium text-[#edeae1]">
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15">Survei &amp; Gambar Kerja</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15">Kalkulasi RAB Transparan</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15">Kirim Kargo se-Indonesia</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15">Pengerjaan Siap Tanam</span>
          <span class="px-3 py-1 rounded-full bg-white/10 border border-white/15">Fast Response WhatsApp</span>
        </div>
      </div>

      <!-- Right Action Column -->
      <div class="flex flex-col sm:flex-row lg:flex-col gap-3 w-full lg:w-auto shrink-0">
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="px-7 py-3.5 rounded-full bg-[#efebe2] hover:bg-white text-[#1b2819] font-bold text-xs sm:text-sm tracking-normal shadow-xs hover:shadow transition-all flex items-center justify-center gap-2 select-none"
        >
          <svg class="w-4 h-4 text-[#1b2819]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2z"/>
          </svg>
          <span>Konsultasi via WhatsApp</span>
        </a>

        <a
          href="/jasa/pembuatan-greenhouse/#kalkulator"
          class="px-7 py-3.5 rounded-full bg-white/10 hover:bg-white/20 text-[#edeae1] font-semibold text-xs sm:text-sm border border-white/20 transition-all flex items-center justify-center gap-2 select-none"
        >
          <span>Hitung Estimasi Biaya (RAB)</span>
          <span aria-hidden="true">&rarr;</span>
        </a>

        <p class="text-center text-[11px] text-emerald-200/80 font-medium">
          Fast response: Senin &ndash; Minggu (07.30 &ndash; 17.00 WIB)
        </p>
      </div>

    </div>
  </div>
</section>
