---
---

<section class="py-12 sm:py-16 bg-bg border-b border-border font-sans">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 border-b border-border pb-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold text-primary block mb-1">
          Kategori Rancang Bangun
        </span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight font-sans mb-3">
          Pilihan Tipe Konstruksi Greenhouse
        </h2>
        <p class="text-sm md:text-base text-muted leading-relaxed">
          Setiap komoditas budidaya, lokasi lahan, dan anggaran memiliki spesifikasi struktur yang berbeda. Kami menghadirkan rancang bangun greenhouse mulai dari bambu ekonomis hingga pipa galvanis standar industri komersial.
        </p>
      </div>
      <a
        href="/jasa/pembuatan-greenhouse/#kalkulator"
        class="flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover group/link mt-4 md:mt-0 whitespace-nowrap"
      >
        <span>Hitung Estimasi Biaya RAB</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
      
      <!-- 01 — GREENHOUSE GALVANIS -->
      <a href="/jasa/pembuatan-greenhouse/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Konstruksi Greenhouse Galvanis Modern Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Standar Industri &bull; 15+ Tahun
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Greenhouse Galvanis
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Rangka pipa galvanis hot-dip tahan puluhan tahun terhadap korosi iklim tropis. Sangat kokoh untuk melon hidroponik dan agribisnis skala komersial.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Detail Greenhouse Galvanis</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 02 — GREENHOUSE BAJA RINGAN -->
      <a href="/jasa/pembuatan-greenhouse/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/greenhouse/greenhouse-baja-ringan.webp"
              alt="Greenhouse Baja Ringan Presisi Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Presisi Rapi &bull; 7-10 Tahun
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Greenhouse Baja Ringan
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Kombinasi rangka kanal C dan reng baja ringan anti karat dengan bentang luas dan instalasi cepat. Ideal untuk nursery bibit dan kebun semi-komersial.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Detail Greenhouse Baja Ringan</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 03 — GREENHOUSE BAMBU AWET -->
      <a href="/jasa/pembuatan-greenhouse/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/greenhouse/greenhouse-bambu.webp"
              alt="Greenhouse Bambu Awet dan Kokoh Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Ekonomis Teruji &bull; 3-5 Tahun
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Greenhouse Bambu Awet
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Pilihan cerdas ramah anggaran bagi kelompok tani dan pemula. Struktur bambu pilihan dengan perlakuan anti rayap dan kuncian spring clip tahan angin.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Detail Greenhouse Bambu</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 04 — TUNNEL GARAM & HIDROPONIK -->
      <a href="/proyek/tunnel-garam-pesisir-madura/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/greenhouse/tunnel-garam-greenhouse.webp"
              alt="Konstruksi Tunnel Prisma Garam Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Inovasi Pesisir &bull; Bebas Hujan
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Tunnel Prisma Garam
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Teknologi rumah kristalisasi tertutup anti-hujan dengan geomembrane HDPE dan plastik UV khusus untuk panen garam meja higienis sepanjang tahun.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Lihat Tunnel Prisma Garam</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>
