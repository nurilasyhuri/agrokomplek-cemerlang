---
---

<section class="py-6 sm:py-8 bg-[#efebe2] border-b border-[#dedad0] font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 sm:mb-8 border-b border-[#dedad0] pb-4 gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-bold text-[#064e3b] uppercase tracking-wider block mb-1">
          Katalog Produk &amp; Material
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-[#1b2819] tracking-tight font-sans">
          Perlengkapan Pertanian &amp; Jasa Greenhouse
        </h2>
        <p class="text-xs sm:text-sm text-[#485245] leading-relaxed mt-2 font-normal">
          Sarana produksi pertanian, material greenhouse siap kirim kargo, dan paket rancang bangun siap tanam dari Malang untuk seluruh Indonesia.
        </p>
      </div>
      <a
        href="/produk/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#064e3b] hover:text-[#047857] transition-colors shrink-0"
      >
        <span>Lihat Semua Katalog</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5">
      
      <!-- 01 — SAPRODI PERTANIAN -->
      <a href="/produk/saprodi-pertanian/" class="group flex flex-col justify-between rounded-xl bg-white border border-[#dedad0] hover:border-[#c8c3b7] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-[#e4e5da]/40 overflow-hidden relative">
            <img
              src="/images/products/pupuk-npk-16-16-16.webp"
              alt="Saprodi Pertanian Lengkap Pupuk Benih Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-4 sm:p-5">
            <span class="text-[11px] font-bold text-[#064e3b] uppercase tracking-wider block mb-1">
              Nutrisi &bull; Benih &bull; Media Tanam
            </span>
            <h3 class="text-base font-bold text-[#1b2819] leading-snug group-hover:text-[#064e3b] transition-colors mb-1.5">
              Saprodi Pertanian
            </h3>
            <p class="text-xs text-[#485245] leading-relaxed">
              Pupuk organik/anorganik, nutrisi AB Mix, benih unggul hortikultura, fungisida, dan media tanam untuk mendukung pertumbuhan fase awal hingga panen.
            </p>
          </div>
        </div>

        <div class="px-4 sm:p-5 pt-0 pb-4">
          <div class="pt-3 border-t border-[#dedad0]/60 flex items-center justify-between text-xs font-semibold text-[#064e3b] group-hover:text-[#047857] transition-colors">
            <span>Lihat Saprodi Pertanian</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 02 — MATERIAL GREENHOUSE -->
      <a href="/produk/perlengkapan-greenhouse/" class="group flex flex-col justify-between rounded-xl bg-white border border-[#dedad0] hover:border-[#c8c3b7] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-[#e4e5da]/40 overflow-hidden relative">
            <img
              src="/images/products/plastik-uv-greenhouse.webp"
              alt="Material Greenhouse Plastik UV Paranet Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-4 sm:p-5">
            <span class="text-[11px] font-bold text-[#064e3b] uppercase tracking-wider block mb-1">
              Plastik UV &bull; Paranet &bull; Klip
            </span>
            <h3 class="text-base font-bold text-[#1b2819] leading-snug group-hover:text-[#064e3b] transition-colors mb-1.5">
              Material Greenhouse
            </h3>
            <p class="text-xs text-[#485245] leading-relaxed">
              Plastik UV 14%-20% 200µm, paranet 65%-85%, insect net 50 mesh, dan spring clip lock. Tersedia eceran per meter dan rol grosir siap kirim kargo.
            </p>
          </div>
        </div>

        <div class="px-4 sm:p-5 pt-0 pb-4">
          <div class="pt-3 border-t border-[#dedad0]/60 flex items-center justify-between text-xs font-semibold text-[#064e3b] group-hover:text-[#047857] transition-colors">
            <span>Lihat Material Greenhouse</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 03 — IRIGASI & PERLENGKAPAN KEBUN -->
      <a href="/produk/perlengkapan-pertanian/" class="group flex flex-col justify-between rounded-xl bg-white border border-[#dedad0] hover:border-[#c8c3b7] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-[#e4e5da]/40 overflow-hidden relative">
            <img
              src="/images/products/selang-drip-irigasi-16mm.webp"
              alt="Irigasi Pertanian Selang Drip Sprayer Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-4 sm:p-5">
            <span class="text-[11px] font-bold text-[#064e3b] uppercase tracking-wider block mb-1">
              Selang Drip &bull; Sprayer &bull; Mulsa
            </span>
            <h3 class="text-base font-bold text-[#1b2819] leading-snug group-hover:text-[#064e3b] transition-colors mb-1.5">
              Irigasi &amp; Perlengkapan
            </h3>
            <p class="text-xs text-[#485245] leading-relaxed">
              Bangun distribusi air presisi dengan selang drip 16mm, sprayer elektrik, mulsa MPHP hitam perak, dan fitting fertigasi hemat air dan nutrisi.
            </p>
          </div>
        </div>

        <div class="px-4 sm:p-5 pt-0 pb-4">
          <div class="pt-3 border-t border-[#dedad0]/60 flex items-center justify-between text-xs font-semibold text-[#064e3b] group-hover:text-[#047857] transition-colors">
            <span>Lihat Perlengkapan Irigasi</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 04 — JASA PEMBUATAN GREENHOUSE -->
      <a href="/jasa/pembuatan-greenhouse/" class="group flex flex-col justify-between rounded-xl bg-white border border-[#dedad0] hover:border-[#c8c3b7] hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-[#e4e5da]/40 overflow-hidden relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Jasa Pembuatan Greenhouse Siap Tanam Agrokomplek Cemerlang"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-4 sm:p-5">
            <span class="text-[11px] font-bold text-[#064e3b] uppercase tracking-wider block mb-1">
              Bambu &bull; Baja Ringan &bull; Galvanis
            </span>
            <h3 class="text-base font-bold text-[#1b2819] leading-snug group-hover:text-[#064e3b] transition-colors mb-1.5">
              Jasa Pembuatan Greenhouse
            </h3>
            <p class="text-xs text-[#485245] leading-relaxed">
              Layanan rancang bangun greenhouse dan tunnel garam siap tanam. Rangka presisi disesuaikan dengan jenis tanaman, lokasi lahan, dan anggaran.
            </p>
          </div>
        </div>

        <div class="px-4 sm:p-5 pt-0 pb-4">
          <div class="pt-3 border-t border-[#dedad0]/60 flex items-center justify-between text-xs font-semibold text-[#064e3b] group-hover:text-[#047857] transition-colors">
            <span>Konsultasi Pembuatan Greenhouse</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>
