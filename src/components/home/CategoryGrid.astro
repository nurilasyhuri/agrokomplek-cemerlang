---
---

<section class="py-12 lg:py-20 bg-surface-canvas border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-4 border-b border-surface-border">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-agri-700">Katalog Suplai</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-ink-primary mt-1">
          Kategori Material Pertanian & Komponen Greenhouse
        </h2>
      </div>
      <a
        href="/produk/"
        class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center gap-1 shrink-0"
      >
        <span>Lihat Semua Produk ({10} Item)</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 3 Core Categories Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Category 1: Saprodi Pertanian -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/products/plastik-uv-greenhouse.webp"
              alt="Saprodi Pertanian Pupuk dan Media Tanam"
              class="w-full h-full object-cover"
              loading="lazy"
              onerror="this.setAttribute('src', 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=600&q=80')"
            />
            <span class="absolute top-3 left-3 bg-ink-primary text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-sm">
              Saprodi Budidaya
            </span>
          </div>

          <div class="p-6">
            <h3 class="text-lg font-bold text-ink-primary mb-2">
              <a href="/produk/saprodi-pertanian/" class="hover:text-agri-700 transition-colors">
                Saprodi Pertanian
              </a>
            </h3>
            <p class="text-xs text-ink-secondary leading-relaxed mb-4">
              Sarana produksi budidaya berkualitas untuk mendukung pertumbuhan vegetatif dan generatif tanaman secara terukur.
            </p>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Pupuk NPK 16-16-16 formula seimbang</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Media tanam & nutrisi hidroponik</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Benih hortikultura & sayuran unggul</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-6 pt-0">
          <a
            href="/produk/saprodi-pertanian/"
            class="w-full py-2.5 px-4 rounded-md border border-surface-border bg-surface-subtle hover:bg-surface-border text-center text-xs font-bold text-ink-primary transition-colors block uppercase tracking-wider"
          >
            Buka Kategori Saprodi &rarr;
          </a>
        </div>
      </div>

      <!-- Category 2: Perlengkapan Pertanian -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/products/paranet-shading-net.webp"
              alt="Perlengkapan Pertanian Mulsa dan Sprayer"
              class="w-full h-full object-cover"
              loading="lazy"
              onerror="this.setAttribute('src', 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=600&q=80')"
            />
            <span class="absolute top-3 left-3 bg-ink-primary text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-sm">
              Alat Lapangan
            </span>
          </div>

          <div class="p-6">
            <h3 class="text-lg font-bold text-ink-primary mb-2">
              <a href="/produk/perlengkapan-pertanian/" class="hover:text-agri-700 transition-colors">
                Perlengkapan Pertanian
              </a>
            </h3>
            <p class="text-xs text-ink-secondary leading-relaxed mb-4">
              Peralatan kerja dan material proteksi lahan terbuka untuk efisiensi pemeliharaan tanaman hortikultura dan perkebunan.
            </p>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Sprayer elektrik 16L baterai tahan lama</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Mulsa Plastik Hitam Perak (MPHP) berbagai lebar</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Tray semai 128 lubang bahan tebal lentur</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-6 pt-0">
          <a
            href="/produk/perlengkapan-pertanian/"
            class="w-full py-2.5 px-4 rounded-md border border-surface-border bg-surface-subtle hover:bg-surface-border text-center text-xs font-bold text-ink-primary transition-colors block uppercase tracking-wider"
          >
            Buka Perlengkapan Lahan &rarr;
          </a>
        </div>
      </div>

      <!-- Category 3: Perlengkapan Greenhouse -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/greenhouse/instalasi-hidroponik.webp"
              alt="Perlengkapan Greenhouse Plastik UV dan Spring Clip"
              class="w-full h-full object-cover"
              loading="lazy"
              onerror="this.setAttribute('src', 'https://images.unsplash.com/photo-1585320806297-9794b3e4eeae?auto=format&fit=crop&w=600&q=80')"
            />
            <span class="absolute top-3 left-3 bg-agri-700 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-sm">
              Material Greenhouse
            </span>
          </div>

          <div class="p-6">
            <h3 class="text-lg font-bold text-ink-primary mb-2">
              <a href="/produk/perlengkapan-greenhouse/" class="hover:text-agri-700 transition-colors">
                Perlengkapan Greenhouse
              </a>
            </h3>
            <p class="text-xs text-ink-secondary leading-relaxed mb-4">
              Komponen teknis instalasi greenhouse standar industri, tahan radiasi ultraviolet tinggi dan angin kencang tropis.
            </p>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Plastik UV 14% & 20% ketebalan 200 mikron</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Paranet shading net kerapatan 65% - 75%</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Spring clip, profil lock, & selang drip 16mm</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-6 pt-0">
          <a
            href="/produk/perlengkapan-greenhouse/"
            class="w-full py-2.5 px-4 rounded-md border border-agri-700 bg-agri-700 hover:bg-agri-800 text-center text-xs font-bold text-white transition-colors block uppercase tracking-wider"
          >
            Buka Perlengkapan Greenhouse &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
