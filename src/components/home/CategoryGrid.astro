---
---

<section class="py-12 lg:py-20 bg-surface-canvas border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-6 border-b border-surface-border">
      <div class="space-y-2 max-w-3xl">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink-primary leading-[1.15]">
          Layanan &amp; Suplai Lengkap
        </h2>
        <p class="text-xl sm:text-2xl font-bold text-agri-700 tracking-tight">
          Satu Tempat Untuk Berbagai Kebutuhan Budidaya
        </p>
        <p class="text-sm sm:text-base text-ink-secondary leading-relaxed pt-1">
          Agrokomplek Cemerlang hadir sebagai mitra penyedia kebutuhan pertanian dan greenhouse untuk petani, nursery, pengusaha hortikultura, kontraktor, hingga pelaku agribisnis.
        </p>
      </div>
      <a
        href="/produk/"
        class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center gap-1.5 shrink-0 bg-surface-card px-4 py-2.5 rounded-md border border-surface-border"
      >
        <span>LIHAT SEMUA KATALOG</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      
      <!-- 01 — SAPRODI PERTANIAN -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/products/pupuk-npk-16-16-16.webp"
              alt="Saprodi Pertanian Pupuk NPK dan Media Tanam"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-ink-primary text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-xs">
              01 &mdash; SAPRODI PERTANIAN
            </span>
          </div>

          <div class="p-5 space-y-3">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-ink-primary leading-snug">
                <a href="/produk/saprodi-pertanian/" class="hover:text-agri-700 transition-colors">
                  Nutrisi Yang Tepat Untuk Budidaya Yang Lebih Terukur
                </a>
              </h3>
              <p class="text-xs text-ink-secondary leading-relaxed mt-2">
                Pilihan sarana produksi untuk membantu memenuhi kebutuhan tanaman pada berbagai fase pertumbuhan.
              </p>
            </div>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Pupuk NPK 16-16-16</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Media Tanam</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Nutrisi Tanaman</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Benih Hortikultura</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-5 pt-0">
          <a
            href="/produk/saprodi-pertanian/"
            class="w-full py-2.5 px-3 rounded-md border border-surface-border bg-surface-subtle hover:bg-surface-border text-center text-xs font-bold text-ink-primary transition-colors block uppercase tracking-wider"
          >
            KATALOG SAPRODI &rarr;
          </a>
        </div>
      </div>

      <!-- 02 — MATERIAL GREENHOUSE -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/products/plastik-uv-greenhouse.webp"
              alt="Material Greenhouse Plastik UV, Paranet dan Insect Net"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-agri-700 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-xs">
              02 &mdash; MATERIAL GREENHOUSE
            </span>
          </div>

          <div class="p-5 space-y-3">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-ink-primary leading-snug">
                <a href="/produk/perlengkapan-greenhouse/" class="hover:text-agri-700 transition-colors">
                  Bangun Struktur Proteksi Yang Sesuai Kebutuhan Tanaman
                </a>
              </h3>
              <p class="text-xs text-ink-secondary leading-relaxed mt-2">
                Komponen greenhouse untuk mendukung budidaya terlindungi di lingkungan tropis.
              </p>
            </div>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Plastik UV 14% &amp; 20% (hingga 200 Micron)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Paranet 65%&ndash;75%</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Insect Net hingga 50 Mesh</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Spring Clip, Profil &amp; Komponen Galvanis</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-5 pt-0">
          <a
            href="/produk/perlengkapan-greenhouse/"
            class="w-full py-2.5 px-3 rounded-md border border-agri-700 bg-agri-700 hover:bg-agri-800 text-center text-xs font-bold text-white transition-colors block uppercase tracking-wider"
          >
            MATERIAL GREENHOUSE &rarr;
          </a>
        </div>
      </div>

      <!-- 03 — IRIGASI & PERLENGKAPAN LAHAN -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/products/selang-drip-irigasi-16mm.webp"
              alt="Perlengkapan Irigasi Selang Drip dan Mulsa Pertanian"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-ink-primary text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-xs">
              03 &mdash; IRIGASI &amp; LAHAN
            </span>
          </div>

          <div class="p-5 space-y-3">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-ink-primary leading-snug">
                <a href="/produk/perlengkapan-pertanian/" class="hover:text-agri-700 transition-colors">
                  Air Lebih Terarah. Budidaya Lebih Efisien.
                </a>
              </h3>
              <p class="text-xs text-ink-secondary leading-relaxed mt-2">
                Perlengkapan pengairan, pemupukan, dan perlindungan lahan untuk berbagai skala budidaya.
              </p>
            </div>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Selang Drip 16 mm &amp; Fitting Aksesori</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Mulsa Plastik Hitam Perak (MPHP)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Sprayer Elektrik 16 L</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-agri-700 rounded-none shrink-0"></span>
                <span>Perlengkapan Hidroponik</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-5 pt-0">
          <a
            href="/produk/perlengkapan-pertanian/"
            class="w-full py-2.5 px-3 rounded-md border border-surface-border bg-surface-subtle hover:bg-surface-border text-center text-xs font-bold text-ink-primary transition-colors block uppercase tracking-wider"
          >
            LIHAT PERLENGKAPAN IRIGASI &rarr;
          </a>
        </div>
      </div>

      <!-- 04 — JASA PEMBUATAN GREENHOUSE -->
      <div class="bg-surface-card border border-surface-border rounded-lg overflow-hidden flex flex-col justify-between">
        <div>
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden border-b border-surface-border relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Jasa Pembuatan Greenhouse Galvanis dan Bambu Presisi"
              width="600"
              height="375"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-3 left-3 bg-ochre-700 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-1 rounded-xs">
              04 &mdash; JASA KONSTRUKSI
            </span>
          </div>

          <div class="p-5 space-y-3">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-ink-primary leading-snug">
                <a href="/jasa/pembuatan-greenhouse/" class="hover:text-agri-700 transition-colors">
                  Dari Lahan Kosong Menjadi Ruang Budidaya Siap Pakai
                </a>
              </h3>
              <p class="text-xs text-ink-secondary leading-relaxed mt-2">
                Kami melayani survei, perencanaan, pengadaan material, fabrikasi, hingga instalasi greenhouse sesuai kebutuhan proyek.
              </p>
            </div>

            <ul class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-ochre-700 rounded-none shrink-0"></span>
                <span>Greenhouse Bambu Presisi</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-ochre-700 rounded-none shrink-0"></span>
                <span>Greenhouse Galvanis Hot-Dip</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-ochre-700 rounded-none shrink-0"></span>
                <span>Greenhouse Baja Ringan</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-ochre-700 rounded-none shrink-0"></span>
                <span>Tunnel Garam Efisiensi</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="p-5 pt-0">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="w-full py-2.5 px-3 rounded-md border border-ochre-700 bg-ochre-700 hover:bg-ochre-800 text-center text-xs font-bold text-white transition-colors block uppercase tracking-wider"
          >
            HITUNG ESTIMASI RAB &rarr;
          </a>
        </div>
      </div>

    </div>
  </div>
</section>
