---
---

<section class="py-12 sm:py-16 bg-bg border-b border-border font-sans">
  <div class="max-w-[1200px] mx-auto px-4 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-10 border-b border-border pb-6">
      <div class="max-w-2xl">
        <h2 class="text-3xl md:text-4xl font-extrabold text-dark tracking-tight font-sans mb-3">
          Kebutuhan Pertanian dalam Satu Tempat
        </h2>
        <p class="text-sm md:text-base text-muted leading-relaxed">
          Tidak semua lahan membutuhkan material dan sistem budidaya yang sama. Karena itu, kami menyediakan beberapa kategori produk dan layanan agar Anda lebih mudah memilih kebutuhan sesuai jenis tanaman, luas lahan, sistem budidaya, dan anggaran.
        </p>
      </div>
      <a
        href="/produk/"
        class="flex items-center gap-1.5 text-xs font-bold text-primary hover:text-primary-hover group/link mt-4 md:mt-0 whitespace-nowrap"
      >
        <span>Lihat Semua Katalog</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform group-hover/link:translate-x-0.5">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- 4 Core Pillars Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
      
      <!-- 01 — SAPRODI PERTANIAN -->
      <a href="/produk/saprodi-pertanian/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/products/pupuk-npk-16-16-16.webp"
              alt="Saprodi Pertanian Pupuk NPK dan Media Tanam"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Pupuk, Benih &amp; Media Tanam
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Saprodi Pertanian
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Temukan berbagai sarana produksi pertanian untuk mendukung pertumbuhan tanaman dari fase awal hingga produksi.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Lihat Saprodi Pertanian</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 02 — MATERIAL GREENHOUSE -->
      <a href="/produk/perlengkapan-greenhouse/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/products/plastik-uv-greenhouse.webp"
              alt="Material Greenhouse Plastik UV 200 Mikron, Paranet dan Insect Net"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Plastik UV, Paranet &amp; Insect Net
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Material Greenhouse
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Tersedia berbagai pilihan material untuk membantu melindungi tanaman dari hujan, panas berlebih, serangga, serta perubahan kondisi lingkungan.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Lihat Material Greenhouse</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 03 — IRIGASI & PERLENGKAPAN LAHAN -->
      <a href="/produk/perlengkapan-pertanian/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/products/selang-drip-irigasi-16mm.webp"
              alt="Irigasi dan Perlengkapan Pertanian Selang Drip dan Mulsa"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Selang Drip, Sprayer &amp; Mulsa
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Irigasi &amp; Perlengkapan
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Bangun sistem distribusi air dan nutrisi yang lebih terkontrol untuk kebun, greenhouse, maupun budidaya hidroponik.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Lihat Perlengkapan Pertanian</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

      <!-- 04 — JASA PEMBUATAN GREENHOUSE -->
      <a href="/jasa/pembuatan-greenhouse/" class="group flex flex-col justify-between rounded-2xl sm:rounded-3xl bg-white border border-border hover:border-primary/40 hover:shadow-hover hover:-translate-y-1 transition-all duration-300 overflow-hidden">
        <div>
          <div class="aspect-[16/10] bg-secondary/50 overflow-hidden relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Jasa Pembuatan Greenhouse Bambu, Pipa Galvanis, dan Baja Ringan"
              width="600"
              height="375"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="p-5">
            <span class="text-[11px] font-semibold text-primary block mb-1">
              Perencanaan &amp; Pembangunan
            </span>
            <h3 class="text-lg font-bold text-dark leading-snug group-hover:text-primary transition-colors mb-2">
              Jasa Pembuatan Greenhouse
            </h3>
            <p class="text-xs text-muted leading-relaxed">
              Kami melayani pembuatan greenhouse untuk budidaya sayuran, melon, cabai, tomat, stroberi, nursery, hidroponik, dan agribisnis lainnya.
            </p>
          </div>
        </div>

        <div class="px-5 pb-5 pt-0">
          <div class="pt-3 border-t border-border/70 flex items-center justify-between text-xs font-bold text-primary group-hover:text-primary-hover transition-colors">
            <span>Konsultasi Pembuatan Greenhouse</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
          </div>
        </div>
      </a>

    </div>
  </div>
</section>
