---
---

<section class="py-16 sm:py-24 bg-white border-b border-border font-sans">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12">
      <span class="text-xs font-semibold text-primary block mb-1">
        Pilihan Kebutuhan
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-dark tracking-tight mb-2">
        Belanja Material atau Bangun Greenhouse?
      </h2>
      <p class="text-sm text-muted">
        Kami Bisa Membantu Keduanya
      </p>
    </div>

    <!-- 2 Pathways Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      
      <!-- Path 1: Butuh Material -->
      <div class="p-7 sm:p-9 rounded-2xl sm:rounded-3xl bg-bg border border-border hover:border-primary/40 hover:shadow-hover transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7.5 4.27 9 5.15"></path>
              <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
              <path d="m3.3 7 8.7 5 8.7-5"></path>
              <path d="M12 22V12"></path>
            </svg>
          </div>
          
          <h3 class="text-xl sm:text-2xl font-bold text-dark mb-2">
            Saya membutuhkan material
          </h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed mb-6">
            Cocok jika Anda sudah memiliki desain atau akan memasang sendiri di lahan kebun Anda.
          </p>

          <div class="space-y-2 mb-8">
            <span class="text-xs font-bold text-dark block mb-2">Temukan kebutuhan Anda:</span>
            <div class="flex flex-wrap gap-2">
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Plastik UV</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Paranet</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Insect net</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Mulsa</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Selang drip</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Saprodi</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Perlengkapan hidroponik</span>
              <span class="px-3 py-1 rounded-lg bg-white border border-border text-xs text-dark font-medium">Aksesori greenhouse</span>
            </div>
          </div>
        </div>

        <a
          href="/produk/"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-primary hover:bg-primary-hover text-white font-bold text-sm transition-all shadow-xs"
        >
          <span>Buka Katalog Produk</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- Path 2: Buat Greenhouse -->
      <div class="p-7 sm:p-9 rounded-2xl sm:rounded-3xl bg-bg border border-border hover:border-primary/40 hover:shadow-hover transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="w-12 h-12 rounded-2xl bg-peach/80 text-primary flex items-center justify-center mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 21h18"></path>
              <path d="M5 21V7l8-4v18"></path>
              <path d="M19 21V11l-6-4"></path>
            </svg>
          </div>
          
          <h3 class="text-xl sm:text-2xl font-bold text-dark mb-2">
            Saya ingin membuat greenhouse
          </h3>
          <p class="text-xs sm:text-sm text-muted leading-relaxed mb-6">
            Tim kami akan membantu menentukan kebutuhan awal proyek mulai dari desain, struktur, hingga kalkulasi anggaran.
          </p>

          <div class="space-y-2 mb-8">
            <span class="text-xs font-bold text-dark block mb-2">Ceritakan detail rencana Anda:</span>
            <ul class="space-y-2 text-xs sm:text-sm text-muted">
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Lokasi lahan proyek</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Ukuran luas lahan (panjang &times; lebar)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Komoditas yang akan ditanam</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Jenis greenhouse yang diinginkan (Bambu / Galvanis / Baja Ringan)</span>
              </li>
              <li class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-primary"></span>
                <span>Perkiraan target anggaran investasi</span>
              </li>
            </ul>
          </div>
        </div>

        <a
          href="https://wa.me/6285183002070?text=Halo%20Agrokomplek%20Cemerlang,%20saya%20ingin%20konsultasi%20pembuatan%20greenhouse."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full px-6 py-3.5 rounded-xl bg-dark hover:bg-black text-white font-bold text-sm transition-all shadow-xs"
        >
          <span>Konsultasi Greenhouse</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

    </div>

  </div>
</section>
