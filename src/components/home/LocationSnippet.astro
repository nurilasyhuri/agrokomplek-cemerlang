---
import { BUSINESS_INFO } from '../../data/businessInfo';
---

<section class="py-12 lg:py-20 bg-surface-canvas border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Text details -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-ink-primary tracking-tight leading-[1.15]">
            Toko &amp; Gudang Fisik
          </h2>
          <p class="text-xl sm:text-2xl font-bold text-agri-700 tracking-tight mt-1.5">
            Lokasi Toko &amp; Gudang Agrokomplek Cemerlang
          </p>
        </div>

        <div class="space-y-3 text-xs text-ink-secondary">
          <div class="flex items-start gap-3 p-3.5 rounded-md bg-surface-card border border-surface-border">
            <svg class="w-4 h-4 text-agri-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <span class="font-bold text-ink-primary block uppercase">Alamat Gudang & Toko:</span>
              <span class="text-ink-secondary mt-0.5 block">{BUSINESS_INFO.address.fullFormatted}</span>
            </div>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-md bg-surface-card border border-surface-border">
            <svg class="w-4 h-4 text-agri-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <div class="space-y-1">
              <span class="font-bold text-ink-primary block uppercase tracking-wider text-[11px]">Jam Operasional:</span>
              <p class="text-ink-primary font-bold text-xs">SENIN &mdash; MINGGU: 07.30 &mdash; 17.00 WIB</p>
              <p class="text-ink-muted text-xs">Konsultasi WhatsApp: 24 Jam</p>
            </div>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href={BUSINESS_INFO.geo.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-agri-700 hover:bg-agri-800 text-white font-bold text-xs uppercase tracking-wider transition-colors select-none"
          >
            <span>Buka Rute Google Maps</span>
            <span aria-hidden="true">&rarr;</span>
          </a>

          <a
            href="/lokasi/"
            class="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-md border border-surface-border bg-surface-card hover:bg-surface-subtle text-ink-primary font-bold text-xs uppercase tracking-wider transition-colors select-none"
          >
            <span>Detail Panduan Lokasi</span>
          </a>
        </div>
      </div>

      <!-- Google Maps Embed Container -->
      <div class="lg:col-span-6">
        <div class="rounded-lg overflow-hidden border border-surface-border bg-surface-subtle aspect-[4/3] relative">
          <iframe
            src="https://maps.google.com/maps?q=-7.9984,112.6456&z=15&output=embed"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Peta Lokasi Agrokomplek Cemerlang Malang"
          ></iframe>
        </div>
      </div>

    </div>
  </div>
</section>
