---
import { generateGeneralInquiryUrl } from "../../utils/whatsapp";

const waHeroUrl = generateGeneralInquiryUrl("hero-primary");
---

<section class="w-full bg-[#18181b] text-white border-b border-zinc-800 font-sans overflow-hidden py-12 sm:py-20 lg:py-24">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      
      <!-- Left Column: Copy & CTAs (7 cols) - Modeled after screenshot -->
      <div class="lg:col-span-7 text-left">
        
        <!-- Kicker Pill Badge (translucent with border & pulse dot) -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/15 text-white text-xs font-bold tracking-wider uppercase mb-6 select-none">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>READY STOCK &bull; KIRIM SE-INDONESIA</span>
        </div>

        <!-- Punchy 2-Line Headline with Colored Second Line and Periods -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black tracking-tight leading-[1.08] mb-6 text-white font-sans">
          <span>Jasa Pembuatan Greenhouse.</span><br />
          <span class="text-emerald-400">Supplier Saprodi Pertanian.</span>
        </h1>

        <!-- Subtitle / Lead Paragraph -->
        <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed mb-8 max-w-xl">
          Solusi kebutuhan greenhouse, sarana produksi pertanian, irigasi, dan perlengkapan kebun dari Malang untuk berbagai wilayah Indonesia. Tersedia plastik UV 200 mikron, paranet, insect net, selang drip, mulsa, pupuk, hingga pembuatan greenhouse bambu, galvanis, dan baja ringan.
        </p>

        <!-- Two Rounded-Full Pill Buttons (Exact shape from screenshot) -->
        <div class="flex flex-wrap items-center gap-3.5 sm:gap-4 mb-10">
          <a
            href={waHeroUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm tracking-wider uppercase shadow-lg shadow-emerald-950/50 hover:scale-[1.03] active:scale-[0.97] transition-all inline-flex items-center justify-center gap-2.5 select-none"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.678.15-.2.301-.777.978-.953 1.179-.176.2-.351.226-.652.075-1.558-.78-2.573-1.393-3.606-3.167-.272-.468.272-.435.778-1.45.084-.176.042-.326-.021-.451-.063-.125-.678-1.633-.928-2.237-.244-.588-.492-.508-.678-.518-.176-.01-.377-.01-.578-.01-.2 0-.528.075-.804.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.913 1.23 3.114.15.2 2.124 3.243 5.145 4.548 2.052.887 2.858.966 3.882.814.733-.109 2.257-.923 2.576-1.815.318-.892.318-1.656.223-1.815-.095-.16-.351-.25-.652-.401z"/>
            </svg>
            <span>Konsultasi via WhatsApp</span>
          </a>

          <a
            href="/produk/"
            class="px-8 py-4 rounded-full bg-white/10 hover:bg-white/15 text-white font-extrabold text-xs sm:text-sm tracking-wider uppercase border border-white/20 hover:border-white/40 hover:scale-[1.03] active:scale-[0.97] transition-all inline-flex items-center justify-center gap-2 select-none"
          >
            <span>Lihat Semua Katalog</span>
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Metrics Proof Strip -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-white/15 max-w-lg select-none">
          <div>
            <span class="block font-black text-2xl sm:text-3xl text-white tracking-tight leading-none mb-1">150+</span>
            <span class="text-xs font-medium text-zinc-400 leading-tight block">Greenhouse Terpasang</span>
          </div>
          <div>
            <span class="block font-black text-2xl sm:text-3xl text-white tracking-tight leading-none mb-1">100%</span>
            <span class="text-xs font-medium text-zinc-400 leading-tight block">Material Teruji</span>
          </div>
          <div>
            <span class="block font-black text-2xl sm:text-3xl text-white tracking-tight leading-none mb-1">Nusantara</span>
            <span class="text-xs font-medium text-zinc-400 leading-tight block">Pengiriman Kargo</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Pure Clean Image - GAMBAR HANYA GAMBAR SAJA, ZERO TEXT OVERLAY -->
      <div class="lg:col-span-5">
        <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl aspect-[4/3] sm:aspect-[16/11] lg:aspect-[4/5] bg-zinc-900">
          <img
            src="/images/hero-greenhouse-bg.webp"
            alt="Greenhouse Modern Agrokomplek Cemerlang Malang"
            width="800"
            height="1000"
            class="w-full h-full object-cover object-center"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

    </div>

  </div>
</section>
