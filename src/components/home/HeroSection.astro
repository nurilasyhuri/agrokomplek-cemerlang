---
import { generateGeneralInquiryUrl } from "../../utils/whatsapp";

const waHeroUrl = generateGeneralInquiryUrl("hero-slider");

const slides = [
  {
    id: "greenhouse-modern",
    tag: "KONTRAKTOR SPESIALIS GREENHOUSE",
    headlineLine1: "Jasa Pembuatan Greenhouse.",
    headlineLine2: "Struktur Kokoh & Tahan Cuaca.",
    subtitle: "Rancang bangun greenhouse modern rangka pipa galvanis, baja ringan, hingga bambu awet berstandar agribisnis. Melayani survei lahan, desain teknis, instalasi irigasi, dan pengerjaan proyek dari Malang untuk seluruh Indonesia.",
    ctaPrimaryText: "Konsultasi via WhatsApp",
    ctaPrimaryUrl: waHeroUrl,
    ctaSecondaryText: "Hitung Estimasi RAB",
    ctaSecondaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    imageWebp: "/images/hero/slides/slide-1.webp",
    imageJpg: "/images/hero/slides/slide-1.jpg",
    alt: "Konstruksi Greenhouse Galvanis Modern Agro Prima Greenhouse",
    navLabel: "Greenhouse",
    metrics: [
      { num: "150+", label: "Greenhouse Terpasang" },
      { num: "15+ Tahun", label: "Daya Tahan Struktur" },
      { num: "Nusantara", label: "Survei & Pemasangan" }
    ]
  },
  {
    id: "greenhouse-galvanis",
    tag: "STANDAR INDUSTRI KOMERSIAL",
    headlineLine1: "Greenhouse Galvanis Modern.",
    headlineLine2: "Investasi Jangka Panjang 15+ Tahun.",
    subtitle: "Struktur pipa galvanis hot-dip tahan puluhan tahun terhadap korosi iklim tropis. Dirancang khusus untuk komoditas hortikultura bernilai tinggi seperti melon hidroponik, tomat cherry, paprika, dan kebun skala industri.",
    ctaPrimaryText: "Simulasi Biaya Galvanis",
    ctaPrimaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    ctaSecondaryText: "Lihat Portofolio Proyek",
    ctaSecondaryUrl: "/proyek/",
    imageWebp: "/images/hero/slides/slide-2.webp",
    imageJpg: "/images/hero/slides/slide-2.jpg",
    alt: "Greenhouse Galvanis Hot-Dip Agro Prima Greenhouse",
    navLabel: "Galvanis",
    metrics: [
      { num: "Hot-Dip", label: "Anti Karat Maksimal" },
      { num: "15+ Tahun", label: "Usia Pakai Struktur" },
      { num: "Komersial", label: "Standar Industri" }
    ]
  },
  {
    id: "greenhouse-baja-ringan",
    tag: "EFISIENSI BIAYA & CEPAT PASANG",
    headlineLine1: "Greenhouse Baja Ringan.",
    headlineLine2: "Presisi Rapi & Ramah Anggaran.",
    subtitle: "Kombinasi rangka kanal C dan reng baja ringan anti karat dengan bentang luas dan pencahayaan merata. Pilihan efisien untuk kebun pembibitan (nursery), sayuran hidroponik, dan budidaya semi-komersial berbiaya terukur.",
    ctaPrimaryText: "Hitung RAB Baja Ringan",
    ctaPrimaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    ctaSecondaryText: "Konsultasi Teknis",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-3.webp",
    imageJpg: "/images/hero/slides/slide-3.jpg",
    alt: "Greenhouse Baja Ringan Presisi Agro Prima Greenhouse",
    navLabel: "Baja Ringan",
    metrics: [
      { num: "Cepat Pasang", label: "Instalasi Ringkas" },
      { num: "7-10 Tahun", label: "Ketahanan Rangka" },
      { num: "Presisi", label: "Bentang Rapi" }
    ]
  },
  {
    id: "greenhouse-bambu",
    tag: "INVESTASI EFISIEN PETANI",
    headlineLine1: "Greenhouse Bambu Awet.",
    headlineLine2: "Kuat, Terjangkau, & Teruji Lapangan.",
    subtitle: "Pilihan bijak untuk kelompok tani, budidaya sayuran daun, dan petani pemula. Struktur bambu pilihan dengan perlakuan anti rayap serta sistem kuncian spring clip kanal C tahan angin kencang.",
    ctaPrimaryText: "Simulasi Biaya Bambu",
    ctaPrimaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    ctaSecondaryText: "Tanya Spesifikasi",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-4.webp",
    imageJpg: "/images/hero/slides/slide-4.jpg",
    alt: "Greenhouse Bambu Kokoh Ekonomis Petani Nusantara",
    navLabel: "Bambu Awet",
    metrics: [
      { num: "Ekonomis", label: "Mulai Rp 150rb/m²" },
      { num: "Spring Clip", label: "Kuncian Tahan Angin" },
      { num: "3-5 Tahun", label: "Usia Pakai Terawat" }
    ]
  },
  {
    id: "tunnel-garam",
    tag: "INOVASI PRODUKSI PESISIR NUSANTARA",
    headlineLine1: "Tunnel Prisma Garam Higienis.",
    headlineLine2: "Panen Garam Meja Tanpa Terhenti Hujan.",
    subtitle: "Inovasi rumah kristalisasi tertutup anti-hujan dengan geomembrane HDPE dan penutup plastik UV khusus. Menghasilkan garam putih bersih kualitas super sepanjang tahun tanpa terhenti musim penghujan.",
    ctaPrimaryText: "Panduan Tunnel Garam",
    ctaPrimaryUrl: "/artikel/panduan-konstruksi-tunnel-garam/",
    ctaSecondaryText: "Konsultasi Proyek Garam",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-5.webp",
    imageJpg: "/images/hero/slides/slide-5.jpg",
    alt: "Tunnel Garam Prisma Garam Agro Prima Greenhouse",
    navLabel: "Tunnel Garam",
    metrics: [
      { num: "Bebas Hujan", label: "Panen Sepanjang Tahun" },
      { num: "Super Putih", label: "Garam Meja Higienis" },
      { num: "Pesisir", label: "Tahan Korosi Air Laut" }
    ]
  }
];
---

<section
  id="hero-slider-section"
  class="relative w-full bg-[#071322] text-white font-sans overflow-hidden min-h-[calc(100dvh-60px-56px)] md:min-h-[calc(100dvh-108px)] flex flex-col justify-between border-b border-sky-950"
  aria-label="Hero Showcase Jasa Pembuatan Greenhouse Agro Prima Greenhouse"
>
  <!-- Background Image Carousel Layers (Layer 1: Biru Dongker & Steel Greenhouse) -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none" id="hero-background-container">
    {slides.map((slide, idx) => (
      <div
        data-slide-bg={idx}
        class:list={[
          "absolute inset-0 transition-opacity duration-1000 ease-out",
          idx === 0 ? "opacity-100 z-10" : "opacity-0 z-0"
        ]}
      >
        <picture>
          <source srcset={slide.imageWebp} type="image/webp" />
          <img
            src={slide.imageJpg}
            alt={slide.alt}
            width="1600"
            height="900"
            class="w-full h-full object-cover object-center scale-105 transition-transform duration-10000 ease-out"
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </picture>
        <!-- Deep Biru Dongker Atmospheric Contrast Overlays -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#071322]/90 via-[#071322]/65 to-[#071322]/35 lg:to-[#071322]/15"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#071322] via-[#071322]/20 to-[#071322]/50"></div>
        <div class="absolute inset-0 bg-[#0284c7]/[0.05]"></div>
      </div>
    ))}
  </div>

  <!-- Foreground Content Area: Double Layer Crisp White Card on Deep Biru Dongker Base -->
  <div class="relative z-20 max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-8 lg:py-10 flex-1 flex items-center w-full">
    <div class="w-full max-w-2xl my-auto">
      {slides.map((slide, idx) => (
        <div
          data-slide-content={idx}
          class:list={[
            "transition-all duration-700 ease-out transform",
            idx === 0 ? "block opacity-100 translate-y-0" : "hidden opacity-0 translate-y-4"
          ]}
        >
          <!-- THE DOUBLE LAYER CARD: Crisp Solid White Elevated Surface -->
          <div class="bg-white text-slate-900 rounded-2xl sm:rounded-3xl p-5 sm:p-7 lg:p-8 shadow-2xl border border-slate-100 ring-1 ring-slate-900/10">
            
            <!-- Category & Tag Kicker Pill -->
            <div class="inline-flex items-center gap-1.5 sm:gap-2 px-2.5 sm:px-3 py-1 rounded-full bg-sky-50 border border-sky-200 text-sky-800 text-[10px] sm:text-xs font-extrabold tracking-wider uppercase mb-2.5 sm:mb-3.5 select-none shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-[#0284c7] animate-pulse"></span>
              <span>{slide.tag}</span>
            </div>

            <!-- Dynamic Main Headline -->
            {idx === 0 ? (
              <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-black tracking-tight leading-[1.16] mb-2.5 sm:mb-3.5 text-[#071322] font-sans">
                <span>{slide.headlineLine1}</span><br />
                <span class="text-[#0284c7]">{slide.headlineLine2}</span>
              </h1>
            ) : (
              <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-black tracking-tight leading-[1.16] mb-2.5 sm:mb-3.5 text-[#071322] font-sans">
                <span>{slide.headlineLine1}</span><br />
                <span class="text-[#0284c7]">{slide.headlineLine2}</span>
              </h2>
            )}

            <!-- Descriptive Subtitle -->
            <p class="text-xs sm:text-sm text-slate-600 font-normal leading-relaxed mb-4 sm:mb-5 line-clamp-3 sm:line-clamp-none">
              {slide.subtitle}
            </p>

            <!-- Action Buttons: Clean & Mobile-Optimized Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 sm:gap-3.5 mb-4 sm:mb-5">
              <!-- Primary CTA: Sky Blue -->
              <a
                href={slide.ctaPrimaryUrl}
                target={slide.ctaPrimaryUrl.includes("wa.me") ? "_blank" : "_self"}
                rel={slide.ctaPrimaryUrl.includes("wa.me") ? "noopener noreferrer" : undefined}
                class="w-full py-3 sm:py-3.5 px-4 rounded-xl bg-[#0284c7] hover:bg-[#0369a1] text-white font-extrabold text-xs sm:text-sm tracking-wide uppercase shadow-md shadow-sky-600/30 hover:scale-[1.01] active:scale-[0.99] transition-all inline-flex items-center justify-center gap-2 select-none"
              >
                {slide.ctaPrimaryUrl.includes("wa.me") ? (
                  <svg class="w-4 h-4 text-white shrink-0" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.678.15-.2.301-.777.978-.953 1.179-.176.2-.351.226-.652.075-1.558-.78-2.573-1.393-3.606-3.167-.272-.468.272-.435.778-1.45.084-.176.042-.326-.021-.451-.063-.125-.678-1.633-.928-2.237-.244-.588-.492-.508-.678-.518-.176-.01-.377-.01-.578-.01-.2 0-.528.075-.804.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.913 1.23 3.114.15.2 2.124 3.243 5.145 4.548 2.052.887 2.858.966 3.882.814.733-.109 2.257-.923 2.576-1.815.318-.892.318-1.656.223-1.815-.095-.16-.351-.25-.652-.401z"/>
                  </svg>
                ) : (
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                )}
                <span class="truncate">{slide.ctaPrimaryText}</span>
              </a>

              <!-- Secondary CTA: Biru Dongker Crisp Outline -->
              <a
                href={slide.ctaSecondaryUrl}
                target={slide.ctaSecondaryUrl.includes("wa.me") ? "_blank" : "_self"}
                rel={slide.ctaSecondaryUrl.includes("wa.me") ? "noopener noreferrer" : undefined}
                class="w-full py-3 sm:py-3.5 px-4 rounded-xl bg-slate-50 hover:bg-slate-100 text-[#071322] font-extrabold text-xs sm:text-sm tracking-wide uppercase border-2 border-slate-300 hover:border-[#071322] hover:scale-[1.01] active:scale-[0.99] transition-all inline-flex items-center justify-center gap-2 select-none shadow-2xs"
              >
                <span class="truncate">{slide.ctaSecondaryText}</span>
                <svg class="w-4 h-4 text-[#0284c7] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>

            <!-- Slide Specific Metrics Strip (Integrated cleanly inside the card) -->
            <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-3.5 sm:pt-4 border-t border-slate-100 select-none">
              {slide.metrics.map(metric => (
                <div>
                  <span class="block font-black text-lg sm:text-xl lg:text-2xl text-[#071322] tracking-tight leading-none mb-1">
                    {metric.num}
                  </span>
                  <span class="text-[10px] sm:text-xs font-medium text-slate-500 leading-tight block truncate">
                    {metric.label}
                  </span>
                </div>
              ))}
            </div>

          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Bottom Interactive Bar: Tab Progress Indicators & Arrow Controls (Biru Dongker Base) -->
  <div class="relative z-30 w-full border-t border-white/10 bg-[#071322]/95 backdrop-blur-md shrink-0 mb-14 md:mb-0">
    <div class="max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-3 flex items-center justify-between gap-2 sm:gap-4">
      
      <!-- 5 Interactive Horizontal Progress Tabs -->
      <div class="flex items-center gap-1.5 sm:gap-2.5 w-full sm:w-auto overflow-x-auto no-scrollbar py-0.5" id="hero-slider-tabs">
        {slides.map((slide, idx) => (
          <button
            type="button"
            data-tab-target={idx}
            aria-label={`Pindah ke slide ${idx + 1}: ${slide.navLabel}`}
            class:list={[
              "group flex flex-col items-start text-left cursor-pointer transition-all duration-300 rounded-lg p-1.5 sm:px-3 sm:py-1.5 select-none focus:outline-none shrink-0",
              idx === 0 ? "bg-white/15 border border-sky-400/40 shadow-xs" : "hover:bg-white/5 opacity-60 hover:opacity-100"
            ]}
          >
            <!-- Progress Pill Line -->
            <div class="w-10 sm:w-16 md:w-24 h-1 sm:h-1.5 bg-white/20 rounded-full overflow-hidden mb-1 relative">
              <div
                data-tab-fill={idx}
                class:list={[
                  "h-full bg-[#38bdf8] rounded-full transition-all duration-300",
                  idx === 0 ? "w-full" : "w-0"
                ]}
              ></div>
            </div>
            <!-- Tab Text Label -->
            <div class="flex items-center gap-1 sm:gap-1.5">
              <span class="text-[9px] sm:text-[10px] font-mono font-bold text-sky-200">
                0{idx + 1}
              </span>
              <span class="text-[10px] sm:text-xs font-bold text-white tracking-wide truncate max-w-[70px] sm:max-w-none">
                {slide.navLabel}
              </span>
            </div>
          </button>
        ))}
      </div>

      <!-- Arrow Controls (Prev & Next) -->
      <div class="hidden sm:flex items-center gap-2 shrink-0">
        <button
          type="button"
          id="hero-prev-btn"
          aria-label="Slide sebelumnya"
          class="p-2 sm:p-2.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all hover:scale-105 active:scale-95 cursor-pointer shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>
        <button
          type="button"
          id="hero-next-btn"
          aria-label="Slide berikutnya"
          class="p-2 sm:p-2.5 rounded-full bg-white/10 hover:bg-white/20 border border-white/20 text-white transition-all hover:scale-105 active:scale-95 cursor-pointer shadow-xs"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  function initHeroSlider() {
    const section = document.getElementById("hero-slider-section");
    if (!section) return;

    const bgSlides = section.querySelectorAll<HTMLElement>("[data-slide-bg]");
    const contentSlides = section.querySelectorAll<HTMLElement>("[data-slide-content]");
    const tabButtons = section.querySelectorAll<HTMLElement>("[data-tab-target]");
    const tabFills = section.querySelectorAll<HTMLElement>("[data-tab-fill]");
    const prevBtn = document.getElementById("hero-prev-btn");
    const nextBtn = document.getElementById("hero-next-btn");

    const totalSlides = bgSlides.length;
    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let timer: NodeJS.Timeout | null = null;
    let autoPlayInterval = 6500; // 6.5s per slide
    let isPaused = false;

    function goToSlide(targetIndex: number) {
      if (targetIndex === currentIndex) return;

      currentIndex = (targetIndex + totalSlides) % totalSlides;

      // 1. Update Backgrounds
      bgSlides.forEach((bg, i) => {
        if (i === currentIndex) {
          bg.classList.remove("opacity-0", "z-0");
          bg.classList.add("opacity-100", "z-10");
        } else {
          bg.classList.remove("opacity-100", "z-10");
          bg.classList.add("opacity-0", "z-0");
        }
      });

      // 2. Update Content
      contentSlides.forEach((content, i) => {
        if (i === currentIndex) {
          content.classList.remove("hidden");
          setTimeout(() => {
            content.classList.remove("opacity-0", "translate-y-4");
            content.classList.add("opacity-100", "translate-y-0");
          }, 20);
        } else {
          content.classList.remove("opacity-100", "translate-y-0");
          content.classList.add("opacity-0", "translate-y-4");
          setTimeout(() => {
            if (i !== currentIndex) content.classList.add("hidden");
          }, 350);
        }
      });

      // 3. Update Tabs & Progress Fill
      tabButtons.forEach((tab, i) => {
        if (i === currentIndex) {
          tab.classList.add("bg-white/15", "border", "border-sky-400/40", "shadow-xs");
          tab.classList.remove("opacity-60");
        } else {
          tab.classList.remove("bg-white/15", "border", "border-sky-400/40", "shadow-xs");
          tab.classList.add("opacity-60");
        }
      });

      tabFills.forEach((fill, i) => {
        if (i === currentIndex) {
          fill.classList.remove("w-0");
          fill.classList.add("w-full");
        } else {
          fill.classList.remove("w-full");
          fill.classList.add("w-0");
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, autoPlayInterval);
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Attach Click Events to Tabs
    tabButtons.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = parseInt(tab.getAttribute("data-tab-target") || "0", 10);
        goToSlide(target);
        startAutoPlay();
      });
    });

    // Attach Controls
    prevBtn?.addEventListener("click", () => {
      prevSlide();
      startAutoPlay();
    });

    nextBtn?.addEventListener("click", () => {
      nextSlide();
      startAutoPlay();
    });

    // Pause on Hover
    section.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    section.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    // Touch Swipe Support for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    section.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    section.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchStartX - touchEndX;
        if (Math.abs(diffX) > 45) {
          if (diffX > 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          startAutoPlay();
        }
      },
      { passive: true }
    );

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      if (document.activeElement?.tagName === "INPUT") return;
      if (e.key === "ArrowRight") {
        nextSlide();
        startAutoPlay();
      } else if (e.key === "ArrowLeft") {
        prevSlide();
        startAutoPlay();
      }
    });

    startAutoPlay();
  }

  initHeroSlider();
  document.addEventListener("astro:page-load", initHeroSlider);
</script>
