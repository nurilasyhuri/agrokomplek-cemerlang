---
import { generateGeneralInquiryUrl } from "../../utils/whatsapp";

const waHeroUrl = generateGeneralInquiryUrl("hero-slider");

const slides = [
  {
    id: "solusi-terpadu",
    tag: "PUSAT PERLENGKAPAN PERTANIAN & JASA GREENHOUSE",
    headlineLine1: "Solusi Pertanian Terpadu.",
    headlineLine2: "Material Hingga Greenhouse Siap Tanam.",
    subtitle: "Sedia saprodi lengkap, plastik UV 200 mikron, paranet, selang drip irigasi, hingga paket rancang bangun greenhouse bambu, baja ringan, galvanis, dan tunnel garam dari Malang untuk seluruh Indonesia.",
    ctaPrimaryText: "Konsultasi via WhatsApp",
    ctaPrimaryUrl: waHeroUrl,
    ctaSecondaryText: "Lihat Katalog Produk",
    ctaSecondaryUrl: "/produk/",
    imageWebp: "/images/hero/slides/slide-1.webp",
    imageJpg: "/images/hero/slides/slide-1.jpg",
    alt: "Pusat Perlengkapan Pertanian dan Jasa Pembuatan Greenhouse Agrokomplek Cemerlang",
    navLabel: "Solusi Terpadu",
    metrics: [
      { num: "100+", label: "Proyek Terpasang" },
      { num: "Lengkap", label: "Saprodi & Material" },
      { num: "Nusantara", label: "Kirim Kargo & Pasang" }
    ]
  },
  {
    id: "paket-siap-tanam",
    tag: "PAKET HEMAT & TERIMA BERES",
    headlineLine1: "Paket Pembuatan Greenhouse.",
    headlineLine2: "Rangka Kokoh Plus Sistem Fertigasi.",
    subtitle: "Tidak perlu repot belanja bahan dan cari tukang terpisah. Dapatkan paket pembangunan greenhouse lengkap dengan atap plastik UV anti-drip dan instalasi irigasi tetes siap pakai.",
    ctaPrimaryText: "Simulasi Biaya Paket",
    ctaPrimaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    ctaSecondaryText: "Konsultasi Lahan",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-2.webp",
    imageJpg: "/images/hero/slides/slide-2.jpg",
    alt: "Paket Pembuatan Greenhouse dan Fertigasi Agrokomplek Cemerlang",
    navLabel: "Paket Greenhouse",
    metrics: [
      { num: "Siap Tanam", label: "Bonus Setting Fertigasi" },
      { num: "Transparan", label: "RAB Tanpa Biaya Siluman" },
      { num: "Garansi", label: "Material Teruji Tropis" }
    ]
  },
  {
    id: "material-greenhouse",
    tag: "SUPPLIER LANGSUNG DARI GUDANG",
    headlineLine1: "Plastik UV, Paranet & Aksesoris.",
    headlineLine2: "Eceran Meteran Maupun Grosir Rol.",
    subtitle: "Plastik UV 14%-20% 200 mikron, paranet 65%-85%, insect net, mulsa hitam perak, selang drip, dan spring clip lock. Stok ready di gudang Malang, siap kirim kargo murah se-Indonesia.",
    ctaPrimaryText: "Katalog Perlengkapan",
    ctaPrimaryUrl: "/produk/perlengkapan-greenhouse/",
    ctaSecondaryText: "Cek Ongkir Kargo",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-3.webp",
    imageJpg: "/images/hero/slides/slide-3.jpg",
    alt: "Grosir Plastik UV Paranet dan Perlengkapan Greenhouse Agrokomplek Cemerlang",
    navLabel: "Material & Saprodi",
    metrics: [
      { num: "200 µm", label: "Plastik UV Tebal" },
      { num: "Ready Stok", label: "Gudang Fisik Malang" },
      { num: "Kargo Murah", label: "Tarif Khusus Rol Besar" }
    ]
  },
  {
    id: "tunnel-garam",
    tag: "SPESIALIS TEKNOLOGI GARAM PESISIR",
    headlineLine1: "Jasa Pembuatan Tunnel Garam.",
    headlineLine2: "Panen Garam Putih Tanpa Takut Hujan.",
    subtitle: "Inovasi rumah kristalisasi tertutup dengan geomembrane HDPE dan plastik UV tahan korosi uap air laut. Panen garam meja kualitas super sepanjang tahun tanpa khawatir cuaca mendung.",
    ctaPrimaryText: "Konsultasi Tunnel Garam",
    ctaPrimaryUrl: waHeroUrl,
    ctaSecondaryText: "Panduan Tunnel Garam",
    ctaSecondaryUrl: "/artikel/panduan-konstruksi-tunnel-garam/",
    imageWebp: "/images/hero/slides/slide-5.webp",
    imageJpg: "/images/hero/slides/slide-5.jpg",
    alt: "Konstruksi Tunnel Garam Prisma Agrokomplek Cemerlang",
    navLabel: "Tunnel Garam",
    metrics: [
      { num: "Anti Hujan", label: "Panen Sepanjang Musim" },
      { num: "Super Putih", label: "Garam Meja Higienis" },
      { num: "Tahan Asin", label: "Rangka Anti Korosi" }
    ]
  },
  {
    id: "greenhouse-bambu-bajaringan",
    tag: "RAMAH ANGGARAN PETANI INDONESIA",
    headlineLine1: "Greenhouse Bambu & Baja Ringan.",
    headlineLine2: "Presisi Rapi, Kuat, & Ramah Biaya.",
    subtitle: "Solusi hemat bagi kelompok tani, nursery sayuran, dan agribisnis pemula. Rangka bambu awet anti-rayap atau baja ringan galvanis dengan sistem jepit spring clip tahan angin kencang.",
    ctaPrimaryText: "Hitung Biaya Rangka",
    ctaPrimaryUrl: "/jasa/pembuatan-greenhouse/#kalkulator",
    ctaSecondaryText: "Tanya Spesifikasi",
    ctaSecondaryUrl: waHeroUrl,
    imageWebp: "/images/hero/slides/slide-4.webp",
    imageJpg: "/images/hero/slides/slide-4.jpg",
    alt: "Greenhouse Rangka Bambu dan Baja Ringan Agrokomplek Cemerlang",
    navLabel: "Bambu & Baja",
    metrics: [
      { num: "Ekonomis", label: "Investasi Terjangkau" },
      { num: "Cepat Pasang", label: "Sistem Knockdown" },
      { num: "Kuat", label: "Kuncian Spring Clip" }
    ]
  }
];
---

<section
  id="hero-slider-section"
  class="relative w-full bg-[#efebe2] text-[#1b2819] font-sans overflow-hidden min-h-[560px] lg:min-h-[620px] flex flex-col justify-center border-b border-[#dedad0]"
  aria-label="Hero Showcase Pusat Perlengkapan Pertanian & Jasa Greenhouse Agrokomplek Cemerlang"
>
  <!-- Background Image Carousel Layers -->
  <div class="absolute inset-0 z-0 overflow-hidden select-none" id="hero-background-container">
    {slides.map((slide, idx) => (
      <div
        data-slide-bg={idx}
        class:list={[
          "absolute inset-0 transition-opacity duration-1000 ease-out",
          idx === 0 ? "opacity-100 z-10" : "opacity-0 z-0"
        ]}
      >
        <picture>
          <source srcset={slide.imageWebp} type="image/webp" />
          <img
            src={slide.imageJpg}
            alt={slide.alt}
            width="1600"
            height="900"
            class="w-full h-full object-cover object-center scale-105 transition-transform duration-10000 ease-out"
            loading={idx === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </picture>
        <!-- Layered Organic Botanical Overlays for Warmth & Crisp Text Legibility -->
        <!-- 1. Warm cream lateral gradient: solid legible ground on left, natural photograph reveal on right -->
        <div class="absolute inset-0 bg-gradient-to-r from-[#efebe2] via-[#efebe2]/95 via-45% to-[#efebe2]/30 lg:to-transparent"></div>
        <!-- 2. Vertical top and bottom gradients for seamless header and tab blending -->
        <div class="absolute inset-0 bg-gradient-to-t from-[#efebe2] via-transparent to-[#efebe2]/40"></div>
        <!-- 3. Soft ambient botanical green tint -->
        <div class="absolute inset-0 bg-[#064e3b]/5 mix-blend-multiply"></div>
      </div>
    ))}
  </div>

  <!-- Foreground Content Area -->
  <div class="relative z-20 max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 lg:py-20 flex-1 flex items-center w-full">
    <div class="w-full max-w-3xl text-left my-auto">
      {slides.map((slide, idx) => (
        <div
          data-slide-content={idx}
          class:list={[
            "transition-all duration-700 ease-out transform",
            idx === 0 ? "block opacity-100 translate-y-0" : "hidden opacity-0 translate-y-4"
          ]}
        >
          <!-- Category & Tag Kicker Pill -->
          <div class="inline-flex items-center gap-2 px-3 sm:px-3.5 py-1.5 rounded-full bg-[#e4e5da] border border-[#dedad0] text-[#064e3b] text-[10px] sm:text-xs font-bold tracking-wider uppercase mb-3.5 sm:mb-4 select-none shadow-2xs">
            <span>{slide.tag}</span>
          </div>

          <!-- Dynamic Main Headline (Single authoritative H1 on slide 0) -->
          {idx === 0 ? (
            <h1 class="text-3xl sm:text-4xl lg:text-[44px] xl:text-[50px] font-black tracking-tight leading-[1.12] mb-3.5 sm:mb-4 font-sans">
              <span class="text-[#1b2819]">{slide.headlineLine1}</span><br />
              <span class="text-[#064e3b]">{slide.headlineLine2}</span>
            </h1>
          ) : (
            <h2 class="text-3xl sm:text-4xl lg:text-[44px] xl:text-[50px] font-black tracking-tight leading-[1.12] mb-3.5 sm:mb-4 font-sans">
              <span class="text-[#1b2819]">{slide.headlineLine1}</span><br />
              <span class="text-[#064e3b]">{slide.headlineLine2}</span>
            </h2>
          )}

          <!-- Descriptive Subtitle -->
          <p class="text-xs sm:text-sm lg:text-base text-[#485245] font-normal leading-relaxed mb-5 sm:mb-6 max-w-2xl">
            {slide.subtitle}
          </p>

          <!-- Action Buttons Group -->
          <div class="flex flex-wrap items-center gap-3 sm:gap-4 mb-5 sm:mb-6">
            <!-- Primary CTA -->
            <a
              href={slide.ctaPrimaryUrl}
              target={slide.ctaPrimaryUrl.includes("wa.me") ? "_blank" : "_self"}
              rel={slide.ctaPrimaryUrl.includes("wa.me") ? "noopener noreferrer" : undefined}
              class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-[#064e3b] hover:bg-[#047857] text-white font-extrabold text-xs sm:text-sm tracking-wider uppercase shadow-md hover:shadow-lg hover:scale-[1.02] active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2.5 select-none border border-[#064e3b]"
            >
              {slide.ctaPrimaryUrl.includes("wa.me") ? (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.477-.15-.678.15-.2.301-.777.978-.953 1.179-.176.2-.351.226-.652.075-1.558-.78-2.573-1.393-3.606-3.167-.272-.468.272-.435.778-1.45.084-.176.042-.326-.021-.451-.063-.125-.678-1.633-.928-2.237-.244-.588-.492-.508-.678-.518-.176-.01-.377-.01-.578-.01-.2 0-.528.075-.804.376-.276.301-1.054 1.03-1.054 2.512 0 1.482 1.079 2.913 1.23 3.114.15.2 2.124 3.243 5.145 4.548 2.052.887 2.858.966 3.882.814.733-.109 2.257-.923 2.576-1.815.318-.892.318-1.656.223-1.815-.095-.16-.351-.25-.652-.401z"/>
                </svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              )}
              <span>{slide.ctaPrimaryText}</span>
            </a>

            <!-- Secondary CTA -->
            <a
              href={slide.ctaSecondaryUrl}
              target={slide.ctaSecondaryUrl.includes("wa.me") ? "_blank" : "_self"}
              rel={slide.ctaSecondaryUrl.includes("wa.me") ? "noopener noreferrer" : undefined}
              class="px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-white hover:bg-[#e4e5da] text-[#1b2819] font-extrabold text-xs sm:text-sm tracking-wider uppercase border border-[#dedad0] hover:border-[#c8c3b7] shadow-2xs hover:shadow-xs hover:scale-[1.02] active:scale-[0.98] transition-all inline-flex items-center justify-center gap-2 select-none"
            >
              <span>{slide.ctaSecondaryText}</span>
              <svg class="w-4 h-4 text-[#064e3b]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>

          <!-- Slide Specific Metrics Strip -->
          <div class="grid grid-cols-3 gap-3 sm:gap-6 pt-4 border-t border-[#dedad0] max-w-lg select-none">
            {slide.metrics.map(metric => (
              <div>
                <span class="block font-black text-xl sm:text-2xl lg:text-3xl text-[#1b2819] tracking-tight leading-none mb-1">
                  {metric.num}
                </span>
                <span class="text-[11px] sm:text-xs font-medium text-[#485245] leading-tight block">
                  {metric.label}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>


</section>

<script>
  function initHeroSlider() {
    const section = document.getElementById("hero-slider-section");
    if (!section) return;

    const bgSlides = section.querySelectorAll<HTMLElement>("[data-slide-bg]");
    const contentSlides = section.querySelectorAll<HTMLElement>("[data-slide-content]");
    const tabButtons = section.querySelectorAll<HTMLElement>("[data-tab-target]");
    const tabFills = section.querySelectorAll<HTMLElement>("[data-tab-fill]");
    const prevBtn = document.getElementById("hero-prev-btn");
    const nextBtn = document.getElementById("hero-next-btn");

    const totalSlides = bgSlides.length;
    if (totalSlides <= 1) return;

    let currentIndex = 0;
    let timer: NodeJS.Timeout | null = null;
    let autoPlayInterval = 6500; // 6.5s per slide
    let isPaused = false;

    function goToSlide(targetIndex: number) {
      if (targetIndex === currentIndex) return;

      currentIndex = (targetIndex + totalSlides) % totalSlides;

      // 1. Update Backgrounds
      bgSlides.forEach((bg, i) => {
        if (i === currentIndex) {
          bg.classList.remove("opacity-0", "z-0");
          bg.classList.add("opacity-100", "z-10");
        } else {
          bg.classList.remove("opacity-100", "z-10");
          bg.classList.add("opacity-0", "z-0");
        }
      });

      // 2. Update Content
      contentSlides.forEach((content, i) => {
        if (i === currentIndex) {
          content.classList.remove("hidden");
          setTimeout(() => {
            content.classList.remove("opacity-0", "translate-y-4");
            content.classList.add("opacity-100", "translate-y-0");
          }, 20);
        } else {
          content.classList.remove("opacity-100", "translate-y-0");
          content.classList.add("opacity-0", "translate-y-4");
          setTimeout(() => {
            if (i !== currentIndex) content.classList.add("hidden");
          }, 350);
        }
      });

      // 3. Update Tabs & Progress Fill
      tabButtons.forEach((tab, i) => {
        if (i === currentIndex) {
          tab.classList.add("bg-white", "border-[#dedad0]", "shadow-2xs");
          tab.classList.remove("border-transparent", "opacity-70");
        } else {
          tab.classList.remove("bg-white", "border-[#dedad0]", "shadow-2xs");
          tab.classList.add("border-transparent", "opacity-70");
        }
      });

      tabFills.forEach((fill, i) => {
        if (i === currentIndex) {
          fill.classList.remove("w-0");
          fill.classList.add("w-full");
        } else {
          fill.classList.remove("w-full");
          fill.classList.add("w-0");
        }
      });
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startAutoPlay() {
      stopAutoPlay();
      timer = setInterval(() => {
        if (!isPaused) {
          nextSlide();
        }
      }, autoPlayInterval);
    }

    function stopAutoPlay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Attach Click Events to Tabs
    tabButtons.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = parseInt(tab.getAttribute("data-tab-target") || "0", 10);
        goToSlide(target);
        startAutoPlay();
      });
    });

    // Attach Controls
    prevBtn?.addEventListener("click", () => {
      prevSlide();
      startAutoPlay();
    });

    nextBtn?.addEventListener("click", () => {
      nextSlide();
      startAutoPlay();
    });

    // Pause on Hover
    section.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    section.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    // Touch Swipe Support for Mobile
    let touchStartX = 0;
    let touchEndX = 0;

    section.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );

    section.addEventListener(
      "touchend",
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchStartX - touchEndX;
        if (Math.abs(diffX) > 45) {
          if (diffX > 0) {
            nextSlide();
          } else {
            prevSlide();
          }
          startAutoPlay();
        }
      },
      { passive: true }
    );

    // Keyboard navigation
    window.addEventListener("keydown", (e) => {
      if (document.activeElement?.tagName === "INPUT") return;
      if (e.key === "ArrowRight") {
        nextSlide();
        startAutoPlay();
      } else if (e.key === "ArrowLeft") {
        prevSlide();
        startAutoPlay();
      }
    });

    startAutoPlay();
  }

  initHeroSlider();
  document.addEventListener("astro:page-load", initHeroSlider);
</script>
