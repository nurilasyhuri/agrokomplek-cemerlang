---
---

<section class="bg-secondary/60 border-y border-border py-6 sm:py-8 font-sans">
  <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
      
      <!-- Feature 1: Toko & Gudang Malang -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 flex-shrink-0 bg-peach text-primary flex items-center justify-center rounded-xl shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-dark text-xs sm:text-sm leading-snug">Gudang Fisik Malang</h3>
          <p class="text-[11px] text-muted font-medium mt-0.5">Bisa cek sampel di Kedungkandang</p>
        </div>
      </div>

      <!-- Feature 2: Material Teruji & Bergaransi -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 flex-shrink-0 bg-peach text-primary flex items-center justify-center rounded-xl shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-dark text-xs sm:text-sm leading-snug">Material Berstandar</h3>
          <p class="text-[11px] text-muted font-medium mt-0.5">Plastik UV 200µm &amp; Paranet awet</p>
        </div>
      </div>

      <!-- Feature 3: Kontraktor Berpengalaman -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 flex-shrink-0 bg-peach text-primary flex items-center justify-center rounded-xl shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-dark text-xs sm:text-sm leading-snug">Kontraktor Bergaransi</h3>
          <p class="text-[11px] text-muted font-medium mt-0.5">RAB transparan, teknisi ahli lapangan</p>
        </div>
      </div>

      <!-- Feature 4: Kargo Seluruh Indonesia -->
      <div class="flex items-center gap-3">
        <div class="w-11 h-11 flex-shrink-0 bg-peach text-primary flex items-center justify-center rounded-xl shadow-xs">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
            <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
            <path d="M15 18H9"></path>
            <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
            <circle cx="17" cy="18" r="2"></circle>
            <circle cx="7" cy="18" r="2"></circle>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-dark text-xs sm:text-sm leading-snug">Kargo se-Indonesia</h3>
          <p class="text-[11px] text-muted font-medium mt-0.5">Packing aman peti kayu &amp; terpal</p>
        </div>
      </div>

    </div>
  </div>
</section>
