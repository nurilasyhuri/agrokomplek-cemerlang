---
---

<section class="bg-[#e4e5da] border-b border-[#dedad0] py-6 sm:py-7 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
      
      <!-- Feature 1: Toko & Gudang Malang -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-[#dedad0] text-[#064e3b] flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-[#1b2819] text-xs sm:text-sm leading-snug">Toko Fisik &amp; Gudang Malang</h3>
          <p class="text-[11px] text-[#485245] font-normal mt-0.5">Bisa cek sampel &amp; belanja di Kedungkandang</p>
        </div>
      </div>

      <!-- Feature 2: Saprodi & Material Lengkap -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-[#dedad0] text-[#064e3b] flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-[#1b2819] text-xs sm:text-sm leading-snug">Saprodi &amp; Material Lengkap</h3>
          <p class="text-[11px] text-[#485245] font-normal mt-0.5">Pupuk, benih, plastik UV &amp; perlengkapan</p>
        </div>
      </div>

      <!-- Feature 3: Paket Siap Tanam & Fertigasi -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-[#dedad0] text-[#064e3b] flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-[#1b2819] text-xs sm:text-sm leading-snug">Paket Siap Tanam &amp; Fertigasi</h3>
          <p class="text-[11px] text-[#485245] font-normal mt-0.5">RAB transparan, siap pasang sistem drip</p>
        </div>
      </div>

      <!-- Feature 4: Kargo & Pasang se-Indonesia -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-[#dedad0] text-[#064e3b] flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 18V6a2 2 0 00-2-2H4a2 2 0 00-2 2v11a1 1 0 001 1h2m9 0H9m10 0h2a1 1 0 001-1v-3.65a1 1 0 00-.22-.624l-3.48-4.35A1 1 0 0017.52 8H14M17 18a2 2 0 100-4 2 2 0 000 4zm-10 0a2 2 0 100-4 2 2 0 000 4z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-bold text-[#1b2819] text-xs sm:text-sm leading-snug">Kirim &amp; Pasang se-Indonesia</h3>
          <p class="text-[11px] text-[#485245] font-normal mt-0.5">Kargo murah rol besar &amp; teknisi lapangan</p>
        </div>
      </div>

    </div>
  </div>
</section>
