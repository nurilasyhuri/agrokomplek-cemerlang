---
---

<section class="bg-zinc-50 border-b border-zinc-200/80 py-6 sm:py-7 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-6">
      
      <!-- Feature 1: Workshop & Kantor Malang -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-zinc-200/80 text-emerald-700 flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-zinc-900 text-xs sm:text-sm leading-snug">Workshop Fisik Malang</h3>
          <p class="text-[11px] text-zinc-500 font-normal mt-0.5">Bisa cek sampel rangka di Kedungkandang</p>
        </div>
      </div>

      <!-- Feature 2: Material Teruji & Bergaransi -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-zinc-200/80 text-emerald-700 flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-zinc-900 text-xs sm:text-sm leading-snug">Material Berstandar SNI</h3>
          <p class="text-[11px] text-zinc-500 font-normal mt-0.5">Plastik UV 200µm &amp; Rangka kokoh</p>
        </div>
      </div>

      <!-- Feature 3: Kontraktor Berpengalaman -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-zinc-200/80 text-emerald-700 flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-zinc-900 text-xs sm:text-sm leading-snug">Rancang Bangun Presisi</h3>
          <p class="text-[11px] text-zinc-500 font-normal mt-0.5">RAB transparan, teknisi ahli lapangan</p>
        </div>
      </div>

      <!-- Feature 4: Kargo Seluruh Indonesia -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 shrink-0 bg-white border border-zinc-200/80 text-emerald-700 flex items-center justify-center rounded-lg shadow-2xs">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 18V6a2 2 0 00-2-2H4a2 2 0 00-2 2v11a1 1 0 001 1h2m9 0H9m10 0h2a1 1 0 001-1v-3.65a1 1 0 00-.22-.624l-3.48-4.35A1 1 0 0017.52 8H14M17 18a2 2 0 100-4 2 2 0 000 4zm-10 0a2 2 0 100-4 2 2 0 000 4z"></path>
          </svg>
        </div>
        <div>
          <h3 class="font-semibold text-zinc-900 text-xs sm:text-sm leading-snug">Instalasi se-Indonesia</h3>
          <p class="text-[11px] text-zinc-500 font-normal mt-0.5">Survei lahan &amp; pengiriman kargo aman</p>
        </div>
      </div>

    </div>
  </div>
</section>
