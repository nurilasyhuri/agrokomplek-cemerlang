---
import { generateGeneralInquiryUrl } from '../../utils/whatsapp';

const waConsultUrl = generateGeneralInquiryUrl('service-highlight');
---

<section class="py-14 sm:py-20 bg-zinc-50/50 border-b border-zinc-200/80 font-sans">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Shopify Clean Minimalist Style) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 sm:mb-12 pb-6 border-b border-zinc-200/80 gap-4">
      <div class="max-w-2xl">
        <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block mb-1">
          Jasa Pembuatan Greenhouse
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-zinc-900 tracking-tight">
          Greenhouse yang Dirancang Sesuai Lahan, Komoditas &amp; Anggaran
        </h2>
        <p class="text-xs sm:text-sm text-zinc-600 font-normal leading-relaxed mt-2">
          Pembuatan greenhouse tidak hanya tentang memilih jenis pipa atau bambu. Ukuran lahan, kecepatan angin tropis, orientasi sinar matahari, ventilasi monitor roof, atap plastik UV anti-drip, dan sistem fertigasi harus dirancang presisi sejak awal.
        </p>
      </div>
      <a
        href="/jasa/pembuatan-greenhouse/#kalkulator"
        class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition-colors shrink-0"
      >
        <span>Kalkulator RAB Online</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

    <!-- 4 Greenhouse Types Technical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mb-12 sm:mb-14">
      
      <!-- Type 1: Bambu -->
      <div class="group flex flex-col justify-between rounded-xl bg-white border border-zinc-200/80 hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 p-4 sm:p-5">
        <div>
          <!-- Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-lg bg-zinc-50 border border-zinc-100 mb-3.5">
            <img
              src="/images/greenhouse/greenhouse-bambu.webp"
              alt="Konstruksi Greenhouse Rangka Bambu Agro Prima Greenhouse"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-100 mb-2">
            <span class="text-[11px] font-bold text-emerald-800">Tipe 01 &bull; Bambu</span>
            <span class="text-[10px] font-medium text-zinc-600 bg-zinc-100 px-2 py-0.5 rounded-full">
              Ekonomis
            </span>
          </div>

          <h3 class="text-base font-bold text-zinc-900 mb-1.5 group-hover:text-emerald-700 transition-colors">
            Greenhouse Bambu Awet
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed mb-3.5">
            Pilihan ramah anggaran bagi kelompok tani dan pemula. Struktur bambu ori pilihan yang diawetkan dengan kuncian spring clip tahan terpaan angin.
          </p>

          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-100 pt-3">
            <p><span class="font-semibold text-zinc-900">Cocok untuk:</span> Sayuran daun, pembibitan, melon pemula</p>
            <p><span class="font-semibold text-zinc-900">Daya tahan:</span> 3 - 5 Tahun</p>
            <p><span class="font-semibold text-zinc-900">Penutup:</span> Plastik UV 14% &amp; Kasa Insect Net</p>
          </div>
        </div>

        <div class="pt-3.5 mt-3.5 border-t border-zinc-100">
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agro%20Prima%20Greenhouse%2C%20saya%20ingin%20konsultasi%20pembuatan%20Greenhouse%20Bambu."
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Konsultasi Greenhouse Bambu</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 2: Galvanis (Komersial) -->
      <div class="group flex flex-col justify-between rounded-xl bg-white border-2 border-emerald-600/70 hover:border-emerald-600 shadow-2xs hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 p-4 sm:p-5 relative">
        <div>
          <!-- Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-lg bg-zinc-50 border border-zinc-100 mb-3.5">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Konstruksi Greenhouse Pipa Galvanis Komersial"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-100 mb-2">
            <span class="text-[11px] font-bold text-emerald-800">Tipe 02 &bull; Standar Industri</span>
            <span class="text-[10px] font-bold bg-emerald-50 text-emerald-800 px-2 py-0.5 rounded-full border border-emerald-200/60">
              Paling Populer
            </span>
          </div>

          <h3 class="text-base font-bold text-zinc-900 mb-1.5 group-hover:text-emerald-700 transition-colors">
            Greenhouse Pipa Galvanis
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed mb-3.5">
            Investasi jangka panjang komersial dengan pipa galvanis hot-dip anti karat. Dirancang khusus untuk budidaya intensif bernilai ekonomi tinggi.
          </p>

          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-100 pt-3">
            <p><span class="font-semibold text-zinc-900">Cocok untuk:</span> Melon hidroponik, paprika, stroberi, tomat</p>
            <p><span class="font-semibold text-zinc-900">Daya tahan:</span> 10 - 15+ Tahun</p>
            <p><span class="font-semibold text-zinc-900">Fitur:</span> Monitor roof ventilation, sambungan klem tanpa las</p>
          </div>
        </div>

        <div class="pt-3.5 mt-3.5 border-t border-zinc-100">
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agro%20Prima%20Greenhouse%2C%20saya%20ingin%20konsultasi%20pembuatan%20Greenhouse%20Pipa%20Galvanis."
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Konsultasi Greenhouse Galvanis</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 3: Baja Ringan -->
      <div class="group flex flex-col justify-between rounded-xl bg-white border border-zinc-200/80 hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 p-4 sm:p-5">
        <div>
          <!-- Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-lg bg-zinc-50 border border-zinc-100 mb-3.5">
            <img
              src="/images/greenhouse/greenhouse-baja-ringan.webp"
              alt="Konstruksi Greenhouse Rangka Baja Ringan"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-100 mb-2">
            <span class="text-[11px] font-bold text-emerald-800">Tipe 03 &bull; Modular</span>
            <span class="text-[10px] font-medium text-zinc-600 bg-zinc-100 px-2 py-0.5 rounded-full">
              Instalasi Cepat
            </span>
          </div>

          <h3 class="text-base font-bold text-zinc-900 mb-1.5 group-hover:text-emerald-700 transition-colors">
            Greenhouse Baja Ringan
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed mb-3.5">
            Alternatif struktur presisi dengan perakitan ringkas dan bentang rapi. Sangat cocok untuk pembibitan (nursery) dan kebun sayur modern.
          </p>

          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-100 pt-3">
            <p><span class="font-semibold text-zinc-900">Cocok untuk:</span> Nursery, selada hidroponik, sayuran daun</p>
            <p><span class="font-semibold text-zinc-900">Daya tahan:</span> 7 - 10 Tahun</p>
            <p><span class="font-semibold text-zinc-900">Rangka:</span> Canal C 0.75mm + Reng Zincalume anti karat</p>
          </div>
        </div>

        <div class="pt-3.5 mt-3.5 border-t border-zinc-100">
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agro%20Prima%20Greenhouse%2C%20saya%20ingin%20konsultasi%20pembuatan%20Greenhouse%20Baja%20Ringan."
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Konsultasi Baja Ringan</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 4: Tunnel Garam -->
      <div class="group flex flex-col justify-between rounded-xl bg-white border border-zinc-200/80 hover:border-zinc-300 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300 p-4 sm:p-5">
        <div>
          <!-- Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-lg bg-zinc-50 border border-zinc-100 mb-3.5">
            <img
              src="/images/greenhouse/tunnel-garam-greenhouse.webp"
              alt="Konstruksi Tunnel Garam Prisma Pesisir"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-100 mb-2">
            <span class="text-[11px] font-bold text-emerald-800">Tipe 04 &bull; Inovasi Pesisir</span>
            <span class="text-[10px] font-medium text-zinc-600 bg-zinc-100 px-2 py-0.5 rounded-full">
              Anti Hujan
            </span>
          </div>

          <h3 class="text-base font-bold text-zinc-900 mb-1.5 group-hover:text-emerald-700 transition-colors">
            Tunnel Garam Prisma
          </h3>
          <p class="text-xs text-zinc-600 leading-relaxed mb-3.5">
            Rumah kristalisasi garam tertutup dengan geomembrane HDPE dan plastik UV tahan garam laut. Panen garam meja bersih higienis tanpa terhenti musim hujan.
          </p>

          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-100 pt-3">
            <p><span class="font-semibold text-zinc-900">Cocok untuk:</span> Tambak garam meja, kristalisasi higienis</p>
            <p><span class="font-semibold text-zinc-900">Daya tahan:</span> 5 - 10 Tahun</p>
            <p><span class="font-semibold text-zinc-900">Material:</span> Rangka lengkung anti korosi air laut &amp; HDPE</p>
          </div>
        </div>

        <div class="pt-3.5 mt-3.5 border-t border-zinc-100">
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agro%20Prima%20Greenhouse%2C%20saya%20ingin%20konsultasi%20pembuatan%20Tunnel%20Garam."
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Konsultasi Tunnel Garam</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Editorial Callout Card (Shopify Modern Minimalist Style) -->
    <div class="p-6 sm:p-10 rounded-2xl bg-zinc-900 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-md border border-zinc-800">
      <div class="space-y-2 max-w-2xl">
        <span class="text-xs font-bold text-emerald-400 uppercase tracking-wider block">
          Simulasi Online Mandiri
        </span>
        <h3 class="text-xl sm:text-2xl font-extrabold tracking-tight text-white">
          Hitung Kebutuhan &amp; Estimasi Anggaran Lebih Awal
        </h3>
        <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed font-normal">
          Biaya pembuatan greenhouse dipengaruhi luas lahan, jenis rangka, spesifikasi plastik UV, ventilasi, dan instalasi fertigasi. Dapatkan estimasi biaya awal secara transparan melalui kalkulator kami.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
        <a
          href="/jasa/pembuatan-greenhouse/#kalkulator"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs sm:text-sm tracking-normal transition-all shadow-xs"
        >
          <span>Hitung RAB Greenhouse</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
        <a
          href={waConsultUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-full bg-white/10 hover:bg-white/20 text-white font-semibold text-xs sm:text-sm tracking-normal transition-all border border-white/20"
        >
          <span>Konsultasi via WhatsApp</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

  </div>
</section>
