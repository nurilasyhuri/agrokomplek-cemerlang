---
---

<section class="py-14 lg:py-24 bg-white border-b border-zinc-200/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 space-y-2">
      <span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider block">Fabrikasi &amp; Konstruksi</span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-zinc-900 leading-[1.15]">
        Greenhouse Presisi Untuk Iklim Tropis
      </h2>
      <p class="text-sm sm:text-base text-zinc-600 leading-relaxed pt-1">
        Setiap tanaman memiliki kebutuhan lingkungan yang berbeda. Karena itu, greenhouse bukan sekadar membangun rangka dan memasang plastik. Kami mempertimbangkan jenis tanaman, kondisi lahan, ventilasi, kebutuhan perlindungan, material, serta karakter lingkungan sebelum menentukan konstruksi yang sesuai.
      </p>
    </div>

    <!-- 4 Greenhouse Types Technical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-14">
      
      <!-- Type 1: Bambu -->
      <div class="group relative flex flex-col justify-between rounded-3xl bg-zinc-50/60 border border-zinc-200/80 hover:border-zinc-300 hover:shadow-lg transition-all duration-300 p-5 space-y-4">
        <div>
          <!-- Real Bamboo Greenhouse Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-200/60 mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-bambu.webp"
              alt="Konstruksi Greenhouse Rangka Bambu Presisi Agrokomplek Cemerlang"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md text-zinc-800 text-[10px] font-semibold px-2.5 py-0.5 rounded-full shadow-xs border border-zinc-200/60">
              Tipe 01
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-200/70">
            <span class="text-xs font-semibold text-zinc-500">Investasi Rendah</span>
            <span class="text-[10px] font-medium bg-zinc-200/60 text-zinc-800 px-2 py-0.5 rounded-full">
              Ekonomis
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 mt-2.5 mb-1.5">Greenhouse Bambu Presisi</h3>
          <p class="text-xs text-zinc-500 leading-relaxed mb-4">
            Pilihan ekonomis untuk budidaya terproteksi menggunakan rangka bambu pilihan yang telah dipersiapkan untuk konstruksi greenhouse.
          </p>
          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-200/70 pt-3">
            <p><strong class="text-zinc-800">Rangka:</strong> Bambu Petung / Apus</p>
            <p><strong class="text-zinc-800">Atap:</strong> Plastik UV 14%</p>
            <p><strong class="text-zinc-800">Masa Pakai:</strong> &plusmn;3&ndash;5 Tahun*</p>
            <p><strong class="text-zinc-800">Cocok:</strong> Cabai, Tomat, Sayuran</p>
          </div>
        </div>
        <div class="pt-3 border-t border-zinc-200/70">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 2: Galvanis (Paling Populer) -->
      <div class="group relative flex flex-col justify-between rounded-3xl bg-white border-2 border-emerald-600 shadow-md hover:shadow-xl transition-all duration-300 p-5 space-y-4">
        <div class="absolute -top-3 right-4 bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-xs">
          Paling Populer
        </div>
        <div>
          <!-- Real Galvanized Greenhouse Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-200/60 mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Konstruksi Greenhouse Pipa Galvanis Hot-Dip Komersial"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2.5 left-2.5 bg-emerald-600 text-white text-[10px] font-semibold px-2.5 py-0.5 rounded-full shadow-xs">
              Tipe 02
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-200/70">
            <span class="text-xs font-semibold text-emerald-700">Standar Industri</span>
            <span class="text-[10px] font-medium bg-emerald-50 text-emerald-800 px-2 py-0.5 rounded-full border border-emerald-100">
              Komersial
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 mt-2.5 mb-1.5">Greenhouse Pipa Galvanis</h3>
          <p class="text-xs text-zinc-500 leading-relaxed mb-4">
            Struktur greenhouse komersial dengan pipa galvanis hot-dip 1.5" dan sistem sambungan klem presisi tahan korosi.
          </p>
          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-200/70 pt-3">
            <p><strong class="text-zinc-800">Rangka:</strong> Pipa Galvanis Hot-Dip 1.5"</p>
            <p><strong class="text-zinc-800">Atap:</strong> Plastik UV 200 Micron</p>
            <p><strong class="text-zinc-800">Masa Pakai:</strong> &plusmn;10&ndash;15+ Tahun*</p>
            <p><strong class="text-zinc-800">Cocok:</strong> Melon, Paprika, Bunga</p>
          </div>
        </div>
        <div class="pt-3 border-t border-zinc-200/70">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 3: Baja Ringan -->
      <div class="group relative flex flex-col justify-between rounded-3xl bg-zinc-50/60 border border-zinc-200/80 hover:border-zinc-300 hover:shadow-lg transition-all duration-300 p-5 space-y-4">
        <div>
          <!-- Real Baja Ringan Greenhouse Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-200/60 mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-baja-ringan.webp"
              alt="Konstruksi Greenhouse Rangka Baja Ringan Zincalume"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md text-zinc-800 text-[10px] font-semibold px-2.5 py-0.5 rounded-full shadow-xs border border-zinc-200/60">
              Tipe 03
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-200/70">
            <span class="text-xs font-semibold text-zinc-500">Semi Permanen</span>
            <span class="text-[10px] font-medium bg-zinc-200/60 text-zinc-800 px-2 py-0.5 rounded-full">
              Modular
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 mt-2.5 mb-1.5">Greenhouse Baja Ringan</h3>
          <p class="text-xs text-zinc-500 leading-relaxed mb-4">
            Struktur berbasis Canal C Zincalume dengan proses perakitan yang cepat dan praktis untuk kebutuhan nursery.
          </p>
          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-200/70 pt-3">
            <p><strong class="text-zinc-800">Rangka:</strong> Canal C Zincalume 0.75 mm</p>
            <p><strong class="text-zinc-800">Atap:</strong> Plastik UV + Insect Net</p>
            <p><strong class="text-zinc-800">Masa Pakai:</strong> &plusmn;5&ndash;8 Tahun*</p>
            <p><strong class="text-zinc-800">Cocok:</strong> Nursery, Selada, Stroberi</p>
          </div>
        </div>
        <div class="pt-3 border-t border-zinc-200/70">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 4: Tunnel Garam -->
      <div class="group relative flex flex-col justify-between rounded-3xl bg-zinc-50/60 border border-zinc-200/80 hover:border-zinc-300 hover:shadow-lg transition-all duration-300 p-5 space-y-4">
        <div>
          <!-- Real Tunnel Garam Photo -->
          <div class="aspect-[16/10] overflow-hidden rounded-2xl bg-zinc-100 border border-zinc-200/60 mb-3 relative">
            <img
              src="/images/greenhouse/tunnel-garam-greenhouse.webp"
              alt="Konstruksi Tunnel Garam Prisma Pesisir Anti Karat"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2.5 left-2.5 bg-white/95 backdrop-blur-md text-zinc-800 text-[10px] font-semibold px-2.5 py-0.5 rounded-full shadow-xs border border-zinc-200/60">
              Tipe 04
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-zinc-200/70">
            <span class="text-xs font-semibold text-zinc-500">Spesialis Pesisir</span>
            <span class="text-[10px] font-medium bg-zinc-200/60 text-zinc-800 px-2 py-0.5 rounded-full">
              Anti Karat
            </span>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-zinc-900 mt-2.5 mb-1.5">Tunnel Garam Prisma</h3>
          <p class="text-xs text-zinc-500 leading-relaxed mb-4">
            Solusi konstruksi berbentuk tunnel untuk membantu proses percepatan produksi dan kristalisasi garam pesisir.
          </p>
          <div class="space-y-1.5 text-xs text-zinc-600 border-t border-zinc-200/70 pt-3">
            <p><strong class="text-zinc-800">Rangka:</strong> Bambu / Pipa Lengkung Khusus</p>
            <p><strong class="text-zinc-800">Atap:</strong> Plastik UV Bening</p>
            <p><strong class="text-zinc-800">Masa Pakai:</strong> &plusmn;2&ndash;4 Tahun*</p>
            <p><strong class="text-zinc-800">Cocok:</strong> Garam K1, Garam Konsumsi</p>
          </div>
        </div>
        <div class="pt-3 border-t border-zinc-200/70">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center justify-between transition-colors"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Callout Box: Apple Dark Card Aesthetic -->
    <div class="p-8 sm:p-10 rounded-3xl bg-zinc-900 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-6 shadow-xl relative overflow-hidden">
      <div class="space-y-2 max-w-2xl">
        <span class="text-xs font-semibold text-emerald-400 uppercase tracking-wider block">Kalkulator Estimasi Biaya</span>
        <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-white">
          Punya Rencana Membangun Greenhouse? Hitung Dulu Kebutuhan dan Perkiraan Biayanya.
        </h3>
        <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed">
          Masukkan ukuran lahan dan kebutuhan dasar proyek Anda untuk mendapatkan gambaran awal dimensi, material, dan estimasi RAB transparan.
        </p>
      </div>
      <a
        href="/jasa/pembuatan-greenhouse/#kalkulator"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-full bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-xs sm:text-sm tracking-normal transition-all shrink-0 select-none shadow-md hover:shadow-lg"
      >
        <span>Hitung Estimasi RAB</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</section>
