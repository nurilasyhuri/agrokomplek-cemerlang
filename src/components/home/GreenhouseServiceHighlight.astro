---
---

<section class="py-12 lg:py-20 bg-surface-card border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 space-y-2">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-ink-primary leading-[1.15]">
        Fabrikasi &amp; Konstruksi
      </h2>
      <p class="text-xl sm:text-2xl font-bold text-agri-700 tracking-tight">
        Greenhouse Presisi Untuk Iklim Tropis
      </p>
      <p class="text-sm sm:text-base text-ink-secondary leading-relaxed pt-1">
        Setiap tanaman memiliki kebutuhan lingkungan yang berbeda. Karena itu, greenhouse bukan sekadar membangun rangka dan memasang plastik. Kami mempertimbangkan jenis tanaman, kondisi lahan, ventilasi, kebutuhan perlindungan, material, serta karakter lingkungan sebelum menentukan konstruksi yang sesuai.
      </p>
    </div>

    <!-- 4 Greenhouse Types Technical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      
      <!-- Type 1: Bambu (Features user's authentic photo) -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between space-y-4">
        <div>
          <!-- Real Bamboo Greenhouse Photo -->
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden rounded-md border border-surface-border mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-bambu.webp"
              alt="Konstruksi Greenhouse Rangka Bambu Presisi Agrokomplek Cemerlang"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2 left-2 bg-surface-card/95 text-ink-primary text-[10px] font-bold px-2 py-0.5 rounded-xs border border-surface-border shadow-xs">
              TIPE 01
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Investasi Rendah</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-xs border border-surface-border">
              Ekonomis
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-ink-primary mt-2.5 mb-1.5">Greenhouse Bambu Presisi</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Pilihan ekonomis untuk budidaya terproteksi menggunakan rangka bambu pilihan yang telah dipersiapkan untuk kebutuhan konstruksi greenhouse.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Bambu Petung / Apus</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV 14%</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> &plusmn;3&ndash;5 Tahun*</p>
            <p><strong class="text-ink-primary">Cocok untuk:</strong> Cabai &bull; Tomat &bull; Sayuran Daun</p>
          </div>
        </div>
        <div class="pt-3 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>SIMULASI BIAYA</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 2: Galvanis (Paling Populer) -->
      <div class="border-2 border-agri-700 bg-surface-canvas rounded-lg p-5 flex flex-col justify-between relative shadow-sm space-y-4">
        <div class="absolute -top-3 right-4 bg-agri-700 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-xs">
          PALING POPULER
        </div>
        <div>
          <!-- Real Galvanized Greenhouse Photo -->
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden rounded-md border border-surface-border mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-galvanis.webp"
              alt="Konstruksi Greenhouse Pipa Galvanis Hot-Dip Komersial"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2 left-2 bg-agri-700 text-white text-[10px] font-bold px-2 py-0.5 rounded-xs shadow-xs">
              TIPE 02
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-agri-700">Standar Industri</span>
            <span class="text-[10px] font-bold bg-agri-50 text-agri-700 px-2 py-0.5 rounded-xs border border-agri-100">
              Komersial
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-ink-primary mt-2.5 mb-1.5">Greenhouse Pipa Galvanis</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Struktur greenhouse untuk kebutuhan komersial dengan pipa galvanis hot-dip 1.5" dan sistem sambungan klem yang membantu menjaga lapisan galvanis tetap terlindungi.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Pipa Galvanis Hot-Dip 1.5"</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV 200 Micron</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> &plusmn;10&ndash;15+ Tahun*</p>
            <p><strong class="text-ink-primary">Cocok untuk:</strong> Melon &bull; Hidroponik &bull; Paprika &bull; Bunga</p>
          </div>
        </div>
        <div class="pt-3 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>SIMULASI BIAYA</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 3: Baja Ringan -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between space-y-4">
        <div>
          <!-- Real Baja Ringan Greenhouse Photo -->
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden rounded-md border border-surface-border mb-3 relative">
            <img
              src="/images/greenhouse/greenhouse-baja-ringan.webp"
              alt="Konstruksi Greenhouse Rangka Baja Ringan Zincalume"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2 left-2 bg-surface-card/95 text-ink-primary text-[10px] font-bold px-2 py-0.5 rounded-xs border border-surface-border shadow-xs">
              TIPE 03
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Semi Permanen</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-xs border border-surface-border">
              Modular
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-ink-primary mt-2.5 mb-1.5">Greenhouse Baja Ringan</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Struktur berbasis Canal C Zincalume dengan proses perakitan yang relatif cepat untuk kebutuhan greenhouse terencana.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Canal C Zincalume 0.75 mm</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV + Insect Net</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> &plusmn;5&ndash;8 Tahun*</p>
            <p><strong class="text-ink-primary">Cocok untuk:</strong> Nursery &bull; Selada &bull; Stroberi</p>
          </div>
        </div>
        <div class="pt-3 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>SIMULASI BIAYA</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 4: Tunnel Garam -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between space-y-4">
        <div>
          <!-- Real Tunnel Garam Photo -->
          <div class="aspect-[16/10] bg-surface-subtle overflow-hidden rounded-md border border-surface-border mb-3 relative">
            <img
              src="/images/greenhouse/tunnel-garam-greenhouse.webp"
              alt="Konstruksi Tunnel Garam Prisma Pesisir Anti Karat"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <span class="absolute top-2 left-2 bg-surface-card/95 text-ink-primary text-[10px] font-bold px-2 py-0.5 rounded-xs border border-surface-border shadow-xs">
              TIPE 04
            </span>
          </div>

          <div class="flex items-center justify-between pb-2 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Spesialis Pesisir</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-xs border border-surface-border">
              Anti Karat
            </span>
          </div>
          <h3 class="text-lg sm:text-xl font-bold text-ink-primary mt-2.5 mb-1.5">Tunnel Garam Efisiensi</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Solusi konstruksi berbentuk tunnel untuk membantu proses produksi dan kristalisasi garam pada wilayah pesisir.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Bambu / Pipa Lengkung Khusus</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV Transparansi Tinggi</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> &plusmn;2&ndash;4 Tahun*</p>
            <p><strong class="text-ink-primary">Cocok untuk:</strong> Produksi Garam K1 &bull; Garam Konsumsi</p>
          </div>
        </div>
        <div class="pt-3 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold uppercase tracking-wider text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>SIMULASI BIAYA</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Callout Box: Hitung Dulu Kebutuhan dan Perkiraan Biayanya -->
    <div class="p-6 sm:p-8 rounded-lg bg-surface-subtle border border-surface-border flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-2xl">
        <h3 class="text-xl sm:text-2xl font-extrabold text-ink-primary tracking-tight">
          Punya Rencana Membangun Greenhouse? Hitung Dulu Kebutuhan dan Perkiraan Biayanya.
        </h3>
        <p class="text-xs sm:text-sm text-ink-secondary leading-relaxed">
          Masukkan ukuran lahan dan kebutuhan dasar proyek Anda untuk mendapatkan gambaran awal dimensi, material, dan estimasi RAB.
        </p>
        <p class="text-[11px] text-ink-muted leading-tight">
          *Estimasi awal dapat berubah berdasarkan kondisi lahan, spesifikasi material, desain, lokasi proyek, dan kebutuhan instalasi.
        </p>
      </div>
      <a
        href="/jasa/pembuatan-greenhouse/#kalkulator"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-md bg-agri-700 hover:bg-agri-800 text-white font-bold text-xs uppercase tracking-wider transition-colors shrink-0 select-none shadow-xs"
      >
        <span>HITUNG ESTIMASI RAB</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</section>
