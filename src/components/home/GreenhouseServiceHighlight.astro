---
---

<section class="py-12 lg:py-20 bg-surface-card border-b border-surface-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-agri-700">Fabrikasi & Konstruksi</span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink-primary mt-1">
        Rancang Bangun Konstruksi Greenhouse Presisi Iklim Tropis
      </h2>
      <p class="text-sm sm:text-base text-ink-secondary mt-3 leading-relaxed">
        Setiap komoditas hortikultura membutuhkan iklim mikro yang berbeda. Kami melayani survei lahan, pengadaan bahan baku terstandar, serta perakitan struktur greenhouse dengan perhitungan ventilasi alami dan daya tahan angin yang teruji.
      </p>
    </div>

    <!-- 4 Greenhouse Types Technical Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
      
      <!-- Type 1: Bambu -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Tipe 01</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-sm border border-surface-border">
              Investasi Rendah
            </span>
          </div>
          <h3 class="text-base font-bold text-ink-primary mt-3 mb-2">Greenhouse Bambu Presisi</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Solusi budidaya terproteksi ekonomis dengan rangka bambu pilihan yang diawetkan, dilapisi plastik UV 14%.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Bambu Petung / Apus</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV 14% Lokal</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> 3 - 5 Tahun</p>
            <p><strong class="text-ink-primary">Aplikasi:</strong> Cabai, Tomat, Sayur Daun</p>
          </div>
        </div>
        <div class="pt-4 mt-4 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 2: Galvanis -->
      <div class="border-2 border-agri-700 bg-surface-canvas rounded-lg p-5 flex flex-col justify-between relative shadow-sm">
        <div class="absolute -top-3 right-4 bg-agri-700 text-white text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-sm">
          Paling Populer
        </div>
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-agri-700">Tipe 02</span>
            <span class="text-[10px] font-bold bg-agri-50 text-agri-700 px-2 py-0.5 rounded-sm">
              Standar Industri
            </span>
          </div>
          <h3 class="text-base font-bold text-ink-primary mt-3 mb-2">Greenhouse Pipa Galvanis</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Konstruksi komersial premium tahan karat hujan asam dengan sambungan klem tanpa las yang merusak lapisan seng.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Pipa Galvanis Hot-Dip 1.5"</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV Vatan 200 Micron</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> 10 - 15+ Tahun</p>
            <p><strong class="text-ink-primary">Aplikasi:</strong> Melon Hidroponik, Paprika, Bunga</p>
          </div>
        </div>
        <div class="pt-4 mt-4 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 3: Baja Ringan -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Tipe 03</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-sm border border-surface-border">
              Semi Permanen
            </span>
          </div>
          <h3 class="text-base font-bold text-ink-primary mt-3 mb-2">Greenhouse Baja Ringan</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Struktur truss canal C berbobot ringan dengan waktu perakitan cepat untuk lahan datar dan greenhouse hobi terencana.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Canal C Zincalume 0.75mm</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV 14% + Insectnet 50M</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> 5 - 8 Tahun</p>
            <p><strong class="text-ink-primary">Aplikasi:</strong> Nursery Bibit, Selada, Stroberi</p>
          </div>
        </div>
        <div class="pt-4 mt-4 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Type 4: Tunnel Garam -->
      <div class="border border-surface-border bg-surface-canvas rounded-lg p-5 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between pb-3 border-b border-surface-border">
            <span class="text-xs font-bold uppercase tracking-wider text-ink-muted">Tipe 04</span>
            <span class="text-[10px] font-bold bg-surface-subtle text-ink-primary px-2 py-0.5 rounded-sm border border-surface-border">
              Spesialis Garam
            </span>
          </div>
          <h3 class="text-base font-bold text-ink-primary mt-3 mb-2">Tunnel Garam Efisiensi</h3>
          <p class="text-xs text-ink-secondary leading-relaxed mb-4">
            Konstruksi kubah lengkung pemanas kristalisasi air laut untuk petambak garam pesisir agar panen sepanjang tahun.
          </p>
          <div class="space-y-1.5 text-xs text-ink-muted border-t border-surface-border pt-3">
            <p><strong class="text-ink-primary">Rangka:</strong> Bambu / Pipa Lengkung Khusus</p>
            <p><strong class="text-ink-primary">Atap:</strong> Plastik UV Transparansi Tinggi</p>
            <p><strong class="text-ink-primary">Masa Pakai:</strong> 2 - 4 Tahun (Pesisir)</p>
            <p><strong class="text-ink-primary">Aplikasi:</strong> Produksi Garam K1 / Konsumsi</p>
          </div>
        </div>
        <div class="pt-4 mt-4 border-t border-surface-border">
          <a
            href="/jasa/pembuatan-greenhouse/"
            class="text-xs font-bold text-agri-700 hover:text-agri-800 flex items-center justify-between"
          >
            <span>Simulasi Biaya</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom CTA Bar -->
    <div class="border border-surface-border bg-surface-subtle p-6 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h4 class="font-bold text-ink-primary text-sm sm:text-base">Ingin Menghitung Perkiraan Kebutuhan & Biaya Greenhouse Anda?</h4>
        <p class="text-xs text-ink-muted mt-0.5">Gunakan kalkulator estimasi dimensi lahan untuk mendapatkan gambaran RAB awal.</p>
      </div>
      <a
        href="/jasa/pembuatan-greenhouse/"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-md bg-agri-700 hover:bg-agri-800 text-white font-bold text-xs uppercase tracking-wider transition-colors shrink-0 select-none"
      >
        <span>Buka Kalkulator RAB</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>

  </div>
</section>
